# Unified Jupyter Dockerfile — two build targets from a shared base
#
# Targets:
#   jupyter-local       Full stack: Docusaurus site + Jupyter + Qiskit (~3 GB)
#   jupyter-codeengine  IBM Cloud Code Engine: Jupyter + Qiskit + SSE server (~3 GB)
#
# Usage:
#   docker build --target jupyter-local      -f Dockerfile.jupyter -t doqumentation:jupyter .
#   docker build --target jupyter-codeengine -f Dockerfile.jupyter -t doqumentation-codeengine .
#
# Code Engine:
#   Image: ghcr.io/janlahmann/doqumentation-codeengine:latest
#   Port:  8080
#   Env:   JUPYTER_TOKEN=<your-token>

# ── Stage: site-build (only consumed by jupyter-local) ───────────────
# Pin to the native BUILDPLATFORM: the Docusaurus output is static, arch-
# independent HTML/JS, so there's no reason to emulate this stage on arm64.
# Building it once natively (not under QEMU) avoids the slow, flaky arm64
# `npm ci` (ETIMEDOUT under emulation) and roughly halves total build time;
# the arch-specific final stages just COPY --from=site-build the result.
FROM --platform=$BUILDPLATFORM node:20-alpine AS site-build

RUN apk add --no-cache python3 git

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN python3 scripts/sync-content.py
RUN NODE_OPTIONS="--max-old-space-size=8192" npm run build -- --locale en

# Remove GitHub Pages CNAME from build output
RUN rm -f build/CNAME

# ── Stage: jupyter-base (shared by both targets) ─────────────────────
# The Qiskit stack comes from the QuBins image Binder already runs
# (src/config/jupyter.ts DEFAULT_QISKIT_TAG), so Binder, Docker and Code
# Engine share one package set instead of three hand-synced ones. QuBins
# derives it from upstream's scripts/nb-tester/requirements.txt, resolves it
# per arch (physics-tenpy and gem-suite only on amd64, which have no arm64
# wheels), ships graphviz and git, and fails its build on any pip error.
# Multi-arch index (amd64 + arm64). Pinned by digest; Dependabot proposes
# bumps. Keep the tag in lockstep with DEFAULT_QISKIT_TAG
# (scripts/check-qiskit-lockstep.py enforces it).
FROM ghcr.io/qubins/images:2.5-xl@sha256:b481c89ee2e2ec52ada4494b060506ab3990bbf53e59bb74ec9ee88a8fa84988 AS jupyter-base

USER root

# Install nginx and supervisor (base image is Ubuntu-based; graphviz and
# git already come with QuBins).
# Selectively upgrade OS packages the base digest still ships with fixed
# CVEs the Trivy gate fails on: gpgv (CVE-2025-68973) and openssl/libssl3t64
# (CVE-2026-45447, UAF in PKCS7_verify; fixed in 3.0.13-0ubuntu3.11).
RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx \
        supervisor \
    && apt-get upgrade -y gpgv openssl libssl3t64 \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

# Security pins for transitive dependencies with known CVEs
COPY binder/jupyter-requirements-security.txt /tmp/jupyter-requirements-security.txt
RUN pip install --no-cache-dir --no-compile --upgrade \
        -r /tmp/jupyter-requirements-security.txt && \
    rm /tmp/jupyter-requirements-security.txt

# Fail the build if the stack the notebooks need does not import (#958: a
# broken pip resolve used to be swallowed and shipped an image without
# qiskit-ibm-runtime).
RUN python -c "import qiskit, qiskit_aer, qiskit_ibm_runtime, qiskit_serverless, \
qiskit_addon_utils, qiskit_addon_mpf, matplotlib, scipy; \
from qiskit import QuantumCircuit; QuantumCircuit(2).measure_all()"

# Pre-create Jupyter config dir so entrypoint doesn't need root
RUN mkdir -p /home/jovyan/.jupyter && chown jovyan:users /home/jovyan/.jupyter

# Allow nginx to run as non-root: writable pid/tmp dirs + no "user" directive
RUN sed -i '/^user /d' /etc/nginx/nginx.conf && \
    mkdir -p /tmp/nginx && \
    chown -R jovyan:users /var/log/nginx /var/lib/nginx /tmp/nginx && \
    sed -i 's|/run/nginx.pid|/tmp/nginx/nginx.pid|' /etc/nginx/nginx.conf

# ── Target: jupyter-local (site + Jupyter + Qiskit) ──────────────────
FROM jupyter-base AS jupyter-local

# nginx config — reverse proxy for Jupyter API.
# The entrypoint runs as non-root jovyan and rewrites this file at startup
# (sed -i injects the runtime JUPYTER_TOKEN). sed -i writes its temp file into
# the containing DIRECTORY, so both the dir and the file must be jovyan-writable
# — mirroring the /var/log/nginx, /var/lib/nginx, /tmp/nginx chowns in
# jupyter-base. Without this the container exits 4 with "sed: couldn't open
# temporary file /etc/nginx/sites-enabled/sedXXXX: Permission denied".
COPY nginx.conf /etc/nginx/sites-enabled/default
RUN chown -R jovyan:users /etc/nginx/sites-enabled

# Copy built site from site-build stage
COPY --from=site-build /app/build /usr/share/nginx/html

# Copy notebooks for Jupyter serving
COPY --from=site-build /app/notebooks /home/jovyan/notebooks
RUN chown -R jovyan:users /home/jovyan/notebooks

WORKDIR /home/jovyan/notebooks

# supervisord config: nginx + Jupyter
RUN cat > /etc/supervisor/conf.d/services.conf << 'CONF'
[supervisord]
nodaemon=true
logfile=/dev/stdout
logfile_maxbytes=0

[program:nginx]
command=nginx -g "daemon off;"
autorestart=true
startretries=3
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:jupyter]
command=jupyter server --config=/home/jovyan/.jupyter/jupyter_server_config.py
directory=/home/jovyan/notebooks
autorestart=true
startretries=3
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
CONF

# Entrypoint (generates token, writes Jupyter config, patches nginx)
COPY scripts/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

USER jovyan

EXPOSE 80 8888

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO /dev/null http://localhost:80/ || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]

# ── Target: jupyter-codeengine (CE: Jupyter + SSE server) ────────────
FROM jupyter-base AS jupyter-codeengine

# Fetch processed notebooks from the notebooks branch so JupyterLab has content.
# Only copy .ipynb files (tutorials, guides, courses, modules) — skip binder/ config.
# git comes with the QuBins base (nbgitpuller needs it at runtime), so keep it.
RUN git clone --depth 1 --branch notebooks \
        https://github.com/JanLahmann/doQumentation.git /tmp/notebooks && \
    cd /tmp/notebooks && \
    find . -name '*.ipynb' -exec sh -c 'mkdir -p /home/jovyan/$(dirname "{}") && cp "{}" /home/jovyan/"{}"' \; && \
    chown -R 1000:100 /home/jovyan && \
    rm -rf /tmp/notebooks

# nginx config — reverse proxy for Jupyter + SSE, with rate limiting
COPY binder/nginx-codeengine.conf /etc/nginx/sites-enabled/default

# SSE build server — Binder-compatible /build/ endpoint
COPY binder/sse-build-server.py /opt/sse-build-server.py

# supervisord config: nginx + Jupyter + SSE server
RUN cat > /etc/supervisor/conf.d/services.conf << 'CONF'
[supervisord]
nodaemon=true
logfile=/dev/stdout
logfile_maxbytes=0

[program:nginx]
command=nginx -g "daemon off;"
autorestart=true
startretries=3
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:jupyter]
command=jupyter server --config=/home/jovyan/.jupyter/jupyter_server_config.py
directory=/home/jovyan
autorestart=true
startretries=3
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:sse]
command=python3 /opt/sse-build-server.py
autorestart=true
startretries=5
startsecs=2
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
CONF

# Entrypoint (generates token, writes Jupyter config)
COPY binder/codeengine-entrypoint.sh /codeengine-entrypoint.sh
RUN chmod +x /codeengine-entrypoint.sh

USER jovyan

# Code Engine exposes a single port
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO /dev/null http://localhost:8080/health || exit 1

ENTRYPOINT ["/codeengine-entrypoint.sh"]
