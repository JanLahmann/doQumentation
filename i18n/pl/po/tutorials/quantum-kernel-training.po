msgstr "Krok 3: Wykonanie przy użyciu prymitywów Qiskit {#step-3-execute-using-qiskit-primitives}"

#. type: Bullet: '*   '
#, no-wrap
msgid "Input: Abstract circuit.\n"
msgstr "Dane wejściowe: Abstrakcyjny Circuit.\n"

#. type: Bullet: '*   '
#, no-wrap
