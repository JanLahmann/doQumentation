msgstr "Krok 3: Wykonanie z użyciem prymitywów Qiskit {#step-3-execute-using-qiskit-primitives}"

#. type: Plain text
#, no-wrap
msgid "Use `StatevectorEstimator` for exact noiseless simulation at small scale.\n"
msgstr "Użyj `StatevectorEstimator` do dokładnej, bezszumowej symulacji w małej skali.\n"

#. type: Title ###
#, no-wrap
msgid "Step 4: Post-process and return result in desired classical format {#step-4-post-process-and-return-result-in-desired-classical-format}"
