#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Probabilistic error cancellation with shaded lightcones"
msgstr "Probabilistyczne anulowanie błędów z przyciemnianymi stożkami świetlnymi"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"qiskit-addons/slc/01_getting_started.ipynb\" />\n"
