msgid "1.1 GHZ state {#11-ghz-state}"
msgstr "1.1 Stan GHZ {#11-ghz-state}"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"The GHZ state (Greenberger-Horne-Zeilinger state) for $n$ qubits is defined "
"as\n"
msgstr ""
"Stan GHZ (stan Greenbergera-Horne'a-Zeilingera) dla $n$ kubitów jest "
"zdefiniowany jako\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|0\\rangle ^ {\\otimes n}+ |1\\rangle^ {\\otimes n})\n"
"$$\n"
msgstr ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|0\\rangle ^ {\\otimes n}+ |1\\rangle^ {\\otimes n})\n"
"$$\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
