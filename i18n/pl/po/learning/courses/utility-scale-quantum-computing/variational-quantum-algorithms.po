# doq-bootstrap: positional
#. type: Title ##
#, markdown-text, no-wrap
msgid ""
"3. Quantum Optimization with Qiskit patterns {#3-quantum-optimization-with-"
"qiskit-patterns}"
msgstr ""
"3. Optymalizacja kwantowa z wykorzystaniem wzorców Qiskit {#3-quantum-"
