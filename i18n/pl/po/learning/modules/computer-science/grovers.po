# doq-bootstrap: positional
#. type: Title ###
#, no-wrap
msgid "Discussion questions: {#discussion-questions}"
msgstr "Pytania do dyskusji: {#discussion-questions}"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "What other problems could you formulate as a Grover search? Think of problems where it is difficult to find a solution but easy to verify one.\n"
msgstr "Jakie inne problemy można by sformułować jako wyszukiwanie Grovera? Pomyśl o problemach, w których trudno znaleźć rozwiązanie, ale łatwo je zweryfikować.\n"

# doq-bootstrap: positional
#. type: Bullet: '2. '
#, no-wrap
msgid "Can you see any problems with scaling Grover's algorithm on modern quantum computers?\n"
msgstr "Czy dostrzegasz jakieś problemy ze skalowaniem algorytmu Grovera na nowoczesnych komputerach kwantowych?\n"
