# doq-bootstrap: positional
#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid "D) To create entanglement\n"
msgstr "D) Tworzenie splątania\n"

# doq-bootstrap: positional
#. type: Bullet: '2. '
#, markdown-text, no-wrap
msgid "What is the primary objective of the VQE algorithm?\n"
msgstr "Jaki jest główny cel algorytmu VQE?\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid "A) To find the ground state energy of a Hamiltonian\n"
msgstr "A) Znalezienie energii stanu podstawowego Hamiltonianu\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid "B) To create entanglement between qubits\n"
msgstr "B) Tworzenie splątania między kubitami\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid "C) To perform Grover's search\n"
msgstr "C) Wykonywanie wyszukiwania Grovera\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid "D) To break the RSA encryption\n"
msgstr "D) Łamanie szyfrowania RSA\n"

# doq-bootstrap: positional
#. type: Bullet: '3. '
#, markdown-text, no-wrap
msgid ""
"How many quantum states are generated in this notebook to compare the "
