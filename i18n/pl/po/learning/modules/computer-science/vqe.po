msgid "What is the purpose of the Hamiltonian in VQE?\n"
msgstr "Jaka jest rola Hamiltonianu w VQE?\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid "A) To generate random quantum states\n"
msgstr "A) Generowanie losowych stanów kwantowych\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid "B) To determine the energy of quantum states\n"
msgstr "B) Wyznaczanie energii stanów kwantowych\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
