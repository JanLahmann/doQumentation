#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Overview of the Quantum Resource Management Interface for integrating quantum resources to high-performance compute systems"
msgstr "Przegląd interfejsu zarządzania zasobami kwantowymi do integracji zasobów kwantowych z systemami wysokowydajnymi"

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Quantum resource management interface (QRMI)"
msgstr "Interfejs zarządzania zasobami kwantowymi (QRMI)"

#. type: Plain text
#, no-wrap
msgid "{/* cspell:ignore QRMI, stubgen, maturin, Doxyfile, devel, libgcc, rowser */}\n"
