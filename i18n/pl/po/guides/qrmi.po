#, no-wrap
msgid "Runtime environment {#runtime-environment}"
msgstr "Środowisko uruchomieniowe {#runtime-environment}"

#. type: Bullet: '* '
#, no-wrap
msgid "gcc (libgcc RPM for RHEL-compatible OS)\n"
msgstr "gcc (pakiet RPM libgcc dla systemów kompatybilnych z RHEL)\n"

#. type: Bullet: '* '
#, no-wrap
msgid "openssl (openssl-libs RPM for RHEL-compatible OS)\n"
msgstr "openssl (pakiet RPM openssl-libs dla systemów kompatybilnych z RHEL)\n"

