#. type: Title ##
#, no-wrap
msgid "Feature compatibility {#feature-compatibility}"
msgstr "Kompatybilność funkcji {#feature-compatibility}"

#. type: Plain text
#, no-wrap
msgid "Certain runtime features cannot be used together in a single job. Click the appropriate tab for a list of features that are incompatible with the selected feature:\n"
msgstr "Niektóre funkcje runtime nie mogą być używane razem w jednym zadaniu. Kliknij odpowiednią zakładkę, aby zobaczyć listę funkcji niekompatybilnych z wybraną funkcją:\n"

#. type: Plain text
#, no-wrap
msgid ""
"<Accordion>\n"
"  <AccordionItem title=\"Fractional gates\">\n"
"    Incompatible with:\n"
"  - Gate twirling\n"
"  - PEA\n"
"  - PEC\n"
"  </AccordionItem>\n"
"  <AccordionItem title=\"Gate-folding ZNE\">\n"
"    Might not work when using custom gates. Incompatible with:\n"
"  - PEA\n"
"  - PEC\n"
"  </AccordionItem>\n"
"  <AccordionItem title=\"Gate twirling\">\n"
"    Incompatible with:\n"
"  - Fractional gates\n"
"  - Stretches\n"
msgstr ""
"<Accordion>\n"
"  <AccordionItem title=\"Bramki ułamkowe\">\n"
"    Niekompatybilne z:\n"
"  - Twirlingiem bramek\n"
"  - PEA\n"
"  - PEC\n"
"  </AccordionItem>\n"
"  <AccordionItem title=\"Gate-folding ZNE\">\n"
"    Może nie działać przy użyciu niestandardowych bramek. Niekompatybilne z:\n"
"  - PEA\n"
"  - PEC\n"
"  </AccordionItem>\n"
"  <AccordionItem title=\"Twirling bramek\">\n"
"    Niekompatybilne z:\n"
"  - Bramkami ułamkowymi\n"
"  - Stretch\n"

#. type: Plain text
#, no-wrap
msgid ""
"  Other notes:\n"
