msgid ""
"Learn how to get involved with the Qiskit open-source community to shape the"
" future of quantum computing."
msgstr ""
"Dowiedz się, jak zaangażować się w społeczność open source Qiskit i "
"współtworzyć przyszłość obliczeń kwantowych."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Open source"
msgstr "Oprogramowanie open source"

# doq-bootstrap: positional
#. type: Plain text
