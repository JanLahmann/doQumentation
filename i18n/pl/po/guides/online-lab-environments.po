msgid "[Create a Google account](https://support.google.com/accounts/answer/27441?hl).\n"
msgstr "[Utwórz konto Google.](https://support.google.com/accounts/answer/27441?hl)\n"

#. type: Bullet: '2. '
#, no-wrap
msgid "Go to the [Google Colab landing page](https://colab.research.google.com/) and sign in with your Google account.\n"
msgstr "Przejdź na [stronę główną Google Colab](https://colab.research.google.com/) i zaloguj się na swoje konto Google.\n"

#. type: Bullet: '3. '
#, no-wrap
