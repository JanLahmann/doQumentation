msgid "[`Collect2qBlocks`](../api/qiskit/qiskit.transpiler.passes.Collect2qBlocks)\n"
msgstr "[`Collect2qBlocks`](../api/qiskit/qiskit.transpiler.passes.Collect2qBlocks)\n"

# doq-bootstrap: positional
#. type: Bullet: '  - '
#, no-wrap
msgid "[`ConsolidateBlocks`](../api/qiskit/qiskit.transpiler.passes.ConsolidateBlocks)\n"
msgstr "[`ConsolidateBlocks`](../api/qiskit/qiskit.transpiler.passes.ConsolidateBlocks)\n"

# doq-bootstrap: positional
#. type: Bullet: '  - '
#, no-wrap
msgid "[`UnitarySynthesis`](../api/qiskit/qiskit.transpiler.passes.UnitarySynthesis)\n"
msgstr "[`UnitarySynthesis`](../api/qiskit/qiskit.transpiler.passes.UnitarySynthesis)\n"

# doq-bootstrap: positional
