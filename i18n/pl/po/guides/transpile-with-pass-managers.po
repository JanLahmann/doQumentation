#, markdown-text, no-wrap
msgid ""
"Generate a preset staged pass manager {#generate-a-preset-staged-pass-"
"manager}"
msgstr ""
"Generowanie wstępnie zdefiniowanego etapowego menedżera przejść {#generate-"
"a-preset-staged-pass-manager}"

#. type: Plain text
#, markdown-text, no-wrap
