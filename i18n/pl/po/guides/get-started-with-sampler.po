#, no-wrap
msgid "How to use the Sampler primitive in Qiskit Runtime."
msgstr "Jak używać prymitywu Sampler w Qiskit Runtime."

#. type: Yaml Front Matter Hash Value: sidebar_label
#, no-wrap
msgid "Sampler quickstart"
msgstr "Szybki start z Samplerem"

#. type: Plain text
#, markdown-text, no-wrap
msgid "<OpenInLabBanner notebookPath=\"guides/get-started-with-sampler.ipynb\" />\n"
