msgstr "تخزّن كل دارة نتائج القياس الخاصة بها في ما يصل إلى أربعة سجلات كلاسيكية:\n"

# doq: translated after an English change 2026-11-20
#. type: Bullet: '- '
#, no-wrap
msgid "`fusion`: the parity measurements used to fuse the GHZ patches\n"
msgstr "`fusion`: قياسات التكافؤ المستخدمة لدمج رقع GHZ\n"

# doq: translated after an English change 2026-11-20
#. type: Bullet: '- '
#, no-wrap
