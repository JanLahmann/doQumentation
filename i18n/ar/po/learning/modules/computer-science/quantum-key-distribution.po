"2^4=16\\\\\n"
"2^5 = 32 \\rightarrow 5 \\text{ bits}\n"
"$$\n"
msgstr ""
"$$\n"
"2^4=16\\\\\n"
"2^5 = 32 \\rightarrow 5 \\text{ bits}\n"
"$$\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"</AccordionItem>\n"
"</Accordion>\n"
