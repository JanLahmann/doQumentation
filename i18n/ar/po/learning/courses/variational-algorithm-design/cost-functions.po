#. type: Bullet: '- '
#, no-wrap
msgid "Create a cost function\n"
msgstr "إنشاء دالة تكلفة\n"

#. type: Bullet: '- '
#, fuzzy, no-wrap
#| msgid "How to leverage Qiskit Runtime primitives to mitigate and suppression noise\n"
msgid "How to leverage IBM Quantum primitives to mitigate and suppression noise\n"
msgstr "كيفية الاستفادة من بدائيات Qiskit Runtime لتخفيف وقمع الضوضاء\n"

#. type: Bullet: '- '
