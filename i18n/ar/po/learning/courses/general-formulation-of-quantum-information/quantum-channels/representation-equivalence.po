"\\alpha_{01} \\vert 1\\rangle\\langle 0\\vert +\n"
"\\alpha_{10} \\vert 0\\rangle\\langle 1\\vert +\n"
"\\alpha_{11} \\vert 1\\rangle\\langle 1\\vert\\\\[2mm]\n"
"& = \\begin{pmatrix}\n"
"\\alpha_{00} & \\alpha_{10}\\\\[1mm]\n"
"\\alpha_{01} & \\alpha_{11}\n"
"\\end{pmatrix}.\n"
"\\end{aligned}\n"
"$$\n"
msgstr ""
"$$\n"
"\\begin{aligned}\n"
"A_k & = \\alpha_{00} \\vert 0\\rangle\\langle 0\\vert +\n"
"\\alpha_{01} \\vert 1\\rangle\\langle 0\\vert +\n"
"\\alpha_{10} \\vert 0\\rangle\\langle 1\\vert +\n"
"\\alpha_{11} \\vert 1\\rangle\\langle 1\\vert\\\\[2mm]\n"
"& = \\begin{pmatrix}\n"
"\\alpha_{00} & \\alpha_{10}\\\\[1mm]\n"
"\\alpha_{01} & \\alpha_{11}\n"
"\\end{pmatrix}.\n"
"\\end{aligned}\n"
"$$\n"

