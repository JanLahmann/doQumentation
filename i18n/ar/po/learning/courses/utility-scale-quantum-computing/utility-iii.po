# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "The GHZ state (Greenberger-Horne-Zeilinger state) for $n$ qubits is defined as\n"
msgstr "حالة GHZ (حالة Greenberger-Horne-Zeilinger) لـ $n$ من الكيوبتات تُعرَّف على النحو التالي:\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|0\\rangle ^ {\\otimes n}+ |1\\rangle^ {\\otimes n})\n"
"$$\n"
msgstr ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|0\\rangle ^ {\\otimes n}+ |1\\rangle^ {\\otimes n})\n"
"$$\n"

