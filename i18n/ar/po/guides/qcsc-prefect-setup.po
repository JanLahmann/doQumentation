# doq: translated after an English change 2026-11-20
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Set up QCSC-Prefect on a Slurm cluster"
msgstr "إعداد QCSC-Prefect على عنقود Slurm"

#. type: Plain text
