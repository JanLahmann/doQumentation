# doq: translated after an English change 2026-11-12
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Write logs and handle errors"
msgstr "اكتب السجلات وتعامل مع الأخطاء"

#. type: Plain text
#, no-wrap
msgid "{/* cspell:ignore levelname */}\n"
msgstr ""

# doq: translated after an English change 2026-11-12
#. type: Title #
#, no-wrap
msgid "Write logs and handle errors {#write-logs-and-handle-errors}"
msgstr "اكتب السجلات وتعامل مع الأخطاء {#write-logs-and-handle-errors}"

#. type: Plain text
#, no-wrap
msgid ""
