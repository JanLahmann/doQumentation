"    ```python\n"
"    >>> from qiskit_fermions.operators.library import FCIDump\n"
"    >>> from qiskit_fermions.operators import FermionOperator\n"
"    >>>\n"
"    >>> fcidump = FCIDump.from_file(\"docs/guides/n2.fcidump\")\n"
"    >>> num_modes = 2 * fcidump.norb\n"
"    >>> hamil = FermionOperator.from_fcidump(fcidump)\n"
"    ```\n"
"  </TabItem>\n"
msgstr ""

# doq: kept in English by the translator (name or code)
#. type: Plain text
#, no-wrap
msgid "  <TabItem value=\"c\" label=\"C\">\n"
msgstr "  <TabItem value=\"c\" label=\"C\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"    ```c\n"
"    #include <qiskit_fermions.h>\n"
msgstr ""

# doq: kept in English by the translator (name or code)
#. type: Plain text
#, no-wrap
