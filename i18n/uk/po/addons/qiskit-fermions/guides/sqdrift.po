"    qf_fcidump_from_file(\"docs/guides/n2.fcidump\", &fcidump);\n"
"    QfFermionOperator* hamil = qf_ferm_op_from_fcidump(fcidump);\n"
"    uint32_t num_modes = 2 * qf_fcidump_norb(fcidump);\n"
