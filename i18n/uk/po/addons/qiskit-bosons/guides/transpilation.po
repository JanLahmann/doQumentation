# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Transpile bosonic circuits for the latest version of Qiskit bosons"
msgstr "Транспіляція бозонних схем для найновішої версії Qiskit bosons"

# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Transpile bosonic circuits"
msgstr "Транспіляція бозонних схем"

