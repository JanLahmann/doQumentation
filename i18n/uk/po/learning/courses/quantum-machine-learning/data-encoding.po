msgid "Write down the normalized state for encoding the following vector (made of two vectors from our example dataset):\n"
msgstr "Запиши нормалізований стан для кодування такого вектора (складеного з двох векторів нашого прикладного набору даних):\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "$$\\vec{x}=(9,8,6,2,9,2)$$\n"
msgstr "$$\\vec{x}=(9,8,6,2,9,2)$$\n"

#. type: Plain text
