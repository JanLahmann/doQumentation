msgid "Write code to the vector $$\\vec{x}^{(1)}=(4,8,5,9,8,6,2,9,2,5,7,0)$$ using phase encoding.\n"
msgstr "Напиши код для вектора $$\\vec{x}^{(1)}=(4,8,5,9,8,6,2,9,2,5,7,0)$$ з використанням фазового кодування.\n"

