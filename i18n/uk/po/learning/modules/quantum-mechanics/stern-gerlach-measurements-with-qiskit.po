# doq-bootstrap: positional
#. type: Bullet: '2. '
#, no-wrap
msgid "Given the experimental observations and proposed syntax:\n"
msgstr "З огляду на експериментальні спостереження та запропонований синтаксис:\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"$$P_{\\uparrow+x}=\\vert \\begin{pmatrix}1 & 0\\end{pmatrix}\\begin{pmatrix}a \\\\ b\\end{pmatrix}\\vert^2 = |a|^2 =\\frac{1}{2} $$\n"
"$$P_{\\downarrow+x}=\\vert \\begin{pmatrix}0 & 1\\end{pmatrix}\\begin{pmatrix}a \\\\ b\\end{pmatrix}\\vert^2 = |b|^2 =\\frac{1}{2} $$\n"
msgstr ""
"$$P_{\\uparrow+x}=\\vert \\begin{pmatrix}1 & 0\\end{pmatrix}\\begin{pmatrix}a \\\\ b\\end{pmatrix}\\vert^2 = |a|^2 =\\frac{1}{2} $$\n"
"$$P_{\\downarrow+x}=\\vert \\begin{pmatrix}0 & 1\\end{pmatrix}\\begin{pmatrix}a \\\\ b\\end{pmatrix}\\vert^2 = |b|^2 =\\frac{1}{2} $$\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "show that up to a global phase\n"
msgstr "покажи, що з точністю до глобальної фази\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "$$|+\\rangle_x = \\frac{1}{\\sqrt{2}}\\begin{pmatrix}1 \\\\ e^{i\\alpha}\\end{pmatrix}$$\n"
msgstr "$$|+\\rangle_x = \\frac{1}{\\sqrt{2}}\\begin{pmatrix}1 \\\\ e^{i\\alpha}\\end{pmatrix}$$\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "Choose $\\alpha = 0$ to obtain the standard result.\n"
msgstr "Обери $\\alpha = 0$, щоб отримати стандартний результат.\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"$$P_{\\uparrow-x}=\\vert \\begin{pmatrix}1 & 0\\end{pmatrix}\\begin{pmatrix}a \\\\ b\\end{pmatrix}\\vert^2 = |a|^2 =\\frac{1}{2} $$\n"
"$$P_{\\downarrow-x}=\\vert \\begin{pmatrix}0 & 1\\end{pmatrix}\\begin{pmatrix}a \\\\ b\\end{pmatrix}\\vert^2 = |b|^2 =\\frac{1}{2} $$\n"
msgstr ""
"$$P_{\\uparrow-x}=\\vert \\begin{pmatrix}1 & 0\\end{pmatrix}\\begin{pmatrix}a \\\\ b\\end{pmatrix}\\vert^2 = |a|^2 =\\frac{1}{2} $$\n"
"$$P_{\\downarrow-x}=\\vert \\begin{pmatrix}0 & 1\\end{pmatrix}\\begin{pmatrix}a \\\\ b\\end{pmatrix}\\vert^2 = |b|^2 =\\frac{1}{2} $$\n"

