#. type: Title ###
#, markdown-text, no-wrap
msgid "3. Execute {#3-execute}"
msgstr "3. Виконання {#3-execute}"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"![Output of the previous code cell](/learning/images/modules/computer-"
"science/shors-algorithm/extracted-"
"outputs/6744e165-6929-46c6-9cad-55e78fe21f07-0.avif)\n"
