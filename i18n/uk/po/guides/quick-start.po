msgstr "3. Візуалізуй результати {#3-visualize-your-results}"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"To get a histogram of your results, add the following code to your "
"program.\n"
msgstr ""
