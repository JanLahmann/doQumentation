#, markdown-text, no-wrap
msgid ""
"        <OperatingSystemTabs>\n"
"          <TabItem value=\"mac\" label=\"macOS\">\n"
msgstr ""
"        <OperatingSystemTabs>\n"
"          <TabItem value=\"mac\" label=\"macOS\">\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"            ```shell\n"
"            python3 -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
msgstr ""
"            ```shell\n"
"            python3 -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"

#. type: Plain text
#, markdown-text, no-wrap
