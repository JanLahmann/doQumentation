#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Learn how to install the development version of the IBM Quantum Compute client."
msgstr "Дізнайся, як встановити версію для розробки клієнта IBM Quantum Compute."

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Install the IBM Quantum Compute client from source"
msgstr "Встановлення клієнта IBM Quantum Compute із вихідного коду"

#. type: Plain text
#, no-wrap
msgid "{/* cspell:ignore rustup */}\n"
msgstr "{/* cspell:ignore rustup */}\n"

#. type: Title #
#, no-wrap
msgid "Install the IBM Quantum Compute client from source {#install-the-ibm-quantum-compute-client-from-source}"
msgstr "Встановлення клієнта IBM Quantum Compute із вихідного коду {#install-the-ibm-quantum-compute-client-from-source}"

#. type: Plain text
#, no-wrap
msgid "When you install `qiskit-ibm-runtime` from source, you can access the current development version, instead of using the version in the Python Package Index (PyPI) repository. You can therefore inspect and extend the latest version of the code more efficiently.\n"
msgstr "Коли ти встановлюєш `qiskit-ibm-runtime` із вихідного коду, ти можеш отримати доступ до поточної версії для розробки, замість використання версії з репозиторію Python Package Index (PyPI). Таким чином ти можеш ефективніше перевіряти та розширювати останню версію коду.\n"

#. type: Title ##
#, no-wrap
msgid "Create and activate a new virtual environment {#create-and-activate-a-new-virtual-environment}"
msgstr "Створення та активація нового віртуального середовища {#create-and-activate-a-new-virtual-environment}"

#. type: Bullet: '1. '
#, no-wrap
msgid "Navigate to your project directory and create a minimal environment with only Python installed in it.\n"
msgstr "Перейди до каталогу свого проєкту та створи мінімальне середовище лише з Python.\n"

#. type: Plain text
#, no-wrap
msgid ""
"        <OperatingSystemTabs>\n"
"          <TabItem value=\"mac\" label=\"macOS\">\n"
msgstr ""
"        <OperatingSystemTabs>\n"
"          <TabItem value=\"mac\" label=\"macOS\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"            ```shell\n"
"            python3 -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
msgstr ""
"            ```shell\n"
"            python3 -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"

#. type: Plain text
#, no-wrap
msgid "          <TabItem value=\"linux\" label=\"Linux\">\n"
msgstr "          <TabItem value=\"linux\" label=\"Linux\">\n"

#. type: Plain text
#, no-wrap
msgid "          <TabItem value=\"win\" label=\"Windows\">\n"
msgstr "          <TabItem value=\"win\" label=\"Windows\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"            ```text\n"
"            python -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
"         </OperatingSystemTabs>\n"
msgstr ""
"            ```text\n"
"            python -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
"         </OperatingSystemTabs>\n"

#. type: Bullet: '1. '
#, no-wrap
msgid "Activate your new environment.\n"
msgstr "Активуй нове середовище.\n"

#. type: Plain text
#, no-wrap
msgid ""
"         <OperatingSystemTabs>\n"
"           <TabItem value=\"mac\" label=\"macOS\">\n"
msgstr ""
"         <OperatingSystemTabs>\n"
"           <TabItem value=\"mac\" label=\"macOS\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"             ```shell\n"
"             source .venv/bin/activate\n"
"             ```\n"
"           </TabItem>\n"
msgstr ""
"             ```shell\n"
"             source .venv/bin/activate\n"
"             ```\n"
"           </TabItem>\n"

#. type: Plain text
#, no-wrap
msgid "           <TabItem value=\"linux\" label=\"Linux\">\n"
msgstr "           <TabItem value=\"linux\" label=\"Linux\">\n"

#. type: Plain text
#, no-wrap
