msgid ""
"Use Qiskit MCP Servers to integrate quantum computing capabilities into AI "
"assistants and agents."
msgstr ""
"Використовуй MCP-сервери Qiskit для інтеграції можливостей квантових "
"обчислень в AI-асистенти та агенти."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Qiskit MCP Servers"
msgstr "MCP-сервери Qiskit"

