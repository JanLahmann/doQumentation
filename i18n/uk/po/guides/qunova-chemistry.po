"|  $NH_3$ (15o,10e)   |  30               |  9018009              |  49729                |  0.90                     |  5                 | 354 с         | 54 с             |\n"
"|  $N_2$ (16o,14e)    |  32               |  130873600            |  1798281              |  1.10                     |  9                 | 6531 с        | 121 с            |\n"
"|  $3H_2O$ (18o,24e)  |  36               |  344622096            |  399424               |  0.90                     |  24                | 5174 с        | 130 с            |\n"
"|  $N_2$ (20o,14e)    |  40               |  6009350400           |  9012004              |  1.20                     |  21                | 46547 с       | 258 с            |\n"

#. type: Title ##
#, markdown-text, no-wrap
msgid "Fetch error messages {#fetch-error-messages}"
msgstr "Отримання повідомлень про помилки {#fetch-error-messages}"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"If your workload fails, the status will be `ERROR` and calling "
"`job.result()` will raise an exception:\n"
msgstr ""
