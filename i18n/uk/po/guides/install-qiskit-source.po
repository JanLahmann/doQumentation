#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"            ```text\n"
"            python -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
"         </OperatingSystemTabs>\n"
msgstr ""
"            ```text\n"
"            python -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
"         </OperatingSystemTabs>\n"

