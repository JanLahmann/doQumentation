# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"llama-cli -hf Qiskit/Qwen2.5-Coder-14B-Qiskit-GGUF \\\n"
"  -p \"You are a friendly assistant.\" -cnv \\\n"
"  --temp 0.7 \\\n"
"  --top-k 50 \\\n"
"  --top-p 0.95 \\\n"
"  --repeat-penalty 1.1 \\\n"
"  --seed 42\n"
msgstr ""
"llama-cli -hf Qiskit/Qwen2.5-Coder-14B-Qiskit-GGUF \\\n"
