msgstr "<AccordionItem title=\"Завантаження за допомогою Hugging Face CLI\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"To download any of the available Qiskit Code Assistant models using the "
