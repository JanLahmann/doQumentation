msgid "Upload input files for a managed workflow, read and write them in a job, and download the outputs."
msgstr "Завантажуй вхідні файли для кероване робочого процесу, читай і записуй їх у завданні та завантажуй вихідні дані."

# doq: translated after an English change 2026-11-12
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Manage files across runs"
msgstr "Керування файлами між запусками"

