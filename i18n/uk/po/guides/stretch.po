#, no-wrap
msgid ""
"- Stretch expressions can only include a single stretch variable.\n"
"    <Tabs>\n"
"        <TabItem value=\"Invalid\" label=\"Invalid\">\n"
msgstr ""
"- Вирази stretch можуть містити лише одну змінну stretch.\n"
"    <Tabs>\n"
"        <TabItem value=\"Invalid\" label=\"Неправильно\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        b = circuit.add_stretch(\"b\")\n"
"        circuit.delay(expr.add(a, b), 0)\n"
"         ```\n"
"     </TabItem>\n"
"         <TabItem value=\"Valid\" label=\"Valid\">\n"
msgstr ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        b = circuit.add_stretch(\"b\")\n"
"        circuit.delay(expr.add(a, b), 0)\n"
"         ```\n"
"     </TabItem>\n"
"         <TabItem value=\"Valid\" label=\"Правильно\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        circuit.delay(expr.add(a, a), 0)\n"
"        ```\n"
"     </TabItem>\n"
msgstr ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        circuit.delay(expr.add(a, a), 0)\n"
"        ```\n"
"     </TabItem>\n"

#. type: Plain text
#, no-wrap
msgid "    </Tabs>\n"
msgstr "    </Tabs>\n"

#. type: Plain text
#, no-wrap
msgid ""
"- Stretch expressions cannot resolve to negative delay values. The current solver doesn't infer non-negativity constraints.\n"
"    <Tabs>\n"
"         <TabItem value=\"Invalid\" label=\"Invalid\">\n"
msgstr ""
"- Вирази stretch не можуть розв'язуватися до від'ємних значень затримки. Поточний розв'язувач не враховує обмеження невід'ємності.\n"
"    <Tabs>\n"
"         <TabItem value=\"Invalid\" label=\"Неправильно\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(20, q1)\n"
"        # The length of this barrier region is 20dt, meaning the\n"
"        # equation for solving stretch 'a' is a + 40dt = 20dt, giving a = -20dt.\n"
"        circuit.delay(expr.add(a, Duration.dt(40)), q0)\n"
"        circuit.barrier((q0, q1))\n"
"         ```\n"
"     </TabItem>\n"
"     <TabItem value=\"Valid\" label=\"Valid\">\n"
msgstr ""
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(20, q1)\n"
"        # The length of this barrier region is 20dt, meaning the\n"
"        # equation for solving stretch 'a' is a + 40dt = 20dt, giving a = -20dt.\n"
"        circuit.delay(expr.add(a, Duration.dt(40)), q0)\n"
"        circuit.barrier((q0, q1))\n"
"         ```\n"
"     </TabItem>\n"
"     <TabItem value=\"Valid\" label=\"Правильно\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"        ```python\n"
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(20, q1)\n"
"        circuit.delay(a, q0)\n"
"        circuit.barrier((q0, q1))\n"
"        ```\n"
"     </TabItem>\n"
"    </Tabs>\n"
msgstr ""
"        ```python\n"
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(20, q1)\n"
"        circuit.delay(a, q0)\n"
"        circuit.barrier((q0, q1))\n"
"        ```\n"
"     </TabItem>\n"
"    </Tabs>\n"
