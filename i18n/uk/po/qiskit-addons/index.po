#. type: Bullet: '- '
#, no-wrap
msgid "[Circuit cutting: depth reduction](/tutorials/depth-reduction-with-circuit-cutting)\n"
msgstr "[Розрізання схем: зменшення глибини](/tutorials/depth-reduction-with-circuit-cutting)\n"

# doq: translated after an English change 2026-11-13
#. type: Bullet: '- '
#, no-wrap
msgid "[Circuit cutting: wire cutting](/tutorials/wire-cutting)\n"
msgstr "[Розрізання схем: розрізання дротів](/tutorials/wire-cutting)\n"

# doq: translated after an English change 2026-11-13
#. type: Bullet: '- '
#, no-wrap
