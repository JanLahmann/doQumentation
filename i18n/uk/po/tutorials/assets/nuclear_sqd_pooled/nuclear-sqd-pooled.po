msgstr "Вимоги {#requirements}"

# doq: translated after an English change 2026-10-07
#. type: Plain text
#, no-wrap
msgid "Install the following packages before starting:\n"
msgstr "Перед початком установи такі пакети:\n"

# doq: translated after an English change 2026-10-07
