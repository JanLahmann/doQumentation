# doq-bootstrap: positional
#. type: Title ###
#, no-wrap
msgid "Set up backend and coupling map {#set-up-backend-and-coupling-map}"
msgstr "Налаштувати бекенд та карту з'єднань {#set-up-backend-and-coupling-map}"

# doq-bootstrap: positional
