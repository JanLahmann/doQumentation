# doq: copied, nothing translatable
#. type: Bullet: '- '
#, no-wrap
msgid "pandas (`pip install pandas`)\n"
msgstr "pandas (`pip install pandas`)\n"

# doq: copied, nothing translatable
#. type: Bullet: '- '
#, no-wrap
