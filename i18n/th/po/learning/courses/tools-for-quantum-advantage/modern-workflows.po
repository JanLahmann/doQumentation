#, no-wrap
msgid "Layout: map logical qubits to physical qubits\n"
msgstr "Layout: แมป logical qubits ไปยัง physical qubits\n"

# doq: translated after an English change 2026-11-12
#. type: Bullet: '* '
#, no-wrap
msgid "Translation: rewrite operations using the backend's native gate set\n"
