msgstr "1.1 GHZ state {#11-ghz-state}"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"The GHZ state (Greenberger-Horne-Zeilinger state) for $n$ qubits is defined "
"as\n"
msgstr ""
"GHZ state (Greenberger-Horne-Zeilinger state) สำหรับ $n$ Qubit "
"นิยามไว้ดังนี้\n"

