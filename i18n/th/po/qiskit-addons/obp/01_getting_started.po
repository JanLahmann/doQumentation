msgid "Next, we generate a Pauli operator modeling a Heisenberg XYZ Hamiltonian.\n"
msgstr "ถัดมา เราจะสร้าง Pauli operator สำหรับจำลอง Heisenberg XYZ Hamiltonian\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"$$\\hat{H} = \\sum_{(j,k)\\in E} (J_{x} \\sigma_j^{x} \\sigma_{k}^{x} +\n"
"    J_{y} \\sigma_j^{y} \\sigma_{k}^{y} + J_{z} \\sigma_j^{z} \\sigma_{k}^{z}) +\n"
"    \\sum_{j\\in V} (h_{x} \\sigma_j^{x} + h_{y} \\sigma_j^{y} + h_{z} \\sigma_j^{z})$$\n"
msgstr ""
"$$\\hat{H} = \\sum_{(j,k)\\in E} (J_{x} \\sigma_j^{x} \\sigma_{k}^{x} +\n"
"    J_{y} \\sigma_j^{y} \\sigma_{k}^{y} + J_{z} \\sigma_j^{z} \\sigma_{k}^{z}) +\n"
"    \\sum_{j\\in V} (h_{x} \\sigma_j^{x} + h_{y} \\sigma_j^{y} + h_{z} \\sigma_j^{z})$$\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "Where $G(V,E)$ is the graph of the coupling map provided.\n"
msgstr "โดยที่ $G(V,E)$ คือ graph ของ coupling map ที่กำหนดให้\n"

