msgid "Reducing depth of circuits with operator backpropagation"
msgstr "การลดความลึกของ Circuit ด้วย Operator Backpropagation"

# doq-bootstrap: dropped, JSX/HTML tags differ from English: Operator
# backpropagation คือเทคนิคที่นำการดำเนินการจากปลาย q
#. type: Plain text
