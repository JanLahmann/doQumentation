"    />\n"

#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"Sampler\"\n"
"      description=\"Samples the output register from the execution of one or more quantum circuits.\"\n"
"      href=\"/guides/get-started-with-sampler\"\n"
"      analyticsName=\"Sampler quickstart\"\n"
"      linkText=\"Sampler quickstart\"\n"
"    />\n"
