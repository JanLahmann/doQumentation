#. type: Plain text
#, markdown-text, no-wrap
msgid "Examples of array pairs that broadcast:\n"
msgstr "ตัวอย่างคู่ของ arrays ที่ broadcast ได้:\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "Examples of array pairs that do not broadcast:\n"
msgstr "ตัวอย่างคู่ของ arrays ที่ broadcast ไม่ได้:\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"`Estimator` returns one expectation value estimate for each element of the "
