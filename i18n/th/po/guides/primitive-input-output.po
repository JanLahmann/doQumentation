"    <TabItem value=\"estimator\" label=\"Estimator output\">\n"
msgstr ""
"<Tabs>\n"
"    <TabItem value=\"estimator\" label=\"Estimator output\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"    ```\n"
