#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"- Stretch expressions cannot resolve to negative delay values. The current solver doesn't infer non-negativity constraints.\n"
"    <Tabs>\n"
"         <TabItem value=\"Invalid\" label=\"Invalid\">\n"
msgstr ""
"- Stretch expression ไม่สามารถแก้ไขให้เป็นค่า delay ติดลบได้ solver ปัจจุบันไม่อนุมาน non-negativity constraint\n"
"    <Tabs>\n"
"         <TabItem value=\"Invalid\" label=\"ไม่ถูกต้อง\">\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(20, q1)\n"
"        # The length of this barrier region is 20dt, meaning the\n"
"        # equation for solving stretch 'a' is a + 40dt = 20dt, giving a = -20dt.\n"
"        circuit.delay(expr.add(a, Duration.dt(40)), q0)\n"
"        circuit.barrier((q0, q1))\n"
"         ```\n"
"     </TabItem>\n"
"     <TabItem value=\"Valid\" label=\"Valid\">\n"
msgstr ""
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(20, q1)\n"
"        # The length of this barrier region is 20dt, meaning the\n"
"        # equation for solving stretch 'a' is a + 40dt = 20dt, giving a = -20dt.\n"
"        circuit.delay(expr.add(a, Duration.dt(40)), q0)\n"
"        circuit.barrier((q0, q1))\n"
"         ```\n"
"     </TabItem>\n"
"     <TabItem value=\"Valid\" label=\"ถูกต้อง\">\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"        ```python\n"
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(20, q1)\n"
"        circuit.delay(a, q0)\n"
"        circuit.barrier((q0, q1))\n"
"        ```\n"
"     </TabItem>\n"
"    </Tabs>\n"
msgstr ""
"        ```python\n"
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(20, q1)\n"
"        circuit.delay(a, q0)\n"
"        circuit.barrier((q0, q1))\n"
"        ```\n"
"     </TabItem>\n"
"    </Tabs>\n"
