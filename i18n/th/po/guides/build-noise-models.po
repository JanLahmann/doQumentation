msgid "Classical readout errors are specified by a list of assignment probability vectors $P(A|B)$:\n"
msgstr "Classical readout error ระบุเป็นรายการ assignment probability vectors $P(A|B)$:\n"

# doq-bootstrap: positional
#. type: Bullet: '  * '
