# doq-bootstrap: positional
#. type: Title #
#, no-wrap
msgid "Overview of noise management techniques {#overview-of-noise-management-techniques}"
msgstr "Überblick über Rauschmanagement-Techniken {#overview-of-noise-management-techniques}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "When executing quantum workloads, there are multiple ways to reduce the impact of noise. The open-source Qiskit addons provide error mitigation and suppression techniques that integrate directly into your development workflow, while Qiskit Runtime applies advanced error mitigation strategies automatically when jobs are submitted for execution. This page indexes all available tools and features across both options to help you choose the right approach to manage noise when building quantum workloads.\n"
msgstr "Beim Ausführen von Quanten-Workloads gibt es mehrere Möglichkeiten, den Einfluss von Rauschen zu reduzieren. Die Open-Source-Qiskit-Addons bieten Fehlermindrungs- und Fehlersuppressionstechniken, die sich direkt in deinen Entwicklungsworkflow integrieren lassen, während Qiskit Runtime beim Einreichen von Jobs zur Ausführung automatisch fortschrittliche Fehlerminderungsstrategien anwendet. Diese Seite indiziert alle verfügbaren Werkzeuge und Funktionen beider Optionen, damit du den richtigen Ansatz zur Rauschverwaltung beim Erstellen von Quanten-Workloads wählen kannst.\n"

# doq-bootstrap: positional
#. type: Title ##
#, no-wrap
msgid "General noise management techniques {#general-noise-management-techniques}"
msgstr "Allgemeine Rauschmanagement-Techniken {#general-noise-management-techniques}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"<CardGroup>\n"
"    <Card\n"
"      title=\"Directed execution model\"\n"
"      description=\"Fine-tune error mitigation and other techniques by capturing design intents on the client side, and shifting the costly generation of circuit variants to the server side.\"\n"
"      href=\"/guides/directed-execution-model\"\n"
"      analyticsName=\"Documentation page: Directed execution model\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
msgstr ""
"<CardGroup>\n"
"    <Card\n"
"      title=\"Gerichtetes Ausführungsmodell\"\n"
"      description=\"Feinabstimmung von Fehlerminderung und anderen Techniken, indem Designabsichten auf der Client-Seite erfasst und die kostspielige Erzeugung von Circuit-Varianten auf die Server-Seite verlagert wird.\"\n"
"      href=\"/guides/directed-execution-model\"\n"
"      analyticsName=\"Documentation page: Directed execution model\"\n"
"      linkText=\"Dokumentation durchsuchen\"\n"
"    />\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"Dynamical decoupling\"\n"
"      description=\"Inserts pulse sequences on idling qubits to suppress coherence errors caused by unwanted interactions between qubits during circuit execution.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#dynamical-decoupling\"\n"
"      analyticsName=\"Documentation page: Dynamical decoupling\"\n"
"      linkText=\"Learn more\"\n"
"    />\n"
msgstr ""
"    <Card\n"
"      title=\"Dynamisches Entkoppeln\"\n"
"      description=\"Fügt Pulssequenzen auf ruhenden Qubits ein, um Kohärenzfehler zu unterdrücken, die durch unerwünschte Wechselwirkungen zwischen Qubits während der Circuit-Ausführung verursacht werden.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#dynamical-decoupling\"\n"
"      analyticsName=\"Documentation page: Dynamical decoupling\"\n"
"      linkText=\"Mehr erfahren\"\n"
"    />\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"Pauli twirling\"\n"
"      description=\"Noise-tailoring technique that transforms any noise channel into a Pauli channel that has a more specific structure; often combined with other error mitigation techniques that work well with Pauli noise.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#pauli-twirling\"\n"
"      analyticsName=\"Documentation page: Pauli twirling\"\n"
"      linkText=\"Learn more\"\n"
"    />\n"
msgstr ""
"    <Card\n"
"      title=\"Pauli-Twirling\"\n"
"      description=\"Eine rauschformende Technik, die jeden Rauschkanal in einen Pauli-Kanal mit einer spezifischeren Struktur umwandelt; wird häufig mit anderen Fehlerminderungstechniken kombiniert, die gut mit Pauli-Rauschen funktionieren.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#pauli-twirling\"\n"
"      analyticsName=\"Documentation page: Pauli twirling\"\n"
"      linkText=\"Mehr erfahren\"\n"
"    />\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"AQC-Tensor Qiskit addon\"\n"
"      description=\"Users can compile the initial portion of a circuit into a nearly equivalent approximation of that circuit, but with fewer layers.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-aqc-tensor/\"\n"
"      analyticsName=\"Documentation page: Approximate quantum compilation\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
"</CardGroup>\n"
msgstr ""
"    <Card\n"
"      title=\"AQC-Tensor Qiskit Addon\"\n"
"      description=\"Nutzer können den Anfangsteil eines Circuits in eine nahezu äquivalente Näherung dieses Circuits kompilieren, jedoch mit weniger Schichten.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-aqc-tensor/\"\n"
"      analyticsName=\"Documentation page: Approximate quantum compilation\"\n"
"      linkText=\"Dokumentation durchsuchen\"\n"
"    />\n"
"</CardGroup>\n"

# doq-bootstrap: positional
#. type: Title ##
#, no-wrap
msgid "Error mitigation for expectation value estimation {#error-mitigation-for-expectation-value-estimation}"
msgstr "Fehlerminderung für die Erwartungswertschätzung {#error-mitigation-for-expectation-value-estimation}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"<CardGroup>\n"
"    <Card\n"
"      title=\"Twirled readout error extinction (TREX)\"\n"
"      description=\"Error mitigation tool within Qiskit Runtime which mitigate the effects of measurement errors by randomly substituting them with a twirled measurement sequence.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#twirled-readout-error-extinction-trex\"\n"
"      analyticsName=\"Documentation page: TREX\"\n"
"      linkText=\"Learn more\"\n"
"    />\n"
"    <Card\n"
"      title=\"Zero-noise extrapolation (ZNE)\"\n"
"      description=\"Error mitigation technique that computes the expectation value at different noise levels, and then estimates the ideal result by extrapolating the noisy expectation value results to the zero-noise limit.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#zero-noise-extrapolation-zne\"\n"
"      analyticsName=\"Documentation page: ZNE\"\n"
"      linkText=\"Learn more\"\n"
"    />\n"
"    <Card\n"
"      title=\"Probabilistic error amplification (PEA)\"\n"
"      description=\"ZNE technique that involves running preliminary experiments to learn a twirled noise model of the circuit, then uses this model to perform a more accurate error amplification.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#probabilistic-error-amplification-pea\"\n"
"      analyticsName=\"Documentation page: PEA\"\n"
"      linkText=\"Learn more\"\n"
"    />\n"
"    <Card\n"
"      title=\"Probabilistic error cancellation (PEC)\"\n"
"      description=\"Returns an unbiased estimate of the expectation value, at the expense of greater overhead than other techniques such as ZNE. It extrapolates output of the ideal circuit by executing different noisy circuit instances.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#probabilistic-error-cancellation-pec\"\n"
"      analyticsName=\"Documentation page: PEC\"\n"
"      linkText=\"Learn more\"\n"
"    />\n"
msgstr ""
"<CardGroup>\n"
"    <Card\n"
"      title=\"Twirled Readout Error Extinction (TREX)\"\n"
"      description=\"Fehlerminderungswerkzeug innerhalb von Qiskit Runtime, das die Auswirkungen von Messfehlern mindert, indem es diese zufällig durch eine getwirlete Messsequenz ersetzt.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#twirled-readout-error-extinction-trex\"\n"
"      analyticsName=\"Documentation page: TREX\"\n"
"      linkText=\"Mehr erfahren\"\n"
"    />\n"
"    <Card\n"
"      title=\"Zero-Noise Extrapolation (ZNE)\"\n"
"      description=\"Fehlerminderungstechnik, die den Erwartungswert bei verschiedenen Rauschpegeln berechnet und dann das ideale Ergebnis schätzt, indem die verrauschten Erwartungswerte auf das Rauschfreie-Limit extrapoliert werden.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#zero-noise-extrapolation-zne\"\n"
"      analyticsName=\"Documentation page: ZNE\"\n"
"      linkText=\"Mehr erfahren\"\n"
"    />\n"
"    <Card\n"
"      title=\"Probabilistische Fehleramplifikation (PEA)\"\n"
"      description=\"ZNE-Technik, bei der zunächst Vorexperimente durchgeführt werden, um ein getwirleltes Rauschmodell des Circuits zu erlernen, das dann für eine genauere Fehleramplifikation verwendet wird.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#probabilistic-error-amplification-pea\"\n"
"      analyticsName=\"Documentation page: PEA\"\n"
"      linkText=\"Mehr erfahren\"\n"
"    />\n"
"    <Card\n"
"      title=\"Probabilistische Fehlerkompensation (PEC)\"\n"
"      description=\"Liefert eine unverfälschte Schätzung des Erwartungswertes, allerdings mit größerem Aufwand als andere Techniken wie ZNE. Sie extrapoliert die Ausgabe des idealen Circuits durch Ausführen verschiedener verrauschter Circuit-Instanzen.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#probabilistic-error-cancellation-pec\"\n"
"      analyticsName=\"Documentation page: PEC\"\n"
"      linkText=\"Mehr erfahren\"\n"
"    />\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"PEC with shaded lightcones\"\n"
"      description=\"A modified PEC technique that uses Pauli propagation to reduce the number of error terms accounted for in a noise model according to the specifics of the target observable.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-slc/\"\n"
"      analyticsName=\"Documentation page: Shaded lightcones\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
"    <Card\n"
"      title=\"Operator backpropagation (OBP)\"\n"
"      description=\"Uses a method based on Clifford perturbation theory to reduce circuit depth by trimming operations from its end at the cost of more operator measurements.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-obp/\"\n"
"      analyticsName=\"Documentation page: Operator backpropagation\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
"    <Card\n"
"      title=\"Propagated noise absorption (PNA)\"\n"
"      description=\"Technique for mitigating errors in observable expectation values by 'absorbing' the inverses of learned noise channels into an observable using Pauli propagation.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-pna/\"\n"
"      analyticsName=\"Documentation page: Propagated noise absorption\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
"</CardGroup>\n"
msgstr ""
"    <Card\n"
"      title=\"PEC mit schattigen Lichtkegeln\"\n"
"      description=\"Eine modifizierte PEC-Technik, die Pauli-Propagation verwendet, um die Anzahl der im Rauschmodell berücksichtigten Fehlerterme gemäß den Besonderheiten der Zielobservablen zu reduzieren.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-slc/\"\n"
"      analyticsName=\"Documentation page: Shaded lightcones\"\n"
"      linkText=\"Dokumentation durchsuchen\"\n"
"    />\n"
"    <Card\n"
"      title=\"Operator-Rückpropagation (OBP)\"\n"
"      description=\"Verwendet eine Methode auf Basis der Clifford-Störungstheorie, um die Circuit-Tiefe zu reduzieren, indem Operationen von dessen Ende entfernt werden – auf Kosten weiterer Operator-Messungen.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-obp/\"\n"
"      analyticsName=\"Documentation page: Operator backpropagation\"\n"
"      linkText=\"Dokumentation durchsuchen\"\n"
"    />\n"
"    <Card\n"
"      title=\"Propagierte Rauschaufnahme (PNA)\"\n"
"      description=\"Technik zur Minderung von Fehlern in Erwartungswerten von Observablen, indem die Inversen gelernter Rauschkanäle mithilfe von Pauli-Propagation in eine Observable 'absorbiert' werden.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-pna/\"\n"
"      analyticsName=\"Documentation page: Propagated noise absorption\"\n"
"      linkText=\"Dokumentation durchsuchen\"\n"
"    />\n"
"</CardGroup>\n"

# doq-bootstrap: positional
#. type: Title ##
#, no-wrap
msgid "Error mitigation for sampling results {#error-mitigation-for-sampling-results}"
msgstr "Fehlerminderung für Stichprobenergebnisse {#error-mitigation-for-sampling-results}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"<CardGroup>\n"
"    <Card\n"
"      title=\"Sample-based quantum diagonalization (SQD)\"\n"
"      description=\"Implements a technique for finding eigenvalues and eigenvectors of quantum operators, such as a quantum system Hamiltonian, using quantum and distributed classical computing together.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-sqd/\"\n"
"      analyticsName=\"Documentation page: SQD\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
msgstr ""
"<CardGroup>\n"
"    <Card\n"
"      title=\"Sample-basierte Quantendiagonalisierung (SQD)\"\n"
"      description=\"Implementiert eine Technik zur Bestimmung von Eigenwerten und Eigenvektoren quantenmechanischer Operatoren, wie z. B. eines Quanten-System-Hamiltonians, durch die gemeinsame Nutzung von Quanten- und verteiltem klassischen Computing.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-sqd/\"\n"
"      analyticsName=\"Documentation page: SQD\"\n"
"      linkText=\"Dokumentation durchsuchen\"\n"
"    />\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"SQD for HPC\"\n"
"      description=\"An HPC-ready implementation of the SQD addon. It is written in modern C++17 standards and is designed to create a single compiled binary for use with MPI.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-sqd-hpc/\"\n"
"      analyticsName=\"Documentation page: SQD for HPC\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
msgstr ""
"    <Card\n"
"      title=\"SQD für HPC\"\n"
"      description=\"Eine HPC-fähige Implementierung des SQD-Addons. Sie ist in modernem C++17-Standard geschrieben und darauf ausgelegt, eine einzelne kompilierte Binärdatei für die Verwendung mit MPI zu erstellen.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-sqd-hpc/\"\n"
"      analyticsName=\"Documentation page: SQD for HPC\"\n"
"      linkText=\"Dokumentation durchsuchen\"\n"
"    />\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"Matrix-free Measurement Mitigation\"\n"
"      description=\"Matrix-free Measurement Mitigation (M3) is a package for scalable quantum measurement error mitigation that can be computed in parallel.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-mthree/\"\n"
"      analyticsName=\"Documentation page: M3\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
"</CardGroup>\n"
msgstr ""
"    <Card\n"
"      title=\"Matrix-freie Messfehlerminderung\"\n"
"      description=\"Matrix-freie Messfehlerminderung (M3) ist ein Paket für skalierbare Quanten-Messfehlerminderung, das parallel berechnet werden kann.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-mthree/\"\n"
"      analyticsName=\"Documentation page: M3\"\n"
"      linkText=\"Dokumentation durchsuchen\"\n"
"    />\n"
"</CardGroup>\n"
