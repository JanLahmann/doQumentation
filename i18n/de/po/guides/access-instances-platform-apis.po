msgid ""
"Parameters to set when provisioning a Qiskit Runtime service instance, and "
"extension fields returned when accessing an instance."
msgstr ""
"Parameter, die beim Bereitstellen einer Qiskit Runtime Service-Instanz "
"gesetzt werden können, sowie Erweiterungsfelder, die beim Zugriff auf eine "
"Instanz zurückgegeben werden."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Use IBM Cloud Platform APIs to access instances"
msgstr "IBM Cloud Platform APIs für den Zugriff auf Instanzen verwenden"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
