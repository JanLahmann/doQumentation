#, no-wrap
msgid "Use Qiskit MCP Servers to integrate quantum computing capabilities into AI assistants and agents."
msgstr "Verwende Qiskit MCP Server, um Quantencomputing-Funktionen in KI-Assistenten und Agenten zu integrieren."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Qiskit MCP Servers"
msgstr "Qiskit MCP Server"

