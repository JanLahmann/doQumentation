msgstr "Qiskit Function-Job-ID (`qiskit-ibm-catalog`), `job.job_id`\n"

#. type: Bullet: '- '
#, no-wrap
msgid "Backend name\n"
msgstr "Backend-Name\n"

#. type: Bullet: '- '
#, no-wrap
msgid "Orbit `pub_options` used for the raw and Orbit modes\n"
msgstr "Für den Raw- und den Orbit-Modus verwendete `pub_options` von Orbit\n"

#. type: Bullet: '- '
