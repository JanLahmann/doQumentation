"\\end{pmatrix} \\frac{1}{\\sqrt{2}}\n"
"\\begin{pmatrix}\n"
"1 \\\\\n"
"1 \\\\\n"
"0 \\\\\n"
"0\n"
"\\end{pmatrix}\n"
"=\n"
msgstr ""
