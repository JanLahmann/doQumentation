#, no-wrap
msgid "Finally, we apply PEC.\n"
msgstr "Zum Schluss wenden wir PEC an.\n"

# doq: translated after an English change 2026-10-13 · verified 2026-10-16
#. type: Plain text
#, no-wrap
msgid "Below we plot our results and compare.\n"
msgstr "Unten stellen wir unsere Ergebnisse grafisch dar und vergleichen sie.\n"

# doq: copied, nothing translatable
