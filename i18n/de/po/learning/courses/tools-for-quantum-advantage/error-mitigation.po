msgid "Overview of PEC workflow {#overview-of-pec-workflow}"
msgstr "Überblick über den PEC-Workflow {#overview-of-pec-workflow}"

# doq: translated after an English change 2026-10-13 · verified 2026-10-16
#. type: Plain text
#, no-wrap
msgid "In PEC, all steps on the quantum computer are:\n"
msgstr "Bei PEC sind alle Schritte auf dem Quantencomputer:\n"

# doq: translated after an English change 2026-10-13 · verified 2026-10-16
#. type: Bullet: '* '
#, no-wrap
msgid "Noise learning\n"
msgstr "Rauschlernen\n"

# doq: translated after an English change 2026-10-13 · verified 2026-10-16
