# doq: translated after an English change 2026-09-24
#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "We explore various types of quantum noise and errors, what causes them, and how to model them."
msgstr "Wir untersuchen verschiedene Arten von Quantenrauschen und -fehlern, ihre Ursachen und wie man sie modelliert."

# doq: translated after an English change 2026-09-24
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Noise and errors"
msgstr "Rauschen und Fehler"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"learning/courses/tools-for-quantum-advantage/noise-and-errors.ipynb\" />\n"
msgstr ""

