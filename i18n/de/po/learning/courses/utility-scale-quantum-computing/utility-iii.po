#, markdown-text, no-wrap
msgid "1.1 GHZ state {#11-ghz-state}"
msgstr "1.1 GHZ-Zustand {#11-ghz-state}"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"The GHZ state (Greenberger-Horne-Zeilinger state) for $n$ qubits is defined "
"as\n"
msgstr ""
"Der GHZ-Zustand (Greenberger-Horne-Zeilinger-Zustand) fuer $n$ Qubits ist "
"definiert als\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|0\\rangle ^ {\\otimes n}+ |1\\rangle^ {\\otimes n})\n"
"$$\n"
msgstr ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|0\\rangle ^ {\\otimes n}+ |1\\rangle^ {\\otimes n})\n"
"$$\n"

