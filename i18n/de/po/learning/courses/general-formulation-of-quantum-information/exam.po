#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Take a 20-question exam on the IBM Training site to test your quantum information skills and receive a badge through Credly."
msgstr "Lege eine 20-Fragen-Prüfung auf der IBM Training-Seite ab, um deine Kenntnisse der Quanteninformation zu testen, und erhalte ein Badge über Credly."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Exam  | General formulation of quantum information"
msgstr "Prüfung | Allgemeine Formulierung der Quanteninformation"

# doq-bootstrap: positional
#. type: Title #
#, no-wrap
msgid "Exam and badge {#exam-and-badge}"
msgstr "Prüfung und Badge {#exam-and-badge}"

# doq-bootstrap: positional
