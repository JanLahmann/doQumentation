"& = \\sum_{a = 0}^{1} \\vert a\\rangle\\langle a \\vert \\otimes \\vert 0\\rangle \\langle 0\\vert\\\\[4mm]\n"
"& = \\mathbb{I} \\otimes \\vert 0\\rangle \\langle 0\\vert\\\\[3mm]\n"
"& = \\begin{pmatrix}\n"
"1 & 0 & 0 & 0\\\\[1mm]\n"
