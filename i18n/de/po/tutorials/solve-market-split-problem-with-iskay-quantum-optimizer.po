msgid "**Try different instances**: Experiment with other QOBLIB instances of varying sizes\n"
msgstr "**Verschiedene Instanzen ausprobieren**: Experimentiere mit anderen QOBLIB-Instanzen unterschiedlicher Größe\n"

# doq-bootstrap: positional
#. type: Bullet: '2. '
#, no-wrap
msgid "**Tune parameters**: Adjust `num_iterations`, `preprocessing_level`, `postprocessing_level`\n"
msgstr "**Parameter anpassen**: Justiere `num_iterations`, `preprocessing_level`, `postprocessing_level`\n"

# doq-bootstrap: positional
#. type: Bullet: '3. '
#, no-wrap
msgid "**Compare with classical**: Benchmark against classical optimization solvers\n"
msgstr "**Mit klassischen Methoden vergleichen**: Benchmark gegen klassische Optimierungs-Solver\n"

# doq-bootstrap: positional
#. type: Bullet: '4. '
#, no-wrap
msgid "**Try different strategies**: Try to find a better encoding for the problem or formulate it as HUBO (if possible)\n"
msgstr "**Andere Strategien ausprobieren**: Versuche eine bessere Kodierung für das Problem zu finden oder formuliere es als HUBO (wenn möglich)\n"

# doq-bootstrap: positional
#. type: Bullet: '5. '
