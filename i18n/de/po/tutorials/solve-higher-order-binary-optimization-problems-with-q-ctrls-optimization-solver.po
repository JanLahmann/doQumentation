msgstr "Dieses Tutorial führt durch die folgenden Schritte:\n"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Define the problem as an objective function\n"
msgstr "Das Problem als Zielfunktion definieren\n"

# doq-bootstrap: positional
#. type: Bullet: '2. '
#, no-wrap
msgid "Run the hybrid algorithm using the Fire Opal Optimization Solver\n"
msgstr "Den hybriden Algorithmus mit dem Fire Opal Optimization Solver ausführen\n"

# doq-bootstrap: positional
#. type: Bullet: '3. '
#, no-wrap
msgid "Evaluate results\n"
msgstr "Ergebnisse auswerten\n"

