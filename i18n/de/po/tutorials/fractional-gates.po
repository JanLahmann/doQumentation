# doq-bootstrap: positional
#. type: Title ###
#, markdown-text, no-wrap
msgid ""
"Step 1: Map classical inputs to quantum problem {#step-1-map-classical-"
"inputs-to-quantum-problem}"
msgstr ""
"Schritt 1: Klassische Eingaben auf Quantenproblem abbilden {#step-1-map-"
