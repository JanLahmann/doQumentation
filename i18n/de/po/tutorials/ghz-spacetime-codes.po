msgstr ""
"![Ausgabe der vorherigen Code-Zelle](/docs/images/tutorials/error-"
"detection/extracted-outputs/78c8c2b6-0.avif)\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "We now add the measurements.\n"
msgstr "Wir fügen nun die Messungen hinzu.\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"The scheduling pipeline below locks in timing, removes barriers, simplifies "
