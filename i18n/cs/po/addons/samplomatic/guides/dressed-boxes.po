msgstr "Obvod k Pauli twirlingu.\n"

# doq: translated after an English change 2026-11-13
#. type: Plain text
#, no-wrap
msgid "This is achieved by stratifying the circuit into boxes and adding twirl annotations.\n"
msgstr "Toho se dosáhne rozvrstvením obvodu do boxů a přidáním twirlovacích anotací.\n"

# doq: copied, nothing translatable
#. type: Plain text
#, no-wrap
msgid "![../\\_images/dressed\\_pauli\\_twirl.drawio.png](/docs/images/addons/samplomatic/dressed_pauli_twirl.drawio.avif)\n"
