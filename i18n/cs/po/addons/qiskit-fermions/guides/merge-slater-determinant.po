# doq: translated after an English change 2026-11-13
#. type: Title ###
#, no-wrap
msgid "Per spin sector {#per-spin-sector}"
msgstr "Podle spinového sektoru {#per-spin-sector}"

# doq: translated after an English change 2026-11-13
#. type: Plain text
#, no-wrap
msgid "This is the same shape, but restricted to one spin half. Here, two independent initialize-then-rotate pairs, one per sector each fuse on their own into a [`PrepareSlaterDeterminant`](https://docs.quantum.ibm.com/api/qiskit-fermions/circuit-library-prepare-slater-determinant#qiskit_fermions.circuit.library.PrepareSlaterDeterminant \"qiskit_fermions.circuit.library.PrepareSlaterDeterminant\"):\n"
msgstr "Je to stejný tvar, ale omezený na jednu spinovou polovinu. Zde se dva nezávislé páry inicializace a rotace, jeden na sektor, každý samostatně spojí do [`PrepareSlaterDeterminant`](https://docs.quantum.ibm.com/api/qiskit-fermions/circuit-library-prepare-slater-determinant#qiskit_fermions.circuit.library.PrepareSlaterDeterminant \"qiskit_fermions.circuit.library.PrepareSlaterDeterminant\"):\n"

