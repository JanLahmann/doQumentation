"    uint32_t modes2[2] = {0, 0};\n"
"    uint32_t boundaries2[3] = {0, 0, 2};\n"
"    QfFermionOperator *op2 = qf_ferm_op_new(2, 2, coeff2, actions2, modes2, boundaries2);\n"

# doq: kept in English by the translator (name or code)
