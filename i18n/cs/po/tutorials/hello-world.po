#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Hello World: Your First Quantum Circuit"
msgstr "Hello World: Tvůj první kvantový Circuit"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"hello-world.ipynb\" description=\"This tutorial was created for doQumentation.\" />\n"
msgstr "<OpenInLabBanner notebookPath=\"hello-world.ipynb\" description=\"Tento tutoriál byl vytvořen pro doQumentation.\" />\n"

#. type: Plain text
#, no-wrap
msgid "Build a [Bell state](https://en.wikipedia.org/wiki/Bell_state) (two entangled qubits) and run it three ways:\n"
msgstr "Sestav [Bellův stav](https://en.wikipedia.org/wiki/Bell_state) (dva provázané qubity) a spusť ho třemi způsoby:\n"

#. type: Bullet: '1. '
#, no-wrap
msgid "**Ideal simulation** — perfect results, no account needed\n"
msgstr "**Ideální simulace** — dokonalé výsledky, účet není potřeba\n"

#. type: Bullet: '2. '
#, no-wrap
msgid "**Noisy simulation** — simulates a real device, no account needed\n"
msgstr "**Simulace se šumem** — simuluje reálné zařízení, účet není potřeba\n"

#. type: Bullet: '3. '
#, no-wrap
msgid "**Real quantum hardware** — requires a free IBM Quantum account (setup steps below)\n"
msgstr "**Skutečný kvantový hardware** — vyžaduje bezplatný IBM Quantum účet (postup nastavení níže)\n"

#. type: Title ##
#, no-wrap
msgid "Build the circuit {#build-the-circuit}"
msgstr "Sestav Circuit {#build-the-circuit}"

#. type: Title ##
#, no-wrap
msgid "Option 1: Ideal simulation (no account needed) {#option-1-ideal-simulation-no-account-needed}"
msgstr "Možnost 1: Ideální simulace (bez účtu) {#option-1-ideal-simulation-no-account-needed}"

#. type: Plain text
#, no-wrap
msgid "Uses `StatevectorSampler` — a local simulator with perfect, noise-free results.\n"
msgstr "Používá `StatevectorSampler` — lokální simulátor s dokonalými výsledky bez šumu.\n"

#. type: Title ##
#, no-wrap
msgid "Option 2: Noisy simulation (no account needed) {#option-2-noisy-simulation-no-account-needed}"
msgstr "Možnost 2: Simulace se šumem (bez účtu) {#option-2-noisy-simulation-no-account-needed}"

#. type: Plain text
#, no-wrap
msgid "Uses `FakeManilaV2` — a local simulator that mimics a real IBM quantum device, including its noise characteristics. The circuit must first be transpiled (adapted) to the device's gate set and qubit connectivity.\n"
msgstr "Používá `FakeManilaV2` — lokální simulátor, který napodobuje reálné IBM kvantové zařízení včetně jeho šumových charakteristik. Circuit musí být nejprve transpilován (přizpůsoben) na sadu Gate a konektivitu Qubitů daného zařízení.\n"

#. type: Title ##
#, no-wrap
msgid "Option 3: Real quantum hardware {#option-3-real-quantum-hardware}"
msgstr "Možnost 3: Skutečný kvantový hardware {#option-3-real-quantum-hardware}"

#. type: Plain text
#, no-wrap
msgid "Requires a free IBM Quantum account. To set one up:\n"
msgstr "Vyžaduje bezplatný IBM Quantum účet. Jak si ho vytvořit:\n"

#. type: Bullet: '1. '
#, no-wrap
msgid "Register at [quantum.cloud.ibm.com/registration](https://quantum.cloud.ibm.com/registration) — no credit card required for the first 30 days\n"
msgstr "Zaregistruj se na [quantum.cloud.ibm.com/registration](https://quantum.cloud.ibm.com/registration) — pro prvních 30 dní není vyžadována platební karta\n"

#. type: Bullet: '2. '
#, no-wrap
msgid "Sign in at [quantum.cloud.ibm.com](https://quantum.cloud.ibm.com) and select region **us-east** (required for the free Open Plan)\n"
msgstr "Přihlas se na [quantum.cloud.ibm.com](https://quantum.cloud.ibm.com) a vyber region **us-east** (povinné pro bezplatný Open Plan)\n"

#. type: Bullet: '3. '
#, no-wrap
msgid "Create an instance (free Open Plan) at [Instances](https://quantum.cloud.ibm.com/instances) if you don't have one yet\n"
msgstr "Na stránce [Instances](https://quantum.cloud.ibm.com/instances) vytvoř instanci (bezplatný Open Plan), pokud ještě žádnou nemáš\n"

#. type: Bullet: '4. '
#, no-wrap
msgid "Create an API key at [quantum.cloud.ibm.com](https://quantum.cloud.ibm.com) (or at [cloud.ibm.com/iam/apikeys](https://cloud.ibm.com/iam/apikeys))\n"
msgstr "Na [quantum.cloud.ibm.com](https://quantum.cloud.ibm.com) (nebo na [cloud.ibm.com/iam/apikeys](https://cloud.ibm.com/iam/apikeys)) vytvoř API klíč\n"

#. type: Bullet: '5. '
#, no-wrap
msgid "Copy your **CRN** (Cloud Resource Name) from your [Instances](https://quantum.cloud.ibm.com/instances) page\n"
msgstr "Zkopíruj svůj **CRN** (Cloud Resource Name) ze stránky [Instances](https://quantum.cloud.ibm.com/instances)\n"

#. type: Plain text
#, no-wrap
msgid "Then, if you haven't saved your credentials yet in this Binder session, run the cell below. Replace `<your-api-key>` with the API key from step 4, and `<your-crn>` with the CRN from step 5.\n"
msgstr "Poté, pokud jsi své přihlašovací údaje v této Binder relaci ještě neuložil, spusť níže uvedenou buňku. Nahraď `<your-api-key>` API klíčem z kroku 4 a `<your-crn>` hodnotou CRN z kroku 5.\n"

#. type: Plain text
#, no-wrap
msgid "**Note:** Jobs on real hardware may take some time depending on queue times. If the cell is still running, you can check your job status and see the results at [quantum.cloud.ibm.com/workloads](https://quantum.cloud.ibm.com/workloads?user=me).\n"
msgstr "**Poznámka:** Úlohy na skutečném hardwaru mohou trvat určitou dobu v závislosti na čekacích dobách fronty. Pokud buňka stále běží, můžeš zkontrolovat stav své úlohy a zobrazit výsledky na [quantum.cloud.ibm.com/workloads](https://quantum.cloud.ibm.com/workloads?user=me).\n"

#. type: Title ##
#, no-wrap
msgid "What next? {#what-next}"
msgstr "Co dál? {#what-next}"

