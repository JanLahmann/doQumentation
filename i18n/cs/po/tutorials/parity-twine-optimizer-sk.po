#, no-wrap
msgid "`metadata` gives information on the transpilation (two qubit gates counts/depth, gates used, active qubits) and various runtimes.\n"
msgstr "`metadata` poskytuje informace o transpilaci (počty/hloubka dvouqubitových hradel, použitá hradla, aktivní qubity) a různé časy běhu.\n"

