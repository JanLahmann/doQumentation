# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Select the option that best completes the statement. As described in this module, a one-time pad is a set of encryption/decryption keys that is used...\n"
msgstr "Vyber možnost, která nejlépe doplní tvrzení. Jak je popsáno v tomto modulu, jednorázový blok je sada šifrovacích/dešifrovacích klíčů, která se používá...\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
#, no-wrap
msgid "a. Only once for a single piece of information, like a single letter.\n"
msgstr "a. Pouze jednou pro jednu jednotku informace, například jedno písmeno.\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
#, no-wrap
msgid "b. Only once for a single message.\n"
