# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "T/F In quantum key distribution, the two communicating partners measure each qubit in the same basis.\n"
msgstr "P/N Při kvantové distribuci klíčů oba komunikující partneři měří každý qubit ve stejné bázi.\n"

# doq-bootstrap: positional
#. type: Bullet: '2. '
#, no-wrap
msgid "T/F An eavesdropper intercepting quantum information in QKD is prevented by the laws of nature from copying the quantum state they intercept.\n"
msgstr "P/N Odposlouchávač zachycující kvantové informace v QKD je zákony přírody znemožněno zkopírovat zachycený kvantový stav.\n"

# doq-bootstrap: positional
#. type: Bullet: '3. '
#, no-wrap
msgid "T/F A one-time pad is a key for encrypting/decrypting secure messages in which a particular encoding scheme is used only once, for a single piece of information (like one letter of the alphabet).\n"
msgstr "P/N Jednorázový blok je klíč pro šifrování/dešifrování bezpečných zpráv, v němž je konkrétní schéma kódování použito pouze jednou, pro jednu jednotku informace (např. jedno písmeno abecedy).\n"

# doq-bootstrap: positional
#. type: Title ###
#, no-wrap
