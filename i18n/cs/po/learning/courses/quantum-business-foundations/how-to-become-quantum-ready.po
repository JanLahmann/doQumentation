#. type: Plain text
#, no-wrap
msgid "<AccordionItem title=\"**Operations**\">\n"
msgstr ""

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"<ul>\n"
"<li>– Governance and oversight to ensure the successful execution of the quantum roadmap.</li>\n"
"<li>– Talent strategy and culture to build a high-performing team with quantum fluency.</li>\n"
"<li>– Innovation process that creates quantum-enabled solutions that meet business needs.</li>\n"
"<li>– Agile practices that result in high velocity of R & D and iterative solution design.</li>\n"
"</ul>\n"
msgstr ""
"<ul>\n"
"<li>– Správa a dohled k zajištění úspěšného provádění kvantového plánu.</li>\n"
"<li>– Strategie talentů a kultura pro budování vysoce výkonného týmu s kvantovou plynností.</li>\n"
"<li>– Inovační proces, který vytváří kvantová řešení odpovídající obchodním potřebám.</li>\n"
"<li>– Agilní postupy vedoucí k vysoké rychlosti výzkumu a vývoje (R&D) a iterativnímu návrhu řešení.</li>\n"
"</ul>\n"

# doq-bootstrap: dropped, JSX/HTML tags differ from English: </AccordionItem>
# </Accordion>
#. type: Plain text
