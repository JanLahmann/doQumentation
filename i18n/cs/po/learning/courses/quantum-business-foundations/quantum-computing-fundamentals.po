# doq-bootstrap: positional
#. type: Title ##
#, no-wrap
msgid "Key takeaways {#key-takeaways}"
msgstr "Klíčové poznatky {#key-takeaways}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "You can keep these key takeaways in mind:\n"
msgstr "Zapamatuj si tato klíčová zjištění:\n"

# doq-bootstrap: positional
#. type: Bullet: '*   '
#, no-wrap
msgid "There are still intractable computational problems that classical computers cannot solve.\n"
msgstr "Stále existují neřešitelné výpočetní problémy, které klasické počítače nedokážou vyřešit.\n"

# doq-bootstrap: positional
#. type: Bullet: '*   '
#, no-wrap
msgid "Quantum computers expand what is possible to design into algorithms.\n"
msgstr "Kvantové počítače rozšiřují to, co je možné navrhnout do algoritmů.\n"

# doq-bootstrap: positional
#. type: Bullet: '*   '
#, no-wrap
msgid "The qubit is the basic quantum unit of information.\n"
msgstr "qubit je základní kvantová jednotka informace.\n"

# doq-bootstrap: positional
#. type: Bullet: '*   '
#, no-wrap
msgid "A quantum superposition can have exponentially more states than a classical superposition.\n"
msgstr "Kvantová superpozice může mít exponenciálně více stavů než klasická superpozice.\n"

# doq-bootstrap: positional
#. type: Bullet: '*   '
#, no-wrap
msgid "Quantum superposition is more powerful than classical probabilism but weaker than exponential parallelism.\n"
msgstr "Kvantová superpozice je výkonnější než klasický probabilismus, ale slabší než exponenciální paralelismus.\n"

# doq-bootstrap: positional
#. type: Bullet: '*   '
#, no-wrap
msgid "In an entangled state, the whole system is in a definite state even though the parts are not.\n"
msgstr "V provázaném stavu je celý systém v určitém stavu, i když jeho části nikoli.\n"
