# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"$$\n"
"  \\biggl\\|\n"
"    -\\frac{1}{\\sqrt{6}} \\vert 0 \\rangle\n"
"    +\\frac{1}{\\sqrt{6}} \\vert 1\\rangle\n"
"  \\biggr\\|^2\n"
"  = \\frac{1}{6} + \\frac{1}{6} = \\frac{1}{3},\n"
"$$\n"
msgstr ""
"$$\n"
"\\frac{\n"
"  -\\frac{1}{\\sqrt{6}} \\vert 0 \\rangle\n"
