# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"$$\n"
"  \\vert \\psi \\rangle\n"
"  = \\biggl(\n"
"    \\frac{1}{\\sqrt{2}} \\vert 0 \\rangle\n"
