#, no-wrap
msgid "Solve a utility-scale example of the max-cut problem, a famous problem in graph theory."
msgstr "Vyřeš příklad Max-Cut ve velkém měřítku – slavný problém z teorie grafů."

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Utility-scale QAOA"
msgstr "QAOA ve velkém měřítku"

#. type: Plain text
#, no-wrap
msgid "{/* cspell:ignore Longleftrightarrow ZIZII */}\n"
msgstr "{/* cspell:ignore Longleftrightarrow ZIZII */}\n"

# doq: mechanical transfer from the previous translation
#. type: Plain text
#, no-wrap
msgid "Watch the video on utility-scale QAOA from Olivia Lanes, or open the video in a separate window on [YouTube](https://youtube.com/watch?v=P3s7TIMIvZ0).\n"
msgstr "Podívej se na video o QAOA ve velkém měřítku od Olivie Lanes, nebo ho otevři v samostatném okně na [YouTube.](https://youtube.com/watch?v=P3s7TIMIvZ0)\n"

#. type: Plain text
#, no-wrap
msgid "<IBMVideo id=\"134063421\" title=\"In this video, Olivia Lanes walks through a utility scale calculation on a quantum computer. The calculation involves the max-cut problem and uses the approach of QAOA.\"/>\n"
