#, no-wrap
msgid ""
"This lesson gives an overview of programming models for distributing tasks "
"optimally between resources."
msgstr ""
"Tato lekce poskytuje přehled programovacích modelů pro optimální distribuci "
"úloh mezi zdroji."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Programming models"
msgstr "Programovací modely"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
