# doq: translated after an English change 2026-09-24
#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "We explore various types of quantum noise and errors, what causes them, and how to model them."
msgstr "Prozkoumáme různé typy kvantového šumu a chyb, jejich příčiny a způsoby jejich modelování."

# doq: translated after an English change 2026-09-24
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Noise and errors"
msgstr "Šum a chyby"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"learning/courses/tools-for-quantum-advantage/noise-and-errors.ipynb\" />\n"
msgstr ""

