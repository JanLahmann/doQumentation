#. type: Bullet: '2. '
#, no-wrap
msgid "Go to the [Google Colab landing page](https://colab.research.google.com/) and sign in with your Google account.\n"
msgstr "Přejdi na [úvodní stránku Google Colab](https://colab.research.google.com/) a přihlas se pomocí svého Google účtu.\n"

#. type: Bullet: '3. '
