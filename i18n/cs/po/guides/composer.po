# doq-bootstrap: positional
#. type: Title ###
#, no-wrap
msgid "Hadamard gate {#hadamard-gate}"
msgstr "Hadamardova brána {#hadamard-gate}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "**H gate**\n"
msgstr "**Hradlo H**\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "The H, or Hadamard, gate rotates the states $\\left|0\\right\\rangle$ and $\\left|1\\right\\rangle$ to $\\left|+\\right\\rangle$ and $\\left|-\\right\\rangle$, respectively. It is useful for making superpositions. If you have a universal gate set on a classical computer and add the Hadamard gate, it becomes a universal gate set on a quantum computer.\n"
msgstr "Hradlo H, neboli Hadamardova brána, otočí stavy $\\left|0\\right\\rangle$ a $\\left|1\\right\\rangle$ do stavů $\\left|+\\right\\rangle$ a $\\left|-\\right\\rangle$. Je užitečná pro vytváření superpozic. Pokud máš na klasickém počítači univerzální sadu hradel a přidáš Hadamardovu bránu, stane se z ní univerzální sada hradel pro kvantový počítač.\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
