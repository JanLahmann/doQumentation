#. type: Plain text
#, no-wrap
msgid "**Reset operation**\n"
msgstr "**Operace reset**\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "The reset operation returns a qubit to state $\\left|0\\right\\rangle$, irrespective of its state before the operation was applied. It is not a reversible operation.\n"
msgstr "Operace reset vrátí qubit do stavu $\\left|0\\right\\rangle$ bez ohledu na jeho stav před aplikací operace. Není to reverzibilní operace.\n"

