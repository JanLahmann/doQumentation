# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "**Toffoli gate**\n"
msgstr "**Hradlo Toffoli**\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "The Toffoli gate, also known as the double controlled-NOT gate (CCX), has two control qubits and one target. It applies a NOT to the target only when both controls are in state $\\left|1\\right\\rangle$.\n"
msgstr "Hradlo Toffoli, také známé jako hradlo dvojitě řízené-NOT (CCX), má dva řídící qubit a jeden cílový. Operaci NOT na cílovém qubit provede pouze tehdy, jsou-li oba řídící qubit ve stavu $\\left|1\\right\\rangle$.\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "The Toffoli gate with the Hadamard gate is a universal gate set for quantum computing.\n"
msgstr "Hradlo Toffoli spolu s Hadamardovou bránou tvoří univerzální sadu bran pro kvantové výpočty.\n"

