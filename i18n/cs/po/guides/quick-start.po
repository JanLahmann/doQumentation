# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "This result is a signature of quantum entanglement.\n"
msgstr "Tento výsledek je projevem kvantového entanglementu.\n"

# doq-bootstrap: positional
