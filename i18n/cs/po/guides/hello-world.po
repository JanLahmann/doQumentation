# doq-bootstrap: positional
#. type: Bullet: '1.  '
#, no-wrap
msgid "Map the problem to a quantum-native format.\n"
msgstr "Namapuj problém do kvantového nativního formátu.\n"

# doq-bootstrap: positional
#. type: Bullet: '2.  '
