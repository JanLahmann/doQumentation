msgid "Write, upload, and run your first managed workflow, then get its results."
msgstr "Napiš, nahraj a spusť svůj první managed workflow a poté získej jeho výsledky."

# doq: translated after an English change 2026-11-12
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Deploy your first managed workflow"
msgstr "Nasazení tvého prvního managed workflow"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"guides/deploy-first-managed-workflow.ipynb\" />\n"
msgstr ""

