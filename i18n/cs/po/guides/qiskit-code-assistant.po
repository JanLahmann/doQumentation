# doq-bootstrap: positional
#. type: Title ##
#, no-wrap
msgid "Install Qiskit Code Assistant {#install-qiskit-code-assistant}"
msgstr "Instalace Qiskit Code Assistantu {#install-qiskit-code-assistant}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "Learn how to install, configure, and use any of Qiskit Code Assistant models on your local machine.\n"
msgstr "Zjisti, jak nainstalovat, nakonfigurovat a používat libovolný model Qiskit Code Assistantu na svém lokálním počítači.\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"<Accordion>\n"
"<AccordionItem title=\"Download from the Hugging Face website\">\n"
msgstr ""
"<Accordion>\n"
"<AccordionItem title=\"Stáhnout z webu Hugging Face\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "Follow these steps to download any Qiskit Code Assistant-related model from the Hugging Face website:\n"
msgstr "Pro stažení libovolného modelu souvisejícího s Qiskit Code Assistantem z webu Hugging Face postupuj takto:\n"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Navigate to the desired Qiskit model page on Hugging Face.\n"
msgstr "Přejdi na stránku požadovaného modelu Qiskit na Hugging Face.\n"

# doq-bootstrap: positional
#. type: Bullet: '2. '
#, no-wrap
msgid "Go to the **Files and Versions** tab and download the safetensors or GGUF model files.\n"
msgstr "Přejdi na záložku **Files and Versions** a stáhni soubory modelu ve formátu safetensors nebo GGUF.\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "</AccordionItem>\n"
msgstr "</AccordionItem>\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "<AccordionItem title=\"Download using the Hugging Face CLI\">\n"
msgstr "<AccordionItem title=\"Stáhnout pomocí Hugging Face CLI\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "To download any of the available Qiskit Code Assistant models using the Hugging Face CLI, follow these steps:\n"
msgstr "Pro stažení libovolného z dostupných modelů Qiskit Code Assistantu pomocí Hugging Face CLI postupuj takto:\n"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Install the [Hugging Face CLI](https://huggingface.co/docs/huggingface_hub/main/en/guides/cli)\n"
msgstr "Nainstaluj [Hugging Face CLI](https://huggingface.co/docs/huggingface_hub/main/en/guides/cli)\n"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Log in to your Hugging Face account\n"
msgstr "Přihlas se ke svému účtu Hugging Face\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    ```\n"
"    huggingface-cli login\n"
"    ```\n"
msgstr ""
"    ```\n"
"    huggingface-cli login\n"
"    ```\n"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Download the model you prefer from the previous list\n"
msgstr "Stáhni model, který preferuješ, ze seznamu výše\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    ```\n"
"    huggingface-cli download <HF REPO NAME> <MODEL PATH> --local-dir <LOCAL PATH>\n"
"    ```\n"
msgstr ""
"    ```\n"
"    huggingface-cli download <HF REPO NAME> <MODEL PATH> --local-dir <LOCAL PATH>\n"
"    ```\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "<AccordionItem title=\"Manually deploy the Qiskit Code Assistant models in local through Ollama\">\n"
msgstr "<AccordionItem title=\"Ruční nasazení modelů Qiskit Code Assistantu lokálně přes Ollama\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "There are multiple ways to deploy and interact with the downloaded Qiskit Code Assistant model. This guide demonstrates using [Ollama](https://ollama.com) as follows: either with the [Ollama application](#using-the-ollama-application) by using the Hugging Face Hub integration or local model, or with the [`llama-cpp-python` package](#use-llama-cpp-python).\n"
msgstr "Existuje několik způsobů, jak nasadit a pracovat se staženým modelem Qiskit Code Assistantu. Tato příručka demonstruje použití [Ollama](https://ollama.com) takto: buď pomocí [aplikace Ollama](#using-the-ollama-application) s využitím integrace Hugging Face Hub nebo lokálního modelu, nebo pomocí [balíčku `llama-cpp-python`](#use-llama-cpp-python).\n"

# doq-bootstrap: positional
#. type: Title ####
#, no-wrap
msgid "Using the Ollama application {#using-the-ollama-application}"
msgstr "Použití aplikace Ollama {#using-the-ollama-application}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "The Ollama application provides a simple solution to run the LLMs locally. It is easy to use, with a CLI that makes the whole setup process, model management, and interaction fairly straightforward. It’s ideal for quick experimentation and for users that want fewer technical details to handle.\n"
msgstr "Aplikace Ollama poskytuje jednoduché řešení pro lokální spouštění LLM. Je snadná na použití, s CLI, které celý proces nastavení, správu modelů a interakci s nimi činí poměrně přímočarými. Je ideální pro rychlé experimentování a pro uživatele, kteří chtějí mít méně technických detailů na starosti.\n"

# doq-bootstrap: positional
#. type: Title #####
#, no-wrap
msgid "Install Ollama {#install-ollama}"
msgstr "Instalace Ollamy {#install-ollama}"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Download the [Ollama application](https://ollama.com/download)\n"
msgstr "Stáhni [aplikaci Ollama](https://ollama.com/download)\n"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Install the downloaded file\n"
msgstr "Nainstaluj stažený soubor\n"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Launch the installed Ollama application\n"
msgstr "Spusť nainstalovanou aplikaci Ollama\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    <Admonition type=\"info\">\n"
"        The application is running successfully when the Ollama icon appears in the desktop menu bar. You can also verify the service is running by going to `http://localhost:11434/`.\n"
"    </Admonition>\n"
msgstr ""
"    <Admonition type=\"info\">\n"
"        Aplikace běží úspěšně, když se ikona Ollamy zobrazí v pruhu nabídek plochy. Funkčnost služby můžeš také ověřit přechodem na `http://localhost:11434/`.\n"
"    </Admonition>\n"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Try Ollama in your terminal and start running models. For example:\n"
msgstr "Vyzkoušej Ollamu v terminálu a začni spouštět modely. Například:\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    ```\n"
"    ollama run hf.co/Qiskit/Qwen2.5-Coder-14B-Qiskit\n"
"    ```\n"
msgstr ""
"    ```\n"
"    ollama run hf.co/Qiskit/Qwen2.5-Coder-14B-Qiskit\n"
"    ```\n"

# doq-bootstrap: positional
#. type: Title #####
#, no-wrap
msgid "Set up Ollama using the Hugging Face Hub integration {#set-up-ollama-using-the-hugging-face-hub-integration}"
msgstr "Nastavení Ollamy pomocí integrace Hugging Face Hub {#set-up-ollama-using-the-hugging-face-hub-integration}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "The [Ollama/Hugging Face Hub integration](https://huggingface.co/docs/hub/ollama) provides a way to interact with models hosted on the Hugging Face Hub without needing to create a new modelfile nor manually downloading the GGUF or safetensors files. The default `template` and `params` files are already included for the model on the Hugging Face Hub.\n"
msgstr "[Integrace Ollama/Hugging Face Hub](https://huggingface.co/docs/hub/ollama) poskytuje způsob, jak pracovat s modely hostovanými na Hugging Face Hub, aniž by bylo nutné vytvářet nový modelfile nebo ručně stahovat soubory GGUF či safetensors. Výchozí soubory `template` a `params` jsou pro model na Hugging Face Hub již zahrnuty.\n"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Make sure the Ollama application is running.\n"
msgstr "Ujisti se, že aplikace Ollama běží.\n"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Go the desired model page, and copy the URL. For example, https://huggingface.co/Qiskit/Qwen2.5-Coder-14B-Qiskit-GGUF.\n"
msgstr "Přejdi na stránku požadovaného modelu a zkopíruj URL. Například https://huggingface.co/Qiskit/Qwen2.5-Coder-14B-Qiskit-GGUF.\n"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "From your terminal, run the command:\n"
msgstr "V terminálu spusť příkaz:\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "You can use the `hf.co/Qiskit/Qwen2.5-Coder-14B-Qiskit` model or any of the other currently recommended GGUF official models `hf.co/Qiskit/mistral-small-3.2-24b-qiskit-GGUF` or `hf.co/Qiskit/granite-3.3-8b-qiskit-GGUF`.\n"
msgstr "Můžeš použít model `hf.co/Qiskit/Qwen2.5-Coder-14B-Qiskit` nebo kterýkoli z dalších aktuálně doporučených oficiálních modelů GGUF `hf.co/Qiskit/mistral-small-3.2-24b-qiskit-GGUF` nebo `hf.co/Qiskit/granite-3.3-8b-qiskit-GGUF`.\n"

# doq-bootstrap: positional
#. type: Title #####
#, no-wrap
msgid "Set up Ollama with a manually downloaded Qiskit Code Assistant GGUF model {#set-up-ollama-with-a-manually-downloaded-qiskit-code-assistant-gguf-model}"
msgstr "Nastavení Ollamy s ručně staženým modelem GGUF Qiskit Code Assistantu {#set-up-ollama-with-a-manually-downloaded-qiskit-code-assistant-gguf-model}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "If you have manually downloaded a GGUF model such as https://huggingface.co/Qiskit/Qwen2.5-Coder-14B-Qiskit-GGUF and you want to experiment with different templates and parameters, you can follow these steps to load it into your local Ollama application.\n"
msgstr "Pokud jsi ručně stáhl model GGUF, například https://huggingface.co/Qiskit/Qwen2.5-Coder-14B-Qiskit-GGUF, a chceš experimentovat s různými šablonami a parametry, můžeš jej načíst do lokální aplikace Ollama podle těchto kroků.\n"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Create a `Modelfile` entering the following content and be sure to update `<PATH-TO-GGUF-FILE>` to the actual path of your downloaded model.\n"
msgstr "Vytvoř soubor `Modelfile` s následujícím obsahem a nezapomeň aktualizovat `<PATH-TO-GGUF-FILE>` na skutečnou cestu ke staženému modelu.\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    ```\n"
"    FROM <PATH-TO-GGUF-FILE>\n"
"    TEMPLATE \"\"\"{{ if .System }}\n"
"    System:\n"
"    {{ .System }}\n"
msgstr ""
"    ```\n"
"    FROM <PATH-TO-GGUF-FILE>\n"
"    TEMPLATE \"\"\"{{ if .System }}\n"
"    System:\n"
"    {{ .System }}\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    {{ end }}{{ if .Prompt }}Question:\n"
"    {{ .Prompt }}\n"
msgstr ""
"    {{ end }}{{ if .Prompt }}Question:\n"
"    {{ .Prompt }}\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    {{ end }}Answer:\n"
"    ```\n"
"    \"\"\"\n"
msgstr ""
"    {{ end }}Answer:\n"
"    ```\n"
"    \"\"\"\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    PARAMETER stop \"Question:\"\n"
"    PARAMETER stop \"Answer:\"\n"
"    PARAMETER stop \"System:\"\n"
"    PARAMETER stop \"```\"\n"
msgstr ""
"    PARAMETER stop \"Question:\"\n"
"    PARAMETER stop \"Answer:\"\n"
"    PARAMETER stop \"System:\"\n"
"    PARAMETER stop \"```\"\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    PARAMETER temperature 0\n"
"    PARAMETER top_k 1\n"
msgstr ""
"    PARAMETER temperature 0\n"
"    PARAMETER top_k 1\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "    ```\n"
msgstr "    ```\n"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Run the following command to create a custom model instance based on the `Modelfile`.\n"
msgstr "Spusť následující příkaz pro vytvoření vlastní instance modelu na základě souboru `Modelfile`.\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    ```\n"
"    ollama create Qwen2.5-Coder-14B-Qiskit -f ./path-to-model-file\n"
msgstr ""
"    ```\n"
"    ollama create Qwen2.5-Coder-14B-Qiskit -f ./path-to-model-file\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"    <Admonition type=\"note\">\n"
"        This process may take some time for Ollama to read the model file, initialize the model instance, and configure it according to the specifications provided.\n"
"    </Admonition>\n"
msgstr ""
"    <Admonition type=\"note\">\n"
"        Tento proces může chvíli trvat, než Ollama přečte soubor modelu, inicializuje instanci modelu a nakonfiguruje ji podle zadaných specifikací.\n"
"    </Admonition>\n"

# doq-bootstrap: positional
