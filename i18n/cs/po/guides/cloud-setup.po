msgid ""
"Setup instructions for IBM Quantum on IBM Cloud to submit Qiskit SDK and "
"Qiskit Runtime jobs for users without email invitations"
msgstr ""
"Pokyny k nastavení IBM Quantum na IBM Cloud pro odesílání úloh Qiskit SDK a "
"Qiskit Runtime pro uživatele bez e-mailové pozvánky"

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Set up your IBM Cloud account"
msgstr "Nastavení účtu IBM Cloud"

# doq-bootstrap: positional
#. type: Plain text
