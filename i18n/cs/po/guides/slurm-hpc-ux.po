# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "There is no specific setup required from HPC admins for PCS usage.\n"
msgstr "Pro využívání PCS není ze strany HPC adminů vyžadováno žádné specifické nastavení.\n"

# doq-bootstrap: positional
