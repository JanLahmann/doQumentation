# doq-bootstrap: positional
#. type: Title ##
#, no-wrap
msgid "Why do I see a message that my account is inactive when I try to log on? {#why-do-i-see-a-message-that-my-account-is-inactive-when-i-try-to-log-on}"
msgstr "Proč mi při přihlašování zobrazí zpráva, že můj účet je neaktivní? {#why-do-i-see-a-message-that-my-account-is-inactive-when-i-try-to-log-on}"

# doq-bootstrap: positional
