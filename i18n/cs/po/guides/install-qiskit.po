msgstr ""
"Linux s390x (distribuce kompatibilní se specifikací balíčků [manylinux "
"2014](https://www.python.org/dev/peps/pep-0599/))\n"

#. type: Bullet: '  - '
#, markdown-text, no-wrap
msgid ""
"Linux i686 (distributions compatible with the [manylinux "
"2014](https://www.python.org/dev/peps/pep-0599/) packaging specification)\n"
msgstr ""
"Linux i686 (distribuce kompatibilní se specifikací balíčků [manylinux "
"2014](https://www.python.org/dev/peps/pep-0599/))\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"  - Windows 10 32-bit\n"
"</AccordionItem>\n"
"</Accordion>\n"
msgstr ""
"  - Windows 10 32-bit\n"
