#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Learn how to install the development version of Qiskit."
msgstr "Aprende cómo instalar la versión de desarrollo de Qiskit."

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Install the Qiskit SDK from source"
msgstr "Instalar el SDK de Qiskit desde el código fuente"

#. type: Plain text
#, no-wrap
msgid "{/* cspell:ignore rustup */}\n"
msgstr "{/* cspell:ignore rustup */}\n"

#. type: Title #
#, no-wrap
msgid "Install the Qiskit SDK from source {#install-the-qiskit-sdk-from-source}"
msgstr "Instalar el SDK de Qiskit desde el código fuente {#install-the-qiskit-sdk-from-source}"

#. type: Plain text
#, no-wrap
msgid "When you install the Qiskit SDK from source, you can access the current development version, instead of using the version in the Python Package Index (PyPI) repository. You can therefore inspect and extend the latest version of the Qiskit code more efficiently.\n"
msgstr "Cuando instalas el SDK de Qiskit desde el código fuente, puedes acceder a la versión de desarrollo actual, en lugar de usar la versión disponible en el repositorio del Python Package Index (PyPI). Por lo tanto, puedes inspeccionar y ampliar la última versión del código de Qiskit de forma más eficiente.\n"

#. type: Title ##
#, no-wrap
msgid "Create and activate a new virtual environment {#create-and-activate-a-new-virtual-environment}"
msgstr "Crear y activar un nuevo entorno virtual {#create-and-activate-a-new-virtual-environment}"

#. type: Bullet: '1. '
#, no-wrap
msgid "Navigate to your project directory and create a minimal environment with only Python installed in it.\n"
msgstr "Navega al directorio de tu proyecto y crea un entorno mínimo con solo Python instalado.\n"

#. type: Plain text
#, no-wrap
msgid ""
"        <OperatingSystemTabs>\n"
"          <TabItem value=\"mac\" label=\"macOS\">\n"
msgstr ""
"        <OperatingSystemTabs>\n"
"          <TabItem value=\"mac\" label=\"macOS\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"            ```shell\n"
"            python3 -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
msgstr ""
"            ```shell\n"
"            python3 -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"

#. type: Plain text
#, no-wrap
msgid "          <TabItem value=\"linux\" label=\"Linux\">\n"
msgstr "          <TabItem value=\"linux\" label=\"Linux\">\n"

#. type: Plain text
#, no-wrap
msgid "          <TabItem value=\"win\" label=\"Windows\">\n"
msgstr "          <TabItem value=\"win\" label=\"Windows\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"            ```text\n"
"            python -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
"         </OperatingSystemTabs>\n"
msgstr ""
"            ```text\n"
"            python -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
"         </OperatingSystemTabs>\n"

#. type: Bullet: '1. '
#, no-wrap
msgid "Activate your new environment.\n"
msgstr "Activa tu nuevo entorno.\n"

#. type: Plain text
#, no-wrap
msgid ""
"         <OperatingSystemTabs>\n"
"           <TabItem value=\"mac\" label=\"macOS\">\n"
msgstr ""
"         <OperatingSystemTabs>\n"
"           <TabItem value=\"mac\" label=\"macOS\">\n"

