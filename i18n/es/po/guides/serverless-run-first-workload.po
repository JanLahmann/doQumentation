#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "How to list programs available in Serverless, pass inputs into these programs, run them remotely, check status, and retrieve results and logs."
msgstr "Cómo listar los programas disponibles en Serverless, pasar entradas a esos programas, ejecutarlos de forma remota, verificar el estado y recuperar resultados y registros."

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Run your first Qiskit Serverless workload remotely"
msgstr "Ejecuta tu primera carga de trabajo de Qiskit Serverless de forma remota"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"guides/serverless-run-first-workload.ipynb\" />\n"
msgstr "<OpenInLabBanner notebookPath=\"guides/serverless-run-first-workload.ipynb\" />\n"

#. type: Plain text
#, no-wrap
msgid ""
"<Accordion>\n"
"<AccordionItem title=\"Package versions\">\n"
msgstr ""
