# doq: translated after an English change 2026-11-19
#. type: Title ##
#, no-wrap
msgid "Next steps {#next-steps}"
msgstr "Próximos pasos {#next-steps}"

# doq: translated after an English change 2026-11-19
#. type: Plain text
#, no-wrap
msgid "<Admonition type=\"tip\" title=\"Recommendations\">\n"
msgstr "<Admonition type=\"tip\" title=\"Recomendaciones\">\n"

# doq: translated after an English change 2026-11-19
#. type: Bullet: '- '
#, no-wrap
msgid ""
"Read [Size the SQD diagonalization for your HPC resources](https://qiskit-community.github.io/qcsc-prefect/tutorials/configure_sqd_solver_resources/)\n"
"to choose the nodes, ranks, and threads of the solver jobs.\n"
msgstr ""
"Lee [Size the SQD diagonalization for your HPC resources](https://qiskit-community.github.io/qcsc-prefect/tutorials/configure_sqd_solver_resources/)\n"
"para elegir los nodos, rangos e hilos de los trabajos del solver.\n"

# doq: translated after an English change 2026-11-19
#. type: Bullet: '- '
#, no-wrap
msgid ""
"Read the [SQD workflow README](https://github.com/qiskit-community/qcsc-prefect/tree/main/algorithms/open_loop/sqd)\n"
"for the configuration file, the solvers, and the run parameters.\n"
msgstr ""
