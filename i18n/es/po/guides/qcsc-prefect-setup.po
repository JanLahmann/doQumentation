# doq: translated after an English change 2026-11-19
#. type: Bullet: '  - '
#, no-wrap
msgid "[SPANK plugin for QRMI](/guides/slurm-plugin)\n"
msgstr "[Plugin SPANK para QRMI](/guides/slurm-plugin)\n"

# doq: translated after an English change 2026-11-19
#. type: Bullet: '  - '
#, no-wrap
