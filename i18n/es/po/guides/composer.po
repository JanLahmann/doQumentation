msgid "**RZ gate**\n"
msgstr "**Puerta RZ**\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"The RZ gate implements $exp(-i\\frac{\\theta}{2}Z)$. On the Bloch sphere, "
"this gate corresponds to rotating the qubit state around the z axis by the "
"given angle.\n"
msgstr ""
"La puerta RZ implementa $exp(-i\\frac{\\theta}{2}Z)$. En la esfera de Bloch,"
" esta puerta corresponde a rotar el estado del qubit alrededor del eje z por"
" el ángulo dado.\n"

