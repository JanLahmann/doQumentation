# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "**Identity gate**\n"
msgstr "**Puerta de identidad**\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"The identity gate (sometimes called the Id or the I gate) is actually the "
"absence of a gate. It ensures that nothing is applied to a qubit for one "
"unit of gate time.\n"
msgstr ""
"La puerta de identidad (a veces llamada puerta Id o I) es en realidad la "
"ausencia de una puerta. Asegura que nada se aplique a un qubit durante una "
"unidad de tiempo de puerta.\n"

