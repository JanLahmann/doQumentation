msgid "**RC3X gate**\n"
msgstr "**Puerta RC3X**\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "The simplified 3-controlled Toffoli gate.\n"
msgstr "La puerta Toffoli de 3 controles simplificada.\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"The simplified Toffoli gate implements the Toffoli gate up to relative "
"phases. Note that the simplified Toffoli is not equivalent to the Toffoli, "
"but can be used in places where the Toffoli gate is uncomputed again.\n"
msgstr ""
"La puerta Toffoli simplificada implementa la puerta Toffoli salvo fases "
"relativas. Ten en cuenta que el Toffoli simplificado no es equivalente al "
"Toffoli, pero se puede usar en lugares donde la puerta Toffoli se descomputa"
" nuevamente.\n"

