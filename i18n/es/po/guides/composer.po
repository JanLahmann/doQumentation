# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "**Reset operation**\n"
msgstr "**Operación de reinicio**\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"The reset operation returns a qubit to state $\\left|0\\right\\rangle$, "
"irrespective of its state before the operation was applied. It is not a "
"reversible operation.\n"
msgstr ""
"La operación de reinicio devuelve un qubit al estado "
"$\\left|0\\right\\rangle$, independientemente de su estado antes de que se "
"aplicara la operación. No es una operación reversible.\n"

