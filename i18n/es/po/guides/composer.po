# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "**Measurement**\n"
msgstr "**Medición**\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"Measurement in the standard basis, also known as the z basis or "
"computational basis. Can be used to implement any kind of measurement when "
"combined with gates. It is not a reversible operation.\n"
msgstr ""
"Medición en la base estándar, también conocida como la base z o base "
"computacional. Se puede usar para implementar cualquier tipo de medición "
"cuando se combina con puertas. No es una operación reversible.\n"

