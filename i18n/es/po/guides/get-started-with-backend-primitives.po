#, no-wrap
msgid "Example: {#example}"
msgstr "Ejemplo: {#example}"

#. type: Plain text
#, no-wrap
msgid "<span id=\"sampler\"></span>\n"
msgstr "<span id=\"sampler\"></span>\n"

# doq: fixed after review 2026-09-30
#. type: Title ##
#, no-wrap
msgid "Get started with the Sampler backend primitive {#get-started-with-the-sampler-backend-primitive}"
msgstr "Primeros pasos con la primitiva de backend Sampler {#get-started-with-the-sampler-backend-primitive}"

# doq: fixed after review 2026-09-30
#. type: Plain text
#, no-wrap
msgid "The Sampler primitive can be run with any provider by using [`qiskit.primitives.BackendSamplerV2`](https://docs.quantum.ibm.com/api/qiskit/qiskit.primitives.BackendSamplerV2). However, it requires a backend that supports the `memory` option.\n"
msgstr "La primitiva Sampler puede ejecutarse con cualquier proveedor usando [`qiskit.primitives.BackendSamplerV2`](https://docs.quantum.ibm.com/api/qiskit/qiskit.primitives.BackendSamplerV2). Sin embargo, requiere un backend que admita la opción `memory`.\n"

