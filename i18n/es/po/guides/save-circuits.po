msgid "![Output of the previous code cell](/docs/images/guides/save-circuits/extracted-outputs/210d05c8-c9eb-4135-bb3f-94c281708f4b-0.svg)\n"
msgstr "![Salida de la celda de código anterior](/docs/images/guides/save-circuits/extracted-outputs/210d05c8-c9eb-4135-bb3f-94c281708f4b-0.svg)\n"
