#, no-wrap
msgid "<span id=\"samplomatic-tools\"></span>\n"
msgstr "<span id=\"samplomatic-tools\"></span>\n"

#. type: Title ##
#, no-wrap
msgid "Tools for the directed execution model {#tools-for-the-directed-execution-model}"
msgstr "Herramientas para el modelo de ejecución dirigida {#tools-for-the-directed-execution-model}"

#. type: Plain text
#, no-wrap
msgid "The following tools can be used together to implement an error mitigation technique in the directed execution model.\n"
msgstr "Las siguientes herramientas se pueden usar en conjunto para implementar una técnica de mitigación de errores en el modelo de ejecución dirigida.\n"

