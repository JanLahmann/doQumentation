#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "How to use the Estimator primitive in Qiskit Runtime."
msgstr "Cómo usar la primitiva Estimator en Qiskit Runtime."

#. type: Yaml Front Matter Hash Value: sidebar_label
#, no-wrap
msgid "Estimator quickstart"
msgstr "Inicio rápido con Estimator"

#. type: Plain text
#, markdown-text, no-wrap
