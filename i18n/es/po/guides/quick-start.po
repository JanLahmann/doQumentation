msgid ""
"Download Python and use a virtual environment with Qiskit (recommended).\n"
msgstr "Descarga Python y usa un entorno virtual con Qiskit (recomendado).\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"<Accordion>\n"
"<AccordionItem title=\"Click to expand for more information about **Python**.\">\n"
