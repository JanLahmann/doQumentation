# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Zero-noise extrapolation with probabilistic error amplification"
msgstr "Extrapolación a ruido cero con amplificación probabilística de errores"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"addons/qiskit-mitigation/guides/pea-with-noise-learning.ipynb\" />\n"
