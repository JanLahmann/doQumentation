msgid "Circuit to Pauli twirl.\n"
msgstr "Circuito al que aplicar twirling de Pauli.\n"

# doq: translated after an English change 2026-11-13
#. type: Plain text
#, no-wrap
msgid "This is achieved by stratifying the circuit into boxes and adding twirl annotations.\n"
msgstr "Esto se logra estratificando el circuito en boxes y añadiendo anotaciones de twirl.\n"

# doq: copied, nothing translatable
#. type: Plain text
#, no-wrap
