msgid "Classically simulating circuits with OBP for the latest version of Operator backpropagation (OBP)"
msgstr "Simulación clásica de circuitos con OBP para la última versión de la retropropagación de operadores (OBP)"

# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: title
