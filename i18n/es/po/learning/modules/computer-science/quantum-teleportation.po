msgstr "Preguntas de verdadero/falso {#truefalse-questions}"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, markdown-text, no-wrap
msgid ""
"T/F Quantum teleportation can be used to send information faster than "
"light.\n"
msgstr ""
"V/F La teletransportación cuántica puede usarse para enviar información más "
"rápido que la luz.\n"

# doq-bootstrap: positional
