msgid ""
"T/F Modern evidence suggests that the collapse of a quantum state propagates"
" faster than light.\n"
msgstr ""
"V/F La evidencia moderna sugiere que el colapso de un estado cuántico se "
"propaga más rápido que la luz.\n"

# doq-bootstrap: positional
