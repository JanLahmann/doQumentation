#, markdown-text, no-wrap
msgid "True/False: {#truefalse}"
msgstr "Verdadero/Falso: {#truefalse}"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, markdown-text, no-wrap
msgid ""
"T/F The efficiency of Shor's algorithm threatens the security of RSA "
"encryption.\n"
msgstr ""
"V/F La eficiencia del algoritmo de Shor amenaza la seguridad del cifrado "
"RSA.\n"

# doq-bootstrap: positional
#. type: Bullet: '2. '
#, markdown-text, no-wrap
msgid ""
"T/F Shor's algorithm can be executed efficiently on any modern-day quantum "
"computer.\n"
msgstr ""
"V/F El algoritmo de Shor puede ejecutarse eficientemente en cualquier "
"computador cuántico actual.\n"

# doq-bootstrap: positional
#. type: Bullet: '3. '
#, markdown-text, no-wrap
msgid ""
"T/F Shor’s algorithm uses quantum phase estimation (QPE) as a key "
"subroutine.\n"
msgstr ""
"V/F El algoritmo de Shor usa la estimación de fase cuántica (QPE) como "
"subrutina clave.\n"

# doq-bootstrap: positional
#. type: Bullet: '4. '
#, markdown-text, no-wrap
msgid ""
"T/F The classical part of Shor’s algorithm involves calculating the greatest"
" common divisor (GCD).\n"
msgstr ""
"V/F La parte clásica del algoritmo de Shor implica calcular el máximo común "
"divisor (MCD).\n"

# doq-bootstrap: positional
#. type: Bullet: '5. '
#, markdown-text, no-wrap
msgid "T/F Shor’s algorithm only works for factoring even numbers.\n"
msgstr "V/F El algoritmo de Shor solo funciona para factorizar números pares.\n"

# doq-bootstrap: positional
#. type: Bullet: '6. '
#, markdown-text, no-wrap
msgid ""
"T/F A successful run of Shor’s algorithm always guarantees the correct "
"factors.\n"
msgstr ""
"V/F Una ejecución exitosa del algoritmo de Shor siempre garantiza los "
"factores correctos.\n"

