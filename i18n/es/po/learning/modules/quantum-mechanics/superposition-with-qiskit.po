# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Use Qiskit to create a circuit that transforms the state $|0\\rangle$ to the state $\\frac{\\sqrt{3}}{2}|0\\rangle + \\frac{1}{2}e^{i \\frac{5\\pi}{6}}|1\\rangle$\n"
msgstr "Usa Qiskit para crear un circuito que transforme el estado $|0\\rangle$ al estado $\\frac{\\sqrt{3}}{2}|0\\rangle + \\frac{1}{2}e^{i \\frac{5\\pi}{6}}|1\\rangle$\n"
