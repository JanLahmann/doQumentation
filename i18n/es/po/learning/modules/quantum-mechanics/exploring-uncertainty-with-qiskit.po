msgstr "V/F Se pueden medir $X$ y $Z$ simultáneamente, pero no $Y$.\n"

# doq-bootstrap: positional
#. type: Bullet: '3. '
#, markdown-text, no-wrap
msgid "T/F Linear position and linear momentum operators do not commute.\n"
msgstr "V/F Los operadores de posición lineal y momento lineal no conmutan.\n"

# doq-bootstrap: positional
#. type: Bullet: '4. '
#, markdown-text, no-wrap
msgid ""
"T/F IBM quantum computers measure along $Z$ by default, so a rotation must "
"be performed to measure along any other direction.\n"
msgstr ""
"V/F Los ordenadores cuánticos de IBM miden a lo largo de $Z$ por defecto, "
"por lo que debe realizarse una rotación para medir a lo largo de cualquier "
"otra dirección.\n"

