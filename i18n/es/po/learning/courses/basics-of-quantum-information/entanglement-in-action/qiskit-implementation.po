# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"Here is a quantum circuit implementation of the teleportation protocol.\n"
msgstr ""
"A continuación se muestra una implementación del protocolo de teleportación "
"mediante un circuito cuántico.\n"

