"\\displaystyle \\left[\\begin{matrix}10.0 & -3.02044405310714 - 2.80721615865252 i & 0.496487054782717 + 0.188101957039621 i & 1.0770511571923 + 0.104340737159455 i\\\\-3.02044405310714 + 2.80721615865252 i & 10.0 & -3.02044405310714 - 2.80721615865252 i & 0.496487054782717 + 0.188101957039621 i\\\\0.496487054782717 - 0.188101957039621 i & -3.02044405310714 + 2.80721615865252 i & 10.0 & -3.02044405310714 - 2.80721615865252 i\\\\1.0770511571923 - 0.104340737159455 i & 0.496487054782717 - 0.188101957039621 i & -3.02044405310714 + 2.80721615865252 i & 10.0\\end{matrix}\\right]\n"
"$$\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "Finally, we can solve the generalized eigenvalue problem for $\\tilde{H}$:\n"
msgstr "Finalmente, podemos resolver el problema de valores propios generalizado para $\\tilde{H}$:\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
