msgid "Step 4: Post-process, return result in classical format {#step-4-post-process-return-result-in-classical-format}"
msgstr "Paso 4: Post-procesamiento, devolver resultado en formato clásico {#step-4-post-process-return-result-in-classical-format}"

# doq-bootstrap: positional
