#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Take a 20-question exam on the IBM Training site to test your quantum algorithms skills and receive a badge through Credly."
msgstr "Realiza un examen de 20 preguntas en el sitio de IBM Training para poner a prueba tus conocimientos sobre algoritmos cuánticos y obtén una insignia a través de Credly."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Exam for Fundamentals of quantum algorithms"
msgstr "Examen final de Fundamentos de algoritmos cuánticos"

# doq-bootstrap: positional
#. type: Title #
#, no-wrap
msgid "Exam and badge {#exam-and-badge}"
msgstr "Examen e insignia {#exam-and-badge}"

# doq-bootstrap: positional
