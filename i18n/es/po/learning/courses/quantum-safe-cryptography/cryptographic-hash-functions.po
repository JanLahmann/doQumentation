msgid ""
"**Digital signatures:** Cryptographic hashes are essential to the "
"functioning of digital signatures as they involve comparing "
"cryptographically hashed messages to establish authenticity and integrity "
"while preserving privacy.\n"
msgstr ""
"**Firmas digitales:** Los hashes criptográficos son esenciales para el "
"funcionamiento de las firmas digitales, ya que implican la comparación de "
"mensajes hasheados criptográficamente para garantizar la autenticidad e "
"integridad mientras se preserva la privacidad.\n"

# doq-bootstrap: positional
