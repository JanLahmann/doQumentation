# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"The GHZ state (Greenberger-Horne-Zeilinger state) for $n$ qubits is defined "
"as\n"
msgstr ""
"El estado GHZ (estado de Greenberger-Horne-Zeilinger) para $n$ qubits se "
"define como\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|0\\rangle ^ {\\otimes n}+ |1\\rangle^ {\\otimes n})\n"
"$$\n"
msgstr ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|0\\rangle ^ {\\otimes n}+ |1\\rangle^ {\\otimes n})\n"
"$$\n"

