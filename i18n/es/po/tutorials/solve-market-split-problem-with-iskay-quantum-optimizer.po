" aleatoria en la mejor solución medida\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid "**Energy evaluation**: Calculate $C(x)$ for each modified solution\n"
msgstr ""
