msgid ""
"Template circuits for calculating matrix elements of $\\tilde{S}$ and "
"$\\tilde{H}$ via Hadamard test {#template-circuits-for-calculating-matrix-"
"elements-of-tildes-and-tildeh-via-hadamard-test}"
msgstr ""
