# doq: kept in English by the translator (name or code)
#. type: Title ##
#, no-wrap
msgid "Setup {#setup}"
msgstr "Setup {#setup}"

#. type: Plain text
#, no-wrap
msgid "Import the required libraries.\n"
msgstr "I-import ang mga kinakailangang library.\n"

#. type: Plain text
#, no-wrap
