#. type: Title ##
#, no-wrap
msgid "Step 4: Post-process and return result in desired classical format {#step-4-post-process-and-return-result-in-desired-classical-format}"
msgstr "Step 4: Post-process and return result in desired classical format {#step-4-post-process-and-return-result-in-desired-classical-format}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
