msgstr "**Output:**\n"

# doq: translated after an English change 2026-10-07
#. type: Plain text
#, no-wrap
msgid "Loads the $N_2$ molecule Hamiltonian from an FCIDump file. The number of qubits equals twice the number of orbitals (spin-up and spin-down).\n"
msgstr "Nilo-load ang Hamiltonian ng molekulang $N_2$ mula sa isang FCIDump file. Ang bilang ng qubit ay katumbas ng dalawang beses ang bilang ng orbital (spin-up at spin-down).\n"

# doq: translated after an English change 2026-10-07
