msgid ""
"$$\n"
"\\hat{\\mathcal{H}}_{XXZ} = \\sum_{i=1}^{L-1} J_{i,(i+1)}\\left(X_i X_{(i+1)}+Y_i Y_{(i+1)}+ 2\\cdot Z_i Z_{(i+1)} \\right) \\, ,\n"
"$$\n"
msgstr ""
"$$\n"
"\\hat{\\mathcal{H}}_{XXZ} = \\sum_{i=1}^{L-1} J_{i,(i+1)}\\left(X_i X_{(i+1)}+Y_i Y_{(i+1)}+ 2\\cdot Z_i Z_{(i+1)} \\right) \\, ,\n"
"$$\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"where $J_{i,(i+1)}$ is a random coefficient corresponding to edge $(i, "
"i+1)$. This is the Hamiltonian considered in the demonstration presented in "
"Ref. [\\[3\\]](#references).\n"
msgstr ""
"kung saan ang $J_{i,(i+1)}$ ay isang random coefficient na naaayon sa edge "
"$(i, i+1)$. Ito ang Hamiltonian na isinasaalang-alang sa demonstrasyon na "
"inilalahad sa Ref. [\\[3\\]](#references).\n"

