# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"For the large-scale example, we use the XXZ model on a line of 50 sites:\n"
msgstr ""
"Para sa malawak na halimbawa, ginagamit natin ang XXZ model sa isang linya "
"ng 50 sites:\n"

# doq-bootstrap: positional
#. type: Plain text
