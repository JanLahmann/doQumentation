msgid "Contributing {#contributing}"
msgstr "Pag-aambag {#contributing}"

# doq: translated after an English change 2026-11-13
#. type: Plain text
#, no-wrap
msgid "The source code is available [on GitHub](https://github.com/Qiskit/qiskit-mitigation).\n"
msgstr "Makukuha ang source code [sa GitHub](https://github.com/Qiskit/qiskit-mitigation).\n"

# doq: translated after an English change 2026-11-13
#. type: Plain text
#, no-wrap
msgid "The developer guide is located at [CONTRIBUTING.md](https://github.com/Qiskit/qiskit-mitigation/blob/main/CONTRIBUTING.md) in the root of this project’s repository. By participating, you are expected to uphold Qiskit’s [code of conduct](https://github.com/Qiskit/qiskit/blob/main/CODE_OF_CONDUCT.md).\n"
msgstr "Ang developer guide ay matatagpuan sa [CONTRIBUTING.md](https://github.com/Qiskit/qiskit-mitigation/blob/main/CONTRIBUTING.md) sa root ng repository ng proyektong ito. Sa pakikilahok, inaasahang susundin mo ang [code of conduct](https://github.com/Qiskit/qiskit/blob/main/CODE_OF_CONDUCT.md) ng Qiskit.\n"

# doq: translated after an English change 2026-11-13
#. type: Plain text
#, no-wrap
msgid "We use [GitHub issues](https://github.com/Qiskit/qiskit-mitigation/issues/new/choose) for tracking requests and bugs.\n"
msgstr "Gumagamit kami ng [GitHub issues](https://github.com/Qiskit/qiskit-mitigation/issues/new/choose) para subaybayan ang mga request at bug.\n"

