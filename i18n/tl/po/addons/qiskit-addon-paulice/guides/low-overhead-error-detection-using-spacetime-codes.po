# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Low overhead error detection using spacetime codes for the latest version of Qiskit Paulice"
msgstr "Error detection na mababa ang overhead gamit ang mga spacetime code para sa pinakabagong bersyon ng Qiskit Paulice"

# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Low overhead error detection using spacetime codes"
msgstr "Error detection na mababa ang overhead gamit ang mga spacetime code"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"addons/qiskit-addon-paulice/guides/low-overhead-error-detection-using-spacetime-codes.ipynb\" />\n"
