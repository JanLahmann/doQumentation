# doq: translated after an English change 2026-11-13
#. type: Plain text
#, no-wrap
msgid "This example shows how the bitstrings are manipulated in a (2-electron, 4-orbital) system.\n"
msgstr "Ipinapakita ng halimbawang ito kung paano minamanipula ang mga bitstring sa isang (2-electron, 4-orbital) na sistema.\n"

