msgid "Simulating a noiseless expectation value {#simulating-a-noiseless-expectation-value}"
msgstr "Pag-simulate ng noiseless na expectation value {#simulating-a-noiseless-expectation-value}"

# doq: translated after an English change 2026-11-13
#. type: Plain text
#, no-wrap
msgid "As our target observable, we choose the `ZZ` observable on the central qubits:\n"
msgstr "Bilang target na observable, pinipili natin ang observable na `ZZ` sa mga qubit sa gitna:\n"

