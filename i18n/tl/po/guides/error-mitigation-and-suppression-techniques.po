"    <Card\n"
"      title=\"Postselection with bit-flip checks\"\n"
"      description=\"Salain ang non-Markovian na noise sa mga sampled na bitstring sa pamamagitan ng pagsasama ng mga bit-flip check sa isang circuit.\"\n"
"      href=\"https://docs.quantum.ibm.com/addons/qiskit-mitigation/guides/postselection-with-non-markovian-error-checks\"\n"
"      analyticsName=\"Documentation page for post-selection\"\n"
"      linkText=\"Basahin ang guide\"\n"
"    />\n"

# doq: translated after an English change 2026-11-12
#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"Paulice\"\n"
"      description=\"Boost the fidelity of sampled distributions using hardware-efficient Pauli checks based on spacetime codes.\"\n"
"      href=\"https://docs.quantum.ibm.com/addons/qiskit-addon-paulice\"\n"
"      analyticsName=\"Documentation page: Paulice\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
msgstr ""
"    <Card\n"
"      title=\"Paulice\"\n"
"      description=\"Pahusayin ang fidelity ng mga sampled na distribution gamit ang hardware-efficient na Pauli check batay sa mga spacetime code.\"\n"
"      href=\"https://docs.quantum.ibm.com/addons/qiskit-addon-paulice\"\n"
"      analyticsName=\"Documentation page: Paulice\"\n"
"      linkText=\"Tingnan ang documentation\"\n"
"    />\n"

# doq: translated after an English change 2026-11-12
#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"Matrix-free Measurement Mitigation (M3)\"\n"
"      description=\"Mitigate measurement errors by processing in a reduced subspace defined by noisy bitstrings.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-mthree/\"\n"
"      analyticsName=\"Documentation page: M3\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
msgstr ""
"    <Card\n"
"      title=\"Matrix-free Measurement Mitigation (M3)\"\n"
"      description=\"Bawasan ang mga measurement error sa pamamagitan ng pagpoproseso sa isang reduced subspace na tinutukoy ng mga noisy na bitstring.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-mthree/\"\n"
"      analyticsName=\"Documentation page: M3\"\n"
"      linkText=\"Tingnan ang documentation\"\n"
"    />\n"

