#. type: Plain text
#, no-wrap
msgid ""
"**Default**: `True`\n"
"  </AccordionItem>\n"
msgstr ""
"**Default**: `True`\n"
"  </AccordionItem>\n"

#. type: Plain text
#, no-wrap
msgid ""
"<AccordionItem title=\"`execution.rep_delay`\">\n"
"The delay between a measurement and the subsequent quantum circuit.\n"
msgstr ""
"<AccordionItem title=\"`execution.rep_delay`\">\n"
