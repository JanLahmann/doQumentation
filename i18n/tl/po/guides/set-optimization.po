#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid ""
"How to set the optimization level for transpiling quantum circuits in "
"Qiskit."
msgstr ""
"Paano itakda ang optimization level para sa pag-transpile ng mga quantum "
"circuit sa Qiskit."

#. type: Yaml Front Matter Hash Value: sidebar_label
#, no-wrap
msgid "Set transpiler optimization level"
msgstr "Itakda ang optimization level ng transpiler"

