msgstr "Ang na-transpile na circuit ay may anim na two-qubit ECR gate.\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "Repeat for optimization level 1:\n"
msgstr "Ulitin para sa optimization level 1:\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"![Output of the previous code cell](/docs/images/guides/set-"
"optimization/extracted-outputs/2dab5def-a017-42e9-92d6-e043ac4065b2-0.svg)\n"
