msgid "Workflow verification tools {#workflow-verification-tools}"
msgstr "Mga workflow verification tool {#workflow-verification-tools}"

# doq: translated after an English change 2026-11-20
#. type: Plain text
#, no-wrap
msgid ""
"These tools are used for verifying workflows through classical simulation. They can simulate certain classes of circuits more efficiently than a general-purpose quantum circuit simulator. You can use them to check a workflow, such as an excitation-preserving ansatz or fermionic circuit, against a classical reference result before running it on quantum hardware.\n"
"<CardGroup>\n"
msgstr ""
"Ginagamit ang mga tool na ito para i-verify ang mga workflow sa pamamagitan ng classical simulation. Mas mahusay nilang nasisimulate ang ilang klase ng Circuit kaysa sa isang general-purpose na quantum circuit simulator. Magagamit mo ang mga ito para suriin ang isang workflow, tulad ng excitation-preserving ansatz o fermionic Circuit, laban sa isang classical reference result bago ito patakbuhin sa quantum hardware.\n"
"<CardGroup>\n"

# doq: translated after an English change 2026-11-20
#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"ffsim\"\n"
"      description=\"Simulate fermionic quantum circuits which conserve particle number and the z component of spin.\"\n"
"      href=\"https://qiskit.github.io/ffsim/\"\n"
"      analyticsName=\"Overview page: SQD\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
msgstr ""
