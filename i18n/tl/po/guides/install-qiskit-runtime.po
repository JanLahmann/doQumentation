"        <OperatingSystemTabs>\n"
"          <TabItem value=\"mac\" label=\"macOS\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"            ```shell\n"
"            python3 -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
msgstr ""

# doq: kept in English by the translator (name or code)
#. type: Plain text
#, no-wrap
msgid "          <TabItem value=\"linux\" label=\"Linux\">\n"
