#, no-wrap
msgid "Learn how to get involved with the Qiskit open-source community to shape the future of quantum computing."
msgstr "Alamin kung paano makiisa sa Qiskit open-source na komunidad upang hubugin ang kinabukasan ng quantum computing."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Open source"
msgstr "Open source"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
