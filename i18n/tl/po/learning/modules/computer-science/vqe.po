#, no-wrap
msgid "B) To allow a wide space of quantum states to be searched\n"
msgstr "B) Para makapag-search sa malawak na espasyo ng mga quantum state\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
#, no-wrap
msgid "C) To reduce circuit complexity\n"
