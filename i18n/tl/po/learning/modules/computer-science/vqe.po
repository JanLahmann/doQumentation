# doq-bootstrap: positional
#. type: Bullet: '- '
#, no-wrap
msgid "C) To entangle qubits\n"
msgstr "C) Para mag-entangle ng mga qubit\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
#, no-wrap
msgid "D) To generate quantum randomness\n"
msgstr "D) Para bumuo ng quantum randomness\n"

# doq-bootstrap: positional
#. type: Bullet: '5. '
#, no-wrap
msgid "Why is the ansatz designed to be parameterized?\n"
msgstr "Bakit dinisenyo ang ansatz na may mga parameter?\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
#, no-wrap
msgid "A) To allow quantum state preparation\n"
msgstr "A) Para payagan ang paghahanda ng quantum state\n"

# doq-bootstrap: positional
