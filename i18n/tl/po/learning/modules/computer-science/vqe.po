#. type: Bullet: '4. '
#, no-wrap
msgid "Why is a classical optimizer required in VQE?\n"
msgstr "Bakit kailangan ng classical optimizer sa VQE?\n"

# doq-bootstrap: positional
#. type: Bullet: '- '
#, no-wrap
msgid "A) To perform quantum measurements\n"
