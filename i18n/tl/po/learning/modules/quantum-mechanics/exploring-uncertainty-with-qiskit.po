# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "T/F One can simultaneously measure $X$ and $Y$, but not $Z$.\n"
msgstr "T/H Maaaring sabay na sukatin ang $X$ at $Y$, ngunit hindi ang $Z$.\n"

