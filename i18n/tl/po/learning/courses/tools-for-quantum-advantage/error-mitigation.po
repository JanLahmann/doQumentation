msgstr "Napakaliit o mababaw ang mga circuit (madalas $\\leq 10-20$ gates),\n"

# doq: translated after an English change 2026-10-13 · verified 2026-10-18
#. type: Bullet: '* '
#, no-wrap
msgid "Noise models are simple and well-validated (for example, Pauli noise),\n"
msgstr "Simple at well-validated ang mga noise model (halimbawa, Pauli noise),\n"

# doq: translated after an English change 2026-10-13 · verified 2026-10-18
#. type: Bullet: '* '
#, no-wrap
msgid "High statistical cost is acceptable,\n"
msgstr "Katanggap-tanggap ang mataas na statistical cost,\n"

# doq: translated after an English change 2026-10-13 · verified 2026-10-18
#. type: Bullet: '* '
#, no-wrap
msgid "The goal is accuracy rather than throughput.\n"
msgstr "Ang layunin ay accuracy kaysa throughput.\n"

# doq: translated after an English change 2026-10-13 · verified 2026-10-18
