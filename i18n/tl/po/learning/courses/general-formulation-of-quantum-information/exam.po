#, no-wrap
msgid "Take a 20-question exam on the IBM Training site to test your quantum information skills and receive a badge through Credly."
msgstr "Kumuha ng pagsusulit na may 20 tanong sa IBM Training site para subukan ang iyong mga kasanayan sa quantum information at makatanggap ng badge sa pamamagitan ng Credly."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Exam  | General formulation of quantum information"
msgstr "Exam  | General formulation of quantum information"

# doq-bootstrap: positional
#. type: Title #
