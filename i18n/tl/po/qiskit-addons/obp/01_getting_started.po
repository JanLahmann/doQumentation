msgstr "<font color=\"#0F62FE\">I-backpropagate ang mga slice mula sa circuit patungo sa isang Pauli observable</font>\n"

#. type: Bullet: '    - '
#, no-wrap
msgid "Combine the remaining slices into a single circuit\n"
msgstr "Pagsamahin ang natitirang mga slice sa isang single circuit\n"

