msgstr "(b) $A \\subseteq G$\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "(c) $G \\subset A$\n"
msgstr "(c) $G \\subset A$\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
