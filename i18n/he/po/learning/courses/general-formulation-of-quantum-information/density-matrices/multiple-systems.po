"\\frac{1}{4} & \\frac{1}{4}\n"
"\\end{pmatrix}\n"
"\\end{pmatrix}\n"
"= \\begin{pmatrix}\n"
"\\frac{1}{2} & 0\\\\[2mm]\n"
"0 & \\frac{1}{2}\n"
"\\end{pmatrix}\n"
"$$\n"
msgstr ""
"$$\n"
"\\operatorname{Tr}_{\\mathsf{B}}\n"
"\\begin{pmatrix}\n"
"\\frac{1}{2} & 0 & 0 & 0\\\\[2mm]\n"
"0 & 0 & 0 & 0\\\\[2mm]\n"
"0 & 0 & \\frac{1}{4} & \\frac{1}{4}\\\\[2mm]\n"
"0 & 0 & \\frac{1}{4} & \\frac{1}{4}\n"
"\\end{pmatrix}\n"
"= \\begin{pmatrix}\n"
"\\operatorname{Tr} \\begin{pmatrix}\n"
"\\frac{1}{2} & 0\\\\[1mm]\n"
"0 & 0\n"
"\\end{pmatrix}\n"
"&\n"
"\\operatorname{Tr} \\begin{pmatrix}\n"
"0 & 0\\\\[1mm]\n"
"0 & 0\n"
"\\end{pmatrix}\n"
"\\\\[4mm]\n"
"\\operatorname{Tr} \\begin{pmatrix}\n"
