# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"![Basis for Bob](/learning/images/courses/basics-of-quantum-"
"information/entanglement-in-action/qiskit-implementation/beta-basis.avif)\n"
msgstr ""
"![בסיס עבור בוב](/learning/images/courses/basics-of-quantum-"
"information/entanglement-in-action/qiskit-implementation/beta-basis.avif)\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
