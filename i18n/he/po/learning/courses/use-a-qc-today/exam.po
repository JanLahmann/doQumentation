#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Take a 20-question exam on the IBM Training site to test your skills in using a quantum computer, and receive a badge through Credly."
msgstr "עשה מבחן בן 20 שאלות באתר IBM Training כדי לבחון את המיומנויות שלך בשימוש במחשב קוונטי, וקבל badge דרך Credly."

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Exam | Use a quantum computer today"
msgstr "מבחן | השתמש במחשב קוונטי היום"

#. type: Title #
#, no-wrap
msgid "Exam and badge {#exam-and-badge}"
msgstr "מבחן ו-badge {#exam-and-badge}"

