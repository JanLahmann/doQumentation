#, no-wrap
msgid ""
"$$\n"
"e^{H_1+H_2} \\approx e^{H_1/2}e^{H_2}e^{H_1/2}\n"
"$$\n"
msgstr ""
"$$\n"
"e^{H_1+H_2} \\approx e^{H_1/2}e^{H_2}e^{H_1/2}\n"
"$$\n"

