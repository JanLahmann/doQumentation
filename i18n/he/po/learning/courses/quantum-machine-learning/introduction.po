# doq-bootstrap: positional
#. type: Title ##
#, no-wrap
msgid "Course learning goals {#course-learning-goals}"
msgstr "מטרות למידה של הקורס {#course-learning-goals}"

# doq-bootstrap: positional
#. type: Plain text
