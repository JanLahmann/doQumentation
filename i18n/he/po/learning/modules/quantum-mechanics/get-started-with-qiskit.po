# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "__Hadamard gate:__ Creates a superposition state. Truth table:\n"
msgstr "__Gate Hadamard:__ יוצר מצב סופרפוזיציה. טבלת אמת:\n"

# doq-bootstrap: positional
