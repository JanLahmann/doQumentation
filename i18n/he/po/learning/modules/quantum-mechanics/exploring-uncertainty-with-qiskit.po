# doq-bootstrap: positional
#. type: Bullet: '2. '
#, markdown-text, no-wrap
msgid "T/F One can simultaneously measure $X$ and $Z$, but not $Y$.\n"
msgstr "נ/לא נ — ניתן למדוד $X$ ו-$Z$ בו-זמנית, אבל לא $Y$.\n"

# doq-bootstrap: positional
#. type: Bullet: '3. '
