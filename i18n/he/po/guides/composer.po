msgid "**RY gate**\n"
msgstr "**שער RY**\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"The RY gate implements $exp(-i\\frac{\\theta}{2}Y)$. On the Bloch sphere, "
"this gate corresponds to rotating the qubit state around the y axis by the "
"given angle and does not introduce complex amplitudes.\n"
msgstr ""
"שער RY מממש $exp(-i\\frac{\\theta}{2}Y)$. על כדור בלוך, שער זה מתאים לסיבוב "
"מצב ה-Qubit סביב ציר ה-y בזווית הנתונה ואינו מכניס אמפליטודות מרוכבות.\n"

