#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid ""
"Get started using Qiskit with IBM Quantum hardware in this Hello World "
"example"
msgstr "התחל להשתמש ב-Qiskit עם חומרת IBM Quantum בדוגמת Hello World"

#. type: Yaml Front Matter Hash Value: sidebar_label
#, no-wrap
msgid "Run your first circuit on hardware"
msgstr "הרץ את ה-Circuit הראשון שלך על חומרה"

#. type: Plain text
#, markdown-text, no-wrap
msgid "<OpenInLabBanner notebookPath=\"guides/hello-world.ipynb\" />\n"
msgstr "<OpenInLabBanner notebookPath=\"guides/hello-world.ipynb\" />\n"

