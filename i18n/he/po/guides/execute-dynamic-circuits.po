#. type: Title ##
#, no-wrap
msgid "Find backends that support dynamic circuits {#find-backends-that-support-dynamic-circuits}"
msgstr "מצא Backends שתומכים במעגלים דינמיים {#find-backends-that-support-dynamic-circuits}"

#. type: Plain text
#, no-wrap
msgid "To find all backends that your account can access and support dynamic circuits, run code like the following.  This example assumes that you have [saved your login credentials](/guides/save-credentials).  You could also [explicitly specify credentials](/guides/initialize-account#explicit) when initializing your IBM Quantum Compute Service account.  This would let you view backends available on a specific instance or plan type, for example.\n"
msgstr "כדי למצוא את כל ה-Backends שהחשבון שלך יכול לגשת אליהם ותומכים במעגלים דינמיים, הרץ קוד כמו הבא. דוגמה זו מניחה שה[שמרת את אישורי הכניסה שלך](/guides/save-credentials). אפשר גם [לציין אישורים במפורש](/guides/initialize-account#explicit) בעת אתחול חשבון IBM Quantum Compute Service. זה יאפשר לך לצפות ב-Backends הזמינים על מופע או סוג תוכנית ספציפיים, לדוגמה.\n"

#. type: Plain text
#, no-wrap
msgid ""
"<Admonition type=\"note\" title=\"Notes\">\n"
"- The backends that are available to the account depend on the instance specified in the credentials.\n"
"- The new version of dynamic circuits is now available to all users on all backends. See [the announcement](/guides/changelog-quantum-compute-service#new-dynamic-circuits) for more details.\n"
msgstr ""
"<Admonition type=\"note\" title=\"הערות\">\n"
"- ה-Backends הזמינים לחשבון תלויים במופע שצוין באישורים.\n"
"- הגרסה החדשה של מעגלים דינמיים זמינה כעת לכל המשתמשים על כל ה-Backends. ראו [ההכרזה](/guides/changelog-quantum-compute-service#new-dynamic-circuits) לפרטים נוספים.\n"

#. type: Plain text
#, no-wrap
msgid "</Admonition>\n"
msgstr "</Admonition>\n"

