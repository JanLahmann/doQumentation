msgstr "הפעל את הסביבה החדשה שלך.\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"         <OperatingSystemTabs>\n"
"           <TabItem value=\"mac\" label=\"macOS\">\n"
