#, no-wrap
msgid "Setup instructions to use the REST API to submit IBM Quantum Compute Service jobs"
msgstr "הוראות הגדרה לשימוש ב-REST API להגשת עבודות IBM Quantum Compute Service"

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Set up to use IBM Quantum Platform with REST API"
msgstr "הגדרת שימוש ב-IBM Quantum Platform עם REST API"

#. type: Plain text
#, fuzzy, no-wrap
#| msgid "{/* cspell:ignore urlendcoded, WQVY */}\n"
msgid "{/* cspell:ignore WQVY */}\n"
