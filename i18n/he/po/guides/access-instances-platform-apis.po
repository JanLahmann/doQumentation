#. type: Plain text
#, no-wrap
msgid "To remove Catalog Functions from an instance, send a PATCH with `\"functions\": null`:\n"
msgstr "כדי להסיר Catalog Functions מ-instance, יש לשלוח PATCH עם `\"functions\": null`:\n"

#. type: Plain text
#, no-wrap
msgid ""
"    ```bash\n"
"--data '{\n"
"  \"parameters\": {\n"
"    \"timestamp\": \"2026-06-30T00:00:01Z\",\n"
"    \"functions\": null\n"
"  }\n"
"}'\n"
"    ```\n"
"  </TabItem>\n"
