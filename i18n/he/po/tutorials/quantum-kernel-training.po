"primitives}"

#. type: Bullet: '*   '
#, markdown-text, no-wrap
msgid "Input: Abstract circuit.\n"
msgstr "קלט: מעגל מופשט.\n"

#. type: Bullet: '*   '
#, markdown-text, no-wrap
