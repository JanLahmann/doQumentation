msgstr "סימולטור Qiskit Aer (`pip install qiskit-aer`)\n"

#. type: Bullet: '- '
#, no-wrap
msgid "MPF Qiskit addon with the TeNPy backend (`pip install \"qiskit-addon-mpf[tenpy]\"`)\n"
msgstr "תוסף MPF Qiskit עם ה-backend של TeNPy (`pip install \"qiskit-addon-mpf[tenpy]\"`)\n"

# doq: kept in English by the translator (name or code)
#. type: Bullet: '- '
#, no-wrap
msgid "Qiskit addon utilities (`pip install qiskit-addon-utils`)\n"
msgstr "Qiskit addon utilities (`pip install qiskit-addon-utils`)\n"

