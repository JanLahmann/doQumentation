# doq-bootstrap: positional
#. type: Bullet: '*   '
#, no-wrap
msgid "Recognize the benefits of exploring quantum computing now.\n"
msgstr "量子コンピューティングを今すぐ探求することの利点を認識する。\n"

# doq-bootstrap: positional
#. type: Bullet: '*   '
