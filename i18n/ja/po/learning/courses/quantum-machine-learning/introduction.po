# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "<IBMVideo id=\"134355930\" title=\"In this video, Chris Porter provides an overview of subspace quantum diagonalization. He describes what factors influence its efficiency and usefulness. He explains what makes it faster than other approaches. The text below gives more detail.\"/>\n"
msgstr "<IBMVideo id=\"134355930\" title=\"In this video, Chris Porter provides an overview of subspace quantum diagonalization. He describes what factors influence its efficiency and usefulness. He explains what makes it faster than other approaches. The text below gives more detail.\"/>\n"

# doq-bootstrap: positional
#. type: Plain text
