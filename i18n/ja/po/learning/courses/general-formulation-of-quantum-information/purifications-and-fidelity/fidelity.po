msgid "Fidelity"
msgstr "忠実度"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"{/* cspell:ignore operatorname */}\n"
"{/* cspell:ignore biggr */}\n"
msgstr ""
