msgstr "はじめに"

#. type: Title #
#, no-wrap
msgid "Course introduction {#course-introduction}"
msgstr "コースの紹介 {#course-introduction}"

# doq: mechanical transfer from the previous translation
#. type: Plain text
#, no-wrap
