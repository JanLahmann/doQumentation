# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "We here consider the 1-D transverse-field Ising model.\n"
msgstr "ここでは1次元横磁場イジングモデルを考えます。\n"

# doq-bootstrap: positional
