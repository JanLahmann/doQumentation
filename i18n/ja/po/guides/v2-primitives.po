"<Tabs>\n"
"  <TabItem value=\"V2\" label=\"V2 primitives\">\n"
msgstr ""
"<Tabs>\n"
"  <TabItem value=\"V2\" label=\"V2 primitives\">\n"

# doq-bootstrap: positional
#. type: Plain text
