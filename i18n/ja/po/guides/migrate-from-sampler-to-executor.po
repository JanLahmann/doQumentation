msgstr "ステップ2. インポートの変更 {#step-2-change-the-imports}"

# doq: copied, nothing translatable
#. type: Plain text
#, no-wrap
msgid "**Sampler:**\n"
msgstr "**Sampler:**\n"

# doq: copied, nothing translatable
