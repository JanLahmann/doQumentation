#, markdown-text, no-wrap
msgid "<OpenInLabBanner notebookPath=\"guides/DAG-representation.ipynb\" />\n"
msgstr "<OpenInLabBanner notebookPath=\"guides/DAG-representation.ipynb\" />\n"

