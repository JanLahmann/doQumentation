msgstr "<font color='#0F62FE'>Couper le circuit et l'observable.</font>\n"

#. type: Bullet: '    - '
#, markdown-text, no-wrap
msgid "Transpile the subexperiments for hardware.\n"
msgstr "Transpiler les sous-expériences pour le matériel.\n"

#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid "**Step 3: Execute on target hardware**:\n"
msgstr "**Étape 3 : Exécuter sur le matériel cible** :\n"

#. type: Bullet: '    - '
