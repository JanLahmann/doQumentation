msgid "Zero-noise extrapolation with probabilistic error amplification for the latest version of Qiskit mitigation"
msgstr "Extrapolation à bruit nul avec amplification probabiliste d'erreur pour la dernière version de Qiskit mitigation"

# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Zero-noise extrapolation with probabilistic error amplification"
msgstr "Extrapolation à bruit nul avec amplification probabiliste d'erreur"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"addons/qiskit-mitigation/guides/pea-with-noise-learning.ipynb\" />\n"
