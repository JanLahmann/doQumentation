#, no-wrap
msgid "Incorporate Samplomatic’s pass manager into Qiskit preset pass managers {#incorporate-samplomatics-pass-manager-into-qiskit-preset-pass-managers}"
msgstr "Intégrer le pass manager de Samplomatic aux pass managers prédéfinis de Qiskit {#incorporate-samplomatics-pass-manager-into-qiskit-preset-pass-managers}"

# doq: translated after an English change 2026-11-13
