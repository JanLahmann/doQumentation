msgid "Map operator representations for the latest version of Qiskit bosons"
msgstr "Mapper les représentations d'opérateurs pour la dernière version de Qiskit bosons"

# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Map operator representations"
msgstr "Mapper les représentations d'opérateurs"

#. type: Plain text
