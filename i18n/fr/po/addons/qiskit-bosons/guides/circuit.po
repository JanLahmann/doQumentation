#, no-wrap
msgid "`repeat(..., insert_barriers=True)` puts one between consecutive repetitions, and none after the last:\n"
msgstr "`repeat(..., insert_barriers=True)` en place une entre répétitions consécutives, et aucune après la dernière :\n"

