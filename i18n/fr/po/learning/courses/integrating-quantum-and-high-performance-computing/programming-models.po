# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid ""
"This lesson gives an overview of programming models for distributing tasks "
"optimally between resources."
msgstr ""
"Cette leçon donne un aperçu des modèles de programmation permettant de "
"distribuer les tâches de manière optimale entre les ressources."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Programming models"
msgstr "Modèles de programmation"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"{/* cspell:ignore SPMD gres openmpi mpirun Gres SBATCH ntasks ntask cpus "
"srun Sbatch sbatch squeue JOBID Pasqal optimiza OpenMP Iskandar Sitdikov "
