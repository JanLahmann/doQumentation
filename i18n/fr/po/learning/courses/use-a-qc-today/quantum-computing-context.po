# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid ""
"Learn about quantum computing applications, scaling challenges, and where "
"quantum advantage matters most."
msgstr ""
"Découvre les applications de l'informatique quantique, les défis de mise à "
"l'échelle et les domaines où l'avantage quantique est le plus pertinent."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Quantum computing context"
msgstr "Le contexte de l'informatique quantique"

# doq-bootstrap: dropped, JSX/HTML tags differ from English: <IBMVideo
# id="134800419" title="In this video Olivia zooms o
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
