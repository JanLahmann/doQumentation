msgstr "Maintenant, nous exécutons nos jobs.\n"

# doq: translated after an English change 2026-09-28 · verified 2026-09-29
#. type: Plain text
#, no-wrap
msgid "We get the counts from each of the runs on a real quantum computer.\n"
msgstr "Nous récupérons les comptages de chacune des exécutions sur un ordinateur quantique réel.\n"

# doq: translated after an English change 2026-09-28 · verified 2026-09-29
#. type: Plain text
#, no-wrap
msgid "Now we find the Hellinger fidelity by comparing each of these runs to the noise-free AerSimulator results.\n"
msgstr "Maintenant, nous calculons la fidélité de Hellinger en comparant chacune de ces exécutions aux résultats de l'AerSimulator sans bruit.\n"

# doq: translated after an English change 2026-09-28 · verified 2026-09-29
