#, no-wrap
msgid "Step 2: Optimize problem for quantum hardware execution {#step-2-optimize-problem-for-quantum-hardware-execution-1}"
msgstr "Étape 2 : Optimiser le problème pour l'exécution sur matériel quantique {#step-2-optimize-problem-for-quantum-hardware-execution-1}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "This proceeds exactly as before.\n"
msgstr "Cela se passe exactement comme précédemment.\n"

#. type: Title ###
