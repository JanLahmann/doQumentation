#. type: Plain text
#, no-wrap
msgid ""
"Input: Quasi-probability distributions\n"
"Output: Reconstructed expectation values\n"
msgstr ""
"Entrée : Distributions de quasi-probabilités\n"
"Sortie : Valeurs d'espérance reconstruites\n"

