#, markdown-text, no-wrap
msgid ""
"<OpenInLabBanner notebookPath=\"tutorials/simulate-kicked-ising-tem.ipynb\" "
"/>\n"
msgstr ""
"<OpenInLabBanner notebookPath=\"tutorials/simulate-kicked-ising-tem.ipynb\" "
