" entre ce qui suit :\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"    ```python\n"
"    from qiskit_ibm_catalog import QiskitFunctionsCatalog\n"
msgstr ""
"    ```python\n"
"    from qiskit_ibm_catalog import QiskitFunctionsCatalog\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
