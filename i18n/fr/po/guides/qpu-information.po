"        </tr>\n"
"        <tr>\n"
"          <th scope=\"row\">View on IBM Quantum Platform</th>\n"
"          <td>Details section, and an expanded view in the Two-qubit gate error (layered) section</td>\n"
"        </tr>\n"
"      </tbody>\n"
"    </table>\n"
