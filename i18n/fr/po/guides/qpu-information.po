msgstr ""
"<Tabs>\n"
"  <TabItem value=\"Qiskit-backend\" label=\"Voir les informations du backend avec Qiskit\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"  </TabItem>\n"
"  <TabItem value=\"IQP-backend\" label=\"View backend information on IBM Quantum Platform\">\n"
msgstr ""
"  </TabItem>\n"
"  <TabItem value=\"IQP-backend\" label=\"Voir les informations du backend sur IBM Quantum Platform\">\n"

# doq-bootstrap: positional
