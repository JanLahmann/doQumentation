#, no-wrap
msgid "Specify `rep_delay` for a primitive job {#specify-rep-delay-for-a-primitive-job}"
msgstr "Spécifier `rep_delay` pour un job primitif {#specify-rep-delay-for-a-primitive-job}"

#. type: Plain text
#, no-wrap
msgid "<Admonition type=\"note\" title=\"Verify the rep_delay value for a QPU\">\n"
msgstr "<Admonition type=\"note\" title=\"Vérifier la valeur rep_delay pour une QPU\">\n"

#. type: Plain text
#, no-wrap
msgid "Always verify the supported `rep_delay` range for the specific QPU you are using. These values are not the same for every QPU and can also change over time.\n"
msgstr "Vérifie toujours la plage de `rep_delay` supportée pour la QPU spécifique que tu utilises. Ces valeurs ne sont pas les mêmes pour chaque QPU et peuvent également changer au fil du temps.\n"

#. type: Plain text
#, no-wrap
msgid ""
"Please note that an increase in `rep_delay` will have a direct impact on your execution time and capacity consumption.\n"
"</Admonition>\n"
msgstr ""
"Note qu'une augmentation du `rep_delay` aura un impact direct sur ton temps d'exécution et ta consommation de capacité.\n"
"</Admonition>\n"

