msgstr "**Porte S**\n"

#. type: Plain text
#, no-wrap
msgid "The S gate applies a phase of $i$ to the $\\left|1\\right\\rangle$ state. It is equivalent to RZ for the angle $\\pi/2$. Note that S=P($\\pi/2$).\n"
msgstr "La porte S applique une phase de $i$ à l'état $\\left|1\\right\\rangle$. Elle équivaut à RZ pour l'angle $\\pi/2$. Note que S=P($\\pi/2$).\n"

