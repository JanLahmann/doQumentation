#, no-wrap
msgid "Injecting circuit gate operations {#injecting-circuit-gate-operations}"
msgstr "Injection d'opérations de porte de circuit {#injecting-circuit-gate-operations}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"Injecting circuit gate operations into the pulse builder context through\n"
"[`qiskit.pulse.builder.call`](https://docs.quantum.ibm.com/api/qiskit/1.4/pulse#call) is no longer possible.\n"
"This removal affects input arguments of type `QuantumCircuit`, as well as the\n"
"following functions:\n"
msgstr ""
"Il n'est plus possible d'injecter des opérations de porte de circuit dans le contexte du\n"
"constructeur de pulse par le biais de\n"
"[`qiskit.pulse.builder.call`](https://docs.quantum.ibm.com/api/qiskit/1.4/pulse#call).\n"
"Cette suppression affecte les arguments d'entrée de type `QuantumCircuit`, ainsi que les\n"
"fonctions suivantes :\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "`qiskit.pulse.builder.call_gate`\n"
msgstr "`qiskit.pulse.builder.call_gate`\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "`qiskit.pulse.builder.cx`\n"
msgstr "`qiskit.pulse.builder.cx`\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "`qiskit.pulse.builder.u1`\n"
msgstr "`qiskit.pulse.builder.u1`\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "`qiskit.pulse.builder.u2`\n"
msgstr "`qiskit.pulse.builder.u2`\n"

