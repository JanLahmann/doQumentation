msgstr "Instructions de configuration pour utiliser l'API REST afin de soumettre des jobs IBM Quantum Compute Service"

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Set up to use IBM Quantum Platform with REST API"
msgstr "Configurer l'utilisation d'IBM Quantum Platform avec l'API REST"

#. type: Plain text
#, fuzzy, no-wrap
