#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Discover tools that help manage noise through the available error mitigation and suppression techniques"
msgstr "Découvrez les outils qui aident à gérer le bruit grâce aux techniques d'atténuation et de suppression d'erreurs disponibles"

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Overview of noise management techniques"
msgstr "Vue d'ensemble des techniques de gestion du bruit"

#. type: Plain text
#, no-wrap
msgid "{/* cspell:ignore lightcones */}\n"
msgstr "{/* cspell:ignore lightcones */}\n"

#. type: Title #
#, no-wrap
msgid "Overview of noise management techniques {#overview-of-noise-management-techniques}"
msgstr "Vue d'ensemble des techniques de gestion du bruit {#overview-of-noise-management-techniques}"

#. type: Plain text
#, no-wrap
msgid "When executing quantum workloads, there are multiple ways to reduce the impact of noise. The open-source Qiskit addons provide error mitigation and suppression techniques that integrate directly into your development workflow, while IBM Quantum Compute Service applies advanced error mitigation strategies automatically when jobs are submitted for execution. This page indexes all available tools and features across both options to help you choose the right approach to manage noise when building quantum workloads.\n"
msgstr "Lors de l'exécution de charges de travail quantiques, il existe plusieurs façons de réduire l'impact du bruit. Les addons Qiskit open-source fournissent des techniques d'atténuation et de suppression d'erreurs qui s'intègrent directement dans ton flux de développement, tandis qu'IBM Quantum Compute Service applique automatiquement des stratégies avancées d'atténuation d'erreurs lorsque les jobs sont soumis pour exécution. Cette page répertorie tous les outils et fonctionnalités disponibles dans les deux options pour t'aider à choisir la bonne approche pour gérer le bruit lors de la création de charges de travail quantiques.\n"

#. type: Title ##
#, no-wrap
msgid "General noise management techniques {#general-noise-management-techniques}"
msgstr "Techniques générales de gestion du bruit {#general-noise-management-techniques}"

#. type: Plain text
#, no-wrap
msgid ""
"<CardGroup>\n"
"    <Card\n"
"      title=\"Directed execution model\"\n"
"      description=\"Fine-tune error mitigation and other techniques by capturing design intents on the client side, and shifting the costly generation of circuit variants to the server side.\"\n"
"      href=\"/guides/directed-execution-model\"\n"
"      analyticsName=\"Documentation page: Directed execution model\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
msgstr ""
"<CardGroup>\n"
"    <Card\n"
"      title=\"Modèle d'exécution dirigée\"\n"
"      description=\"Affine l'atténuation d'erreurs et d'autres techniques en capturant les intentions de conception côté client et en déplaçant la génération coûteuse de variantes de circuits côté serveur.\"\n"
"      href=\"/guides/directed-execution-model\"\n"
"      analyticsName=\"Documentation page: Directed execution model\"\n"
"      linkText=\"Parcourir la documentation\"\n"
"    />\n"

#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"Dynamical decoupling\"\n"
"      description=\"Inserts pulse sequences on idling qubits to suppress coherence errors caused by unwanted interactions between qubits during circuit execution.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#dynamical-decoupling\"\n"
"      analyticsName=\"Documentation page: Dynamical decoupling\"\n"
"      linkText=\"Learn more\"\n"
"    />\n"
msgstr ""
"    <Card\n"
"      title=\"Découplage dynamique\"\n"
"      description=\"Insère des séquences d'impulsions sur les qubits inactifs pour supprimer les erreurs de cohérence causées par des interactions indésirables entre les qubits pendant l'exécution du circuit.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#dynamical-decoupling\"\n"
"      analyticsName=\"Documentation page: Dynamical decoupling\"\n"
"      linkText=\"En savoir plus\"\n"
"    />\n"

#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"Pauli twirling\"\n"
"      description=\"Noise-tailoring technique that transforms any noise channel into a Pauli channel that has a more specific structure; often combined with other error mitigation techniques that work well with Pauli noise.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#pauli-twirling\"\n"
"      analyticsName=\"Documentation page: Pauli twirling\"\n"
"      linkText=\"Learn more\"\n"
"    />\n"
msgstr ""
"    <Card\n"
"      title=\"Twirling de Pauli\"\n"
"      description=\"Technique d'adaptation au bruit qui transforme tout canal de bruit en un canal de Pauli ayant une structure plus spécifique ; souvent combinée avec d'autres techniques d'atténuation d'erreurs qui fonctionnent bien avec le bruit de Pauli.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#pauli-twirling\"\n"
"      analyticsName=\"Documentation page: Pauli twirling\"\n"
"      linkText=\"En savoir plus\"\n"
"    />\n"

#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"AQC-Tensor Qiskit addon\"\n"
"      description=\"Users can compile the initial portion of a circuit into a nearly equivalent approximation of that circuit, but with fewer layers.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-aqc-tensor/\"\n"
"      analyticsName=\"Documentation page: Approximate quantum compilation\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
"</CardGroup>\n"
msgstr ""
"    <Card\n"
"      title=\"Addon Qiskit AQC-Tensor\"\n"
"      description=\"Les utilisateurs peuvent compiler la partie initiale d'un circuit en une approximation presque équivalente de ce circuit, mais avec moins de couches.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-aqc-tensor/\"\n"
"      analyticsName=\"Documentation page: Approximate quantum compilation\"\n"
"      linkText=\"Parcourir la documentation\"\n"
"    />\n"
"</CardGroup>\n"

#. type: Title ##
#, no-wrap
msgid "Error mitigation for expectation value estimation {#error-mitigation-for-expectation-value-estimation}"
msgstr "Atténuation d'erreurs pour l'estimation des valeurs d'espérance {#error-mitigation-for-expectation-value-estimation}"

#. type: Plain text
#, no-wrap
msgid ""
"<CardGroup>\n"
"    <Card\n"
"      title=\"Twirled readout error extinction (TREX)\"\n"
"      description=\"Error mitigation tool within IBM Quantum Compute Service that mitigate the effects of measurement errors by randomly substituting them with a twirled measurement sequence.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#twirled-readout-error-extinction-trex\"\n"
"      analyticsName=\"Documentation page: TREX\"\n"
"      linkText=\"Learn more\"\n"
"    />\n"
"    <Card\n"
"      title=\"Zero-noise extrapolation (ZNE)\"\n"
"      description=\"Error mitigation technique that computes the expectation value at different noise levels, and then estimates the ideal result by extrapolating the noisy expectation value results to the zero-noise limit.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#zero-noise-extrapolation-zne\"\n"
"      analyticsName=\"Documentation page: ZNE\"\n"
"      linkText=\"Learn more\"\n"
"    />\n"
"    <Card\n"
"      title=\"Probabilistic error amplification (PEA)\"\n"
"      description=\"ZNE technique that involves running preliminary experiments to learn a twirled noise model of the circuit, then uses this model to perform a more accurate error amplification.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#probabilistic-error-amplification-pea\"\n"
"      analyticsName=\"Documentation page: PEA\"\n"
"      linkText=\"Learn more\"\n"
"    />\n"
"    <Card\n"
"      title=\"Probabilistic error cancellation (PEC)\"\n"
"      description=\"Returns an unbiased estimate of the expectation value, at the expense of greater overhead than other techniques such as ZNE. It extrapolates output of the ideal circuit by executing different noisy circuit instances.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#probabilistic-error-cancellation-pec\"\n"
"      analyticsName=\"Documentation page: PEC\"\n"
"      linkText=\"Learn more\"\n"
"    />\n"
msgstr ""
"<CardGroup>\n"
"    <Card\n"
"      title=\"Extinction des erreurs de lecture torsadée (TREX)\"\n"
"      description=\"Outil d'atténuation d'erreurs dans IBM Quantum Compute Service qui atténue les effets des erreurs de mesure en les remplaçant aléatoirement par une séquence de mesure torsadée.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#twirled-readout-error-extinction-trex\"\n"
"      analyticsName=\"Documentation page: TREX\"\n"
"      linkText=\"En savoir plus\"\n"
"    />\n"
"    <Card\n"
"      title=\"Extrapolation zéro-bruit (ZNE)\"\n"
"      description=\"Technique d'atténuation d'erreurs qui calcule la valeur d'espérance à différents niveaux de bruit, puis estime le résultat idéal en extrapolant les résultats de valeur d'espérance bruitée vers la limite zéro-bruit.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#zero-noise-extrapolation-zne\"\n"
"      analyticsName=\"Documentation page: ZNE\"\n"
"      linkText=\"En savoir plus\"\n"
"    />\n"
"    <Card\n"
"      title=\"Amplification d'erreur probabiliste (PEA)\"\n"
"      description=\"Technique ZNE qui consiste à exécuter des expériences préliminaires pour apprendre un modèle de bruit torsadé du circuit, puis utilise ce modèle pour effectuer une amplification d'erreur plus précise.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#probabilistic-error-amplification-pea\"\n"
"      analyticsName=\"Documentation page: PEA\"\n"
"      linkText=\"En savoir plus\"\n"
"    />\n"
"    <Card\n"
"      title=\"Annulation d'erreur probabiliste (PEC)\"\n"
"      description=\"Renvoie une estimation non biaisée de la valeur d'espérance, au prix d'une surcharge plus importante que d'autres techniques comme ZNE. Elle extrapole la sortie du circuit idéal en exécutant différentes instances de circuit bruitées.\"\n"
"      href=\"/guides/error-mitigation-and-suppression-techniques#probabilistic-error-cancellation-pec\"\n"
"      analyticsName=\"Documentation page: PEC\"\n"
"      linkText=\"En savoir plus\"\n"
"    />\n"

#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"PEC with shaded lightcones\"\n"
"      description=\"A modified PEC technique that uses Pauli propagation to reduce the number of error terms accounted for in a noise model according to the specifics of the target observable.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-slc/\"\n"
"      analyticsName=\"Documentation page: Shaded lightcones\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
"    <Card\n"
"      title=\"Operator backpropagation (OBP)\"\n"
"      description=\"Uses a method based on Clifford perturbation theory to reduce circuit depth by trimming operations from its end at the cost of more operator measurements.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-obp/\"\n"
"      analyticsName=\"Documentation page: Operator backpropagation\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
"    <Card\n"
"      title=\"Propagated noise absorption (PNA)\"\n"
"      description=\"Technique for mitigating errors in observable expectation values by 'absorbing' the inverses of learned noise channels into an observable using Pauli propagation.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-pna/\"\n"
"      analyticsName=\"Documentation page: Propagated noise absorption\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
"</CardGroup>\n"
msgstr ""
"    <Card\n"
"      title=\"PEC avec cônes de lumière ombrés\"\n"
"      description=\"Une technique PEC modifiée qui utilise la propagation de Pauli pour réduire le nombre de termes d'erreur pris en compte dans un modèle de bruit selon les spécificités de l'observable cible.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-slc/\"\n"
"      analyticsName=\"Documentation page: Shaded lightcones\"\n"
"      linkText=\"Parcourir la documentation\"\n"
"    />\n"
"    <Card\n"
"      title=\"Rétropropagation d'opérateur (OBP)\"\n"
"      description=\"Utilise une méthode basée sur la théorie des perturbations de Clifford pour réduire la profondeur du circuit en supprimant des opérations de sa fin au prix de plus de mesures d'opérateurs.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-obp/\"\n"
"      analyticsName=\"Documentation page: Operator backpropagation\"\n"
"      linkText=\"Parcourir la documentation\"\n"
"    />\n"
"    <Card\n"
"      title=\"Absorption du bruit propagé (PNA)\"\n"
"      description=\"Technique d'atténuation des erreurs dans les valeurs d'espérance des observables en « absorbant » les inverses des canaux de bruit appris dans un observable à l'aide de la propagation de Pauli.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-pna/\"\n"
"      analyticsName=\"Documentation page: Propagated noise absorption\"\n"
"      linkText=\"Parcourir la documentation\"\n"
"    />\n"
"</CardGroup>\n"

#. type: Title ##
#, no-wrap
msgid "Error mitigation for sampling results {#error-mitigation-for-sampling-results}"
msgstr "Atténuation d'erreurs pour les résultats d'échantillonnage {#error-mitigation-for-sampling-results}"

#. type: Plain text
#, no-wrap
msgid ""
"<CardGroup>\n"
"    <Card\n"
"      title=\"Sample-based quantum diagonalization (SQD)\"\n"
"      description=\"Implements a technique for finding eigenvalues and eigenvectors of quantum operators, such as a quantum system Hamiltonian, using quantum and distributed classical computing together.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-sqd/\"\n"
"      analyticsName=\"Documentation page: SQD\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
msgstr ""
"<CardGroup>\n"
"    <Card\n"
"      title=\"Diagonalisation quantique basée sur des échantillons (SQD)\"\n"
"      description=\"Implémente une technique pour trouver les valeurs propres et les vecteurs propres des opérateurs quantiques, tels qu'un hamiltonien de système quantique, en utilisant le calcul quantique et le calcul classique distribué ensemble.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-sqd/\"\n"
"      analyticsName=\"Documentation page: SQD\"\n"
"      linkText=\"Parcourir la documentation\"\n"
"    />\n"

#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"SQD for HPC\"\n"
"      description=\"An HPC-ready implementation of the SQD addon. It is written in modern C++17 standards and is designed to create a single compiled binary for use with MPI.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-sqd-hpc/\"\n"
"      analyticsName=\"Documentation page: SQD for HPC\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
msgstr ""
"    <Card\n"
"      title=\"SQD pour HPC\"\n"
"      description=\"Une implémentation de l'addon SQD prête pour HPC. Elle est écrite en C++17 moderne et est conçue pour créer un binaire compilé unique pour une utilisation avec MPI.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-sqd-hpc/\"\n"
"      analyticsName=\"Documentation page: SQD for HPC\"\n"
"      linkText=\"Parcourir la documentation\"\n"
"    />\n"

#. type: Plain text
#, no-wrap
msgid ""
"    <Card\n"
"      title=\"Matrix-free Measurement Mitigation\"\n"
"      description=\"Matrix-free Measurement Mitigation (M3) is a package for scalable quantum measurement error mitigation that can be computed in parallel.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-mthree/\"\n"
"      analyticsName=\"Documentation page: M3\"\n"
"      linkText=\"Browse documentation\"\n"
"    />\n"
"</CardGroup>\n"
msgstr ""
"    <Card\n"
"      title=\"Atténuation de mesure sans matrice\"\n"
"      description=\"L'atténuation de mesure sans matrice (M3) est un package pour l'atténuation évolutive des erreurs de mesure quantique qui peut être calculé en parallèle.\"\n"
"      href=\"https://qiskit.github.io/qiskit-addon-mthree/\"\n"
"      analyticsName=\"Documentation page: M3\"\n"
"      linkText=\"Parcourir la documentation\"\n"
"    />\n"
"</CardGroup>\n"
