msgid "Save results to disk {#save-results-to-disk}"
msgstr "Sauvegarder les résultats sur disque {#save-results-to-disk}"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"You may also want to save results to disk. To do this, use Python's built-in"
" JSON library with encoders from Qiskit Runtime.\n"
msgstr ""
"Tu peux également vouloir sauvegarder les résultats sur disque. Pour ce "
"faire, utilise la bibliothèque JSON intégrée de Python avec les encodeurs de"
" Qiskit Runtime.\n"

