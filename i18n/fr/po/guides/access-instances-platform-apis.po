#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Use the IBM Cloud Resource Controller REST API to get, list, update, and create IBM Quantum Compute Service instances."
msgstr "Utilise l'API REST IBM Cloud Resource Controller pour obtenir, répertorier, mettre à jour et créer des instances IBM Quantum Compute Service."

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Use IBM Cloud Resource Controller API for instance management"
msgstr "Utiliser l'API IBM Cloud Resource Controller pour la gestion des instances"

# doq-bootstrap: positional
#. type: Plain text
#, fuzzy, no-wrap
#| msgid "{/* cspell:ignore ResourceController  */}\n"
msgid "{/* cspell:ignore Abluemix, apikey */}\n"
