#, no-wrap
msgid "How to use the Sampler primitive in Qiskit Runtime."
msgstr "Comment utiliser la primitive Sampler dans Qiskit Runtime."

#. type: Yaml Front Matter Hash Value: sidebar_label
#, no-wrap
msgid "Sampler quickstart"
msgstr "Démarrage rapide avec Sampler"

#. type: Plain text
#, markdown-text, no-wrap
msgid "<OpenInLabBanner notebookPath=\"guides/get-started-with-sampler.ipynb\" />\n"
