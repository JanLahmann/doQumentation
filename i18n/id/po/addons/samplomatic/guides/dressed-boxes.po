msgstr "Circuit yang akan di-twirl dengan Pauli.\n"

# doq: translated after an English change 2026-11-13
#. type: Plain text
#, no-wrap
msgid "This is achieved by stratifying the circuit into boxes and adding twirl annotations.\n"
msgstr "Ini dicapai dengan menstratifikasi circuit menjadi box dan menambahkan anotasi twirl.\n"

# doq: copied, nothing translatable
#. type: Plain text
#, no-wrap
