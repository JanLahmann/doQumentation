msgid "<span id=\"incorporate-samplomatic-s-pass-manager-into-qiskit-preset-pass-managers\" />\n"
msgstr ""

# doq: translated after an English change 2026-11-13
#. type: Title ##
#, no-wrap
msgid "Incorporate Samplomatic’s pass manager into Qiskit preset pass managers {#incorporate-samplomatics-pass-manager-into-qiskit-preset-pass-managers}"
msgstr "Menggabungkan pass manager Samplomatic ke preset pass manager Qiskit {#incorporate-samplomatics-pass-manager-into-qiskit-preset-pass-managers}"

# doq: translated after an English change 2026-11-13
#. type: Plain text
#, no-wrap
msgid "The code below shows how to incorporate [`generate_boxing_pass_manager()`](https://docs.quantum.ibm.com/api/samplomatic/auto/transpiler-generate-boxing-pass-manager#samplomatic.transpiler.generate_boxing_pass_manager \"samplomatic.transpiler.generate_boxing_pass_manager\") into a Qiskit preset pass manager. The transpiled circuit is ISA and contains boxes.\n"
msgstr "Kode di bawah ini menunjukkan cara menggabungkan [`generate_boxing_pass_manager()`](https://docs.quantum.ibm.com/api/samplomatic/auto/transpiler-generate-boxing-pass-manager#samplomatic.transpiler.generate_boxing_pass_manager \"samplomatic.transpiler.generate_boxing_pass_manager\") ke dalam preset pass manager Qiskit. Circuit hasil transpilasi berbentuk ISA dan berisi box.\n"

# doq: copied, nothing translatable
