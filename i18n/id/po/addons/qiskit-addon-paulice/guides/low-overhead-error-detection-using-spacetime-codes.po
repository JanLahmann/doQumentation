# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Low overhead error detection using spacetime codes"
msgstr "Deteksi error dengan overhead rendah menggunakan kode spacetime"

#. type: Plain text
