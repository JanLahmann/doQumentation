msgid "Zero-noise extrapolation with probabilistic error amplification for the latest version of Qiskit mitigation"
msgstr "Zero-noise extrapolation dengan probabilistic error amplification untuk Qiskit mitigation versi terbaru"

# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Zero-noise extrapolation with probabilistic error amplification"
msgstr "Zero-noise extrapolation dengan probabilistic error amplification"

#. type: Plain text
