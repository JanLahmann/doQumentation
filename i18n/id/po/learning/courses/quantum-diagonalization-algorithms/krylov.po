"\\end{equation*}\n"
"$$\n"
msgstr ""
"$$\n"
"\\begin{equation*}\n"
"    \\langle Y\\rangle = \\text{Im}\\Big[\\langle\\psi_j| P|\\psi_i\\rangle\\Big].\n"
