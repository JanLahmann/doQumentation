msgstr "Pelajaran 2: Diagonalisasi kuantum Krylov\n"

#. type: Bullet: '- '
#, no-wrap
msgid "Lesson 3: Sample-based quantum diagonalization\n"
msgstr "Pelajaran 3: Diagonalisasi kuantum berbasis sampling\n"

#. type: Bullet: '- '
#, no-wrap
msgid "Lesson 4: SQD application\n"
msgstr "Pelajaran 4: Aplikasi SQD\n"

#. type: Bullet: '- '
#, no-wrap
msgid "Lesson 5: Sample-based Krylov quantum diagonalization\n"
msgstr "Pelajaran 5: Diagonalisasi kuantum Krylov berbasis sampling\n"

