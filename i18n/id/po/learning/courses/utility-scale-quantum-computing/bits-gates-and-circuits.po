msgid "Exercise 2 {#exercise-2}"
msgstr "Latihan 2 {#exercise-2}"

#. type: Plain text
#, no-wrap
msgid "The GHZ state of an 8-qubit system is\n"
msgstr "Keadaan GHZ dari sistem 8-qubit adalah\n"

#. type: Plain text
#, no-wrap
msgid ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|00000000\\rangle + |11111111\\rangle)\n"
"$$\n"
msgstr ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|00000000\\rangle + |11111111\\rangle)\n"
"$$\n"

#. type: Plain text
#, no-wrap
