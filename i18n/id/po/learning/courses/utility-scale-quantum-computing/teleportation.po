"ingin Alice kirimkan ke Bob.\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "Qiskit pattern steps are identified in the code comments.\n"
msgstr "Langkah-langkah pola Qiskit diidentifikasi dalam komentar kode.\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"![Output of the previous code cell](/learning/images/courses/utility-scale-"
"quantum-computing/teleportation/extracted-"
"outputs/041f79eb-c516-4b54-ae23-b06bffd36336-0.avif)\n"
msgstr ""
"![Output of the previous code cell](/learning/images/courses/utility-scale-"
"quantum-computing/teleportation/extracted-"
"outputs/041f79eb-c516-4b54-ae23-b06bffd36336-0.avif)\n"

#. type: Plain text
#, markdown-text, no-wrap
