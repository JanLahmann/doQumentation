#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid ""
"Using Qiskit to implement ideas from the entanglement in action lesson."
msgstr ""
"Menggunakan Qiskit untuk mengimplementasikan ide-ide dari pelajaran "
"entanglement in action."

#. type: Yaml Front Matter Hash Value: sidebar_label
#, no-wrap
msgid "Qiskit implementation"
msgstr "Implementasi Qiskit"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"<OpenInLabBanner notebookPath=\"learning/courses/basics-of-quantum-"
"information/entanglement-in-action/qiskit-implementation.ipynb\" />\n"
msgstr ""
