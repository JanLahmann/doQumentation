# doq-bootstrap: positional
#. type: Title ####
#, markdown-text, no-wrap
msgid "4. Post-processing {#4-post-processing}"
msgstr "4. Pasca-pemrosesan {#4-post-processing}"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"Now we're ready to view our results! We'll display a histogram of the 100 "
"samples of the circuit.\n"
msgstr ""
"Sekarang kita siap melihat hasil kita! Kita akan menampilkan histogram dari "
"100 sampel Circuit.\n"

# doq-bootstrap: positional
