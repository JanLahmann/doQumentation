# doq-bootstrap: positional
#. type: Title ###
#, no-wrap
msgid "Broadcasting rules {#broadcasting-rules}"
msgstr "Aturan broadcasting {#broadcasting-rules}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "The PUBs aggregate elements from multiple arrays (observables and parameter values) by following the same broadcasting rules as NumPy. This section briefly summarizes those rules.  For a detailed explanation, see the [NumPy broadcasting rules documentation](https://numpy.org/doc/stable/user/basics.broadcasting.html).\n"
msgstr "PUB menggabungkan elemen dari beberapa array (observable dan nilai parameter) dengan mengikuti aturan broadcasting yang sama seperti NumPy. Bagian ini merangkum aturan-aturan tersebut secara singkat. Untuk penjelasan lebih rinci, lihat [dokumentasi aturan broadcasting NumPy](https://numpy.org/doc/stable/user/basics.broadcasting.html).\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "Rules:\n"
msgstr "Aturan:\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "Input arrays do not need to have the same number of dimensions.\n"
msgstr "Array input tidak perlu memiliki jumlah dimensi yang sama.\n"

# doq-bootstrap: positional
#. type: Bullet: '  * '
#, no-wrap
msgid "The resulting array will have the same number of dimensions as the input array with the largest dimension.\n"
msgstr "Array hasil akan memiliki jumlah dimensi yang sama dengan array input yang memiliki dimensi terbesar.\n"

# doq-bootstrap: positional
#. type: Bullet: '  * '
#, no-wrap
msgid "The size of each dimension is the largest size of the corresponding dimension.\n"
msgstr "Ukuran setiap dimensi adalah ukuran terbesar dari dimensi yang bersesuaian.\n"

# doq-bootstrap: positional
#. type: Bullet: '  * '
#, no-wrap
msgid "Missing dimensions are assumed to have size one.\n"
msgstr "Dimensi yang hilang diasumsikan berukuran satu.\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "Shape comparisons start with the rightmost dimension and continue to the left.\n"
msgstr "Perbandingan bentuk dimulai dari dimensi paling kanan dan berlanjut ke kiri.\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "Two dimensions are compatible if their sizes are equal or if one of them is 1.\n"
msgstr "Dua dimensi kompatibel jika ukurannya sama atau salah satunya adalah 1.\n"

