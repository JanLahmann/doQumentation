"  <TabItem value=\"SamplerV2\" label=\"Sampler V2\">\n"
msgstr ""
"{/*Verified 2/28 */}\n"
"<Tabs>\n"
"  <TabItem value=\"SamplerV2\" label=\"Sampler V2\">\n"

#. type: Plain text
