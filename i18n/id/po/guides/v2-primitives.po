"    ```text\n"
"            ┌───┐      ░ ┌─┐\n"
"       q_0: ┤ H ├──■───░─┤M├───\n"
"            └───┘┌─┴─┐ ░ └╥┘┌─┐\n"
"       q_1: ─────┤ X ├─░──╫─┤M├\n"
"                 └───┘ ░  ║ └╥┘\n"
"    meas: 2/══════════════╩══╩═\n"
"                          0  1\n"
"    ```\n"
msgstr ""
