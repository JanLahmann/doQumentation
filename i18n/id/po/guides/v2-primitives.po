#, markdown-text, no-wrap
msgid "Use sessions and advanced options {#use-sessions-and-advanced-options}"
msgstr ""
"Menggunakan sessions dan opsi lanjutan {#use-sessions-and-advanced-options}"

# doq-bootstrap: msgid repeated on page, first translation kept
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"Explore sessions and advanced options to optimize circuit performance on "
"QPUs.\n"
msgstr ""
"Jelajahi sessions dan opsi lanjutan untuk mengoptimalkan performa circuit di"
" QPU.\n"

# doq-bootstrap: msgid repeated on page, first translation kept
