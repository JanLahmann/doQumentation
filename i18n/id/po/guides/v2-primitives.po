#. type: Plain text
#, markdown-text, no-wrap
msgid "<span id=\"v2-prim-options\"></span>\n"
msgstr ""

#. type: Title ###
#, markdown-text, no-wrap
msgid "Options {#options}"
msgstr "Options {#options}"

#. type: Plain text
#, markdown-text, no-wrap
msgid "Options are specified differently in the V2 primitives in these ways:\n"
msgstr ""
"Options ditentukan secara berbeda di V2 primitives dengan cara-cara "
"berikut:\n"

#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid ""
"`SamplerV2` and `EstimatorV2` now have separate options classes. You can see"
" the available options and update option values during or after primitive "
"initialization.\n"
msgstr ""
"`SamplerV2` dan `EstimatorV2` sekarang punya kelas options terpisah. Kamu "
"bisa melihat options yang tersedia dan memperbarui nilai option selama atau "
"setelah inisialisasi primitive.\n"

#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid ""
"Instead of the `set_options()` method, V2 primitive options have the "
"`update()` method that applies changes to the `options` attribute.\n"
msgstr ""
"Alih-alih metode `set_options()`, V2 primitive options punya metode "
"`update()` yang menerapkan perubahan ke atribut `options`.\n"

#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid ""
"If you do not specify a value for an option, it is given a special value of "
"`Unset` and the server defaults are used.\n"
msgstr ""
"Kalau kamu tidak menentukan nilai untuk sebuah option, option tersebut "
"diberi nilai khusus `Unset` dan default server yang digunakan.\n"

#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid ""
"For V2 primitives, the `options` attribute is the `dataclass` Python type.  "
"You can use the built-in `asdict` method to convert it to a dictionary.\n"
msgstr ""
"Untuk V2 primitives, atribut `options` adalah tipe Python `dataclass`. Kamu "
"bisa menggunakan metode bawaan `asdict` untuk mengonversinya ke "
"dictionary.\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"See the [API reference](https://docs.quantum.ibm.com/api/qiskit-ibm-"
"runtime/options) for the list of available options.\n"
msgstr ""
"Lihat [referensi API](https://docs.quantum.ibm.com/api/qiskit-ibm-"
"runtime/options) untuk daftar options yang tersedia.\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "{/*Verified EstimatorV2. 2/23 */}\n"
msgstr "{/*Verified EstimatorV2. 2/23 */}\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"    ```python\n"
"from dataclasses import asdict\n"
"from qiskit_ibm_runtime import QiskitRuntimeService\n"
"from qiskit_ibm_runtime import EstimatorV2 as Estimator\n"
msgstr ""
"    ```python\n"
"from dataclasses import asdict\n"
"from qiskit_ibm_runtime import QiskitRuntimeService\n"
"from qiskit_ibm_runtime import EstimatorV2 as Estimator\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"service = QiskitRuntimeService()\n"
"backend = service.least_busy(operational=True, simulator=False)\n"
msgstr ""
"service = QiskitRuntimeService()\n"
"backend = service.least_busy(operational=True, simulator=False)\n"

#. type: Title #
#, markdown-text, no-wrap
msgid "Setting options during primitive initialization"
msgstr "Setting options during primitive initialization"

#. type: Plain text
#, markdown-text, no-wrap
msgid "estimator = Estimator(backend, options={\"resilience_level\": 2})\n"
msgstr "estimator = Estimator(backend, options={\"resilience_level\": 2})\n"

#. type: Title #
#, markdown-text, no-wrap
msgid "Setting options after primitive initialization"
msgstr "Setting options after primitive initialization"

#. type: Title #
#, markdown-text, no-wrap
msgid "This uses auto complete."
msgstr "This uses auto complete."

#. type: Plain text
#, markdown-text, no-wrap
msgid "estimator.options.default_shots = 4000\n"
msgstr "estimator.options.default_shots = 4000\n"

#. type: Title #
#, markdown-text, no-wrap
msgid "This does bulk update."
msgstr "This does bulk update."

#. type: Plain text
#, markdown-text, no-wrap
msgid "estimator.options.update(default_shots=4000, resilience_level=2)\n"
msgstr "estimator.options.update(default_shots=4000, resilience_level=2)\n"

#. type: Title #
#, markdown-text, no-wrap
msgid "Print the dictionary format."
msgstr "Print the dictionary format."

#. type: Title #
#, markdown-text, no-wrap
msgid "Server defaults are used for unset options."
msgstr "Server defaults are used for unset options."

#. type: Plain text
#, markdown-text, no-wrap
msgid "print(asdict(estimator.options))\n"
msgstr "print(asdict(estimator.options))\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"    ```python\n"
"from dataclasses import asdict\n"
"from qiskit_ibm_runtime import QiskitRuntimeService\n"
"from qiskit_ibm_runtime import SamplerV2 as Sampler\n"
msgstr ""
"    ```python\n"
"from dataclasses import asdict\n"
"from qiskit_ibm_runtime import QiskitRuntimeService\n"
"from qiskit_ibm_runtime import SamplerV2 as Sampler\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "sampler = Sampler(backend, options={\"default_shots\": 4096})\n"
msgstr "sampler = Sampler(backend, options={\"default_shots\": 4096})\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "sampler.options.dynamical_decoupling.enable = True\n"
msgstr "sampler.options.dynamical_decoupling.enable = True\n"

#. type: Title #
#, markdown-text, no-wrap
msgid "Turn on gate twirling. Requires qiskit_ibm_runtime 0.23.0 or later."
msgstr "Turn on gate twirling. Requires qiskit_ibm_runtime 0.23.0 or later."

#. type: Plain text
#, markdown-text, no-wrap
msgid "sampler.options.twirling.enable_gates = True\n"
msgstr "sampler.options.twirling.enable_gates = True\n"

#. type: Title #
#, markdown-text, no-wrap
msgid "The value for default_shots is overridden "
msgstr "The value for default_shots is overridden "

#. type: Title #
#, markdown-text, no-wrap
msgid "if you specify shots with run() or in the PUB."
msgstr "if you specify shots with run() or in the PUB."

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"sampler.options.update(default_shots=1024, \n"
"  dynamical_decoupling={\"sequence_type\": \"XpXm\"})\n"
msgstr ""
"sampler.options.update(default_shots=1024, \n"
"  dynamical_decoupling={\"sequence_type\": \"XpXm\"})\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "print(asdict(sampler.options))\n"
msgstr "print(asdict(sampler.options))\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "<span id=\"error-mit\"></span>\n"
msgstr "<span id=\"error-mit\"></span>\n"

#. type: Title ###
#, markdown-text, no-wrap
msgid "Error mitigation and suppression {#error-mitigation-and-suppression}"
msgstr "Mitigasi dan supresi error {#error-mitigation-and-suppression}"

#. type: Bullet: '* '
#, markdown-text, no-wrap
msgid ""
"Because Sampler V2 returns samples without postprocessing, it does not "
"support resilience levels.\n"
msgstr ""
"Karena Sampler V2 mengembalikan sampel tanpa postprocessing, ia tidak "
"mendukung resilience levels.\n"

#. type: Bullet: '* '
#, markdown-text, no-wrap
msgid "Sampler V2 does not support `optimization_level`.\n"
msgstr "Sampler V2 tidak mendukung `optimization_level`.\n"

#. type: Bullet: '* '
#, markdown-text, no-wrap
msgid ""
"Estimator V2 will drop support for `optimization_level` on or around 30 "
"September 2024.\n"
msgstr ""
"Estimator V2 akan menghentikan dukungan untuk `optimization_level` pada atau"
" sekitar 30 September 2024.\n"

#. type: Bullet: '* '
#, markdown-text, no-wrap
msgid ""
"Estimator V2 does not support resilience level 3.  This is because "
"resilience level 3 in V1 Estimator uses Probabilistic Error Cancellation "
"(PEC), which is proven to give unbiased results at the cost of exponential "
"processing time. Level 3 was removed to draw attention to that tradeoff. You"
" can, however, still use PEC as the error mitigation method by specifying "
"the `pec_mitigation` option.\n"
msgstr ""
"Estimator V2 tidak mendukung resilience level 3. Ini karena resilience level"
" 3 di V1 Estimator menggunakan Probabilistic Error Cancellation (PEC), yang "
"terbukti memberikan hasil yang tidak bias dengan biaya waktu pemrosesan "
"eksponensial. Level 3 dihapus untuk menarik perhatian pada trade-off "
"tersebut. Namun, kamu tetap bisa menggunakan PEC sebagai metode mitigasi "
"error dengan menentukan option `pec_mitigation`.\n"

#. type: Bullet: '* '
#, markdown-text, no-wrap
msgid ""
"Estimator V2 supports `resilience_level` 0-2, as described in the following "
"table.  These options are more advanced than their V1 counterparts. You can "
"also explicitly turn on / off individual error mitigation / suppression "
"methods.\n"
msgstr ""
"Estimator V2 mendukung `resilience_level` 0-2, sebagaimana dijelaskan dalam "
"tabel berikut. Options ini lebih canggih dari rekan-rekan V1-nya. Kamu juga "
"bisa secara eksplisit mengaktifkan/menonaktifkan metode mitigasi/supresi "
"error individual.\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"    | Level 1                   | Level 2                   |\n"
"    |---------------------------|---------------------------|\n"
"    | Measurement twirling      | Measurement twirling      |\n"
"    | Readout error mitigation  | Readout error mitigation  |\n"
"    |                           | ZNE                       |\n"
msgstr ""
"    | Level 1                        | Level 2                        |\n"
"    |--------------------------------|--------------------------------|\n"
"    | Measurement twirling           | Measurement twirling           |\n"
"    | Mitigasi readout error         | Mitigasi readout error         |\n"
"    |                                | ZNE                            |\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "estimator = Estimator(backend)\n"
msgstr "estimator = Estimator(backend)\n"

#. type: Title #
#, markdown-text, no-wrap
msgid "Set resilience_level to 0"
msgstr "Set resilience_level to 0"

#. type: Plain text
#, markdown-text, no-wrap
msgid "estimator.options.resilience_level = 0\n"
msgstr "estimator.options.resilience_level = 0\n"

#. type: Title #
#, markdown-text, no-wrap
msgid "Turn on measurement error mitigation"
msgstr "Turn on measurement error mitigation"

#. type: Plain text
#, markdown-text, no-wrap
msgid "estimator.options.resilience.measure_mitigation = True\n"
msgstr "estimator.options.resilience.measure_mitigation = True\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "sampler = Sampler(backend)\n"
msgstr "sampler = Sampler(backend)\n"

#. type: Title #
#, markdown-text, no-wrap
msgid "Turn on dynamical decoupling with sequence XpXm."
msgstr "Turn on dynamical decoupling with sequence XpXm."

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"sampler.options.dynamical_decoupling.enable = True\n"
"sampler.options.dynamical_decoupling.sequence_type = \"XpXm\"\n"
msgstr ""
"sampler.options.dynamical_decoupling.enable = True\n"
"sampler.options.dynamical_decoupling.sequence_type = \"XpXm\"\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"print(f\">> dynamical decoupling sequence to use: \"\n"
"f\"{sampler.options.dynamical_decoupling.sequence_type}\")\n"
msgstr ""
"print(f\">> dynamical decoupling sequence to use: \"\n"
"f\"{sampler.options.dynamical_decoupling.sequence_type}\")\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "<span id=\"transpilation\"></span>\n"
msgstr "<span id=\"transpilation\"></span>\n"

#. type: Title ###
#, markdown-text, no-wrap
msgid "Transpilation {#transpilation}"
msgstr "Transpilation {#transpilation}"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"V2 primitives support only circuits that adhere to the Instruction Set "
"Architecture (ISA) of a particular backend. Because the primitives do not "
"perform layout, routing, and translation operations, the corresponding "
"transpilation options from V1 are not supported.\n"
msgstr ""
"V2 primitives hanya mendukung circuit yang mengikuti Instruction Set "
"Architecture (ISA) dari backend tertentu. Karena primitives tidak melakukan "
"operasi layout, routing, dan translation, option transpilasi yang terkait "
"dari V1 tidak didukung.\n"

#. type: Title ###
#, markdown-text, no-wrap
msgid "Job status {#job-status}"
msgstr "Status job {#job-status}"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"The V2 primitives have a new `RuntimeJobV2` class, which inherits from "
"`BasePrimitiveJob`. The `status()` method of this new class returns a string"
" instead of a JobStatus enum from Qiskit. See the [RuntimeJobV2 API "
"reference](https://docs.quantum.ibm.com/api/qiskit-ibm-runtime/runtime-"
"job-v2) for details.\n"
msgstr ""
"V2 primitives punya kelas `RuntimeJobV2` baru, yang mewarisi dari "
"`BasePrimitiveJob`. Metode `status()` dari kelas baru ini mengembalikan "
"string alih-alih enum JobStatus dari Qiskit. Lihat [referensi API "
"RuntimeJobV2](https://docs.quantum.ibm.com/api/qiskit-ibm-runtime/runtime-"
"job-v2) untuk detailnya.\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"<Tabs>\n"
"  <TabItem value=\"V2\" label=\"V2 primitives\">\n"
msgstr ""
"<Tabs>\n"
"  <TabItem value=\"V2\" label=\"V2 primitives\">\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "  <TabItem value=\"V1\" label=\"V1 primitives\">\n"
msgstr "  <TabItem value=\"V1\" label=\"V1 primitives\">\n"

#. type: Title ##
#, markdown-text, no-wrap
msgid "Steps to migrate to Estimator V2 {#steps-to-migrate-to-estimator-v2}"
msgstr ""
"Langkah-langkah migrasi ke Estimator V2 {#steps-to-migrate-to-estimator-v2}"

#. type: Bullet: '1. '
#, markdown-text, no-wrap
msgid ""
"Replace `from qiskit_ibm_runtime import Estimator` with `from "
"qiskit_ibm_runtime import EstimatorV2 as Estimator`.\n"
msgstr ""
"Ganti `from qiskit_ibm_runtime import Estimator` dengan `from "
"qiskit_ibm_runtime import EstimatorV2 as Estimator`.\n"

#. type: Bullet: '2. '
#, markdown-text, no-wrap
msgid ""
"Remove any `from qiskit_ibm_runtime import Options` statements, since the "
"`Options` class is not used by V2 primitives. You can instead pass options "
"as a dictionary when initializing the `EstimatorV2` class (for example "
"`estimator = Estimator(backend, options={“dynamical_decoupling”: {“enable”: "
"True}})`), or set them after initialization:\n"
msgstr ""
"Hapus semua statement `from qiskit_ibm_runtime import Options`, karena kelas"
" `Options` tidak digunakan oleh V2 primitives. Sebagai gantinya kamu bisa "
"mengoper options sebagai dictionary saat menginisialisasi kelas "
"`EstimatorV2` (misalnya `estimator = Estimator(backend, "
"options={\"dynamical_decoupling\": {\"enable\": True}})`), atau mengaturnya "
"setelah inisialisasi:\n"

# doq-bootstrap: msgid repeated on page, first translation kept
#. type: Bullet: '3. '
#, markdown-text, no-wrap
msgid ""
"Review all the [supported options](https://docs.quantum.ibm.com/api/qiskit-"
"ibm-runtime/options) and make updates accordingly.\n"
msgstr ""
"Tinjau semua [options yang "
"didukung](https://docs.quantum.ibm.com/api/qiskit-ibm-runtime/options) dan "
"lakukan pembaruan yang diperlukan.\n"

#. type: Bullet: '4. '
#, markdown-text, no-wrap
msgid ""
"Group each circuit you want to run with the observables and parameter values"
" you want to apply to the circuit in a tuple (a PUB). For example, use "
"`(circuit1, observable1, parameter_set1)` if you want to run `circuit1` with"
" `observable1` and `parameter_set1`.\n"
msgstr ""
"Kelompokkan setiap circuit yang ingin kamu jalankan dengan observables dan "
"nilai parameter yang ingin kamu terapkan pada circuit tersebut dalam sebuah "
"tuple (sebuah PUB). Misalnya, gunakan `(circuit1, observable1, "
"parameter_set1)` jika kamu ingin menjalankan `circuit1` dengan `observable1`"
" dan `parameter_set1`.\n"

#. type: Bullet: '  1. '
#, markdown-text, no-wrap
msgid ""
"You might need to reshape your arrays of observables or parameter sets if "
"you want to apply their outer product. For example, an array of observables "
"of shape (4, 1) and an array of parameter sets of shape (1, 6) will give you"
" a result of (4, 6) expectation values. See the [Numpy broadcasting "
"rules](https://numpy.org/doc/stable/user/basics.broadcasting.html) for more "
"details.\n"
msgstr ""
"Kamu mungkin perlu me-reshape array observables atau parameter sets jika "
"ingin menerapkan outer product-nya. Misalnya, array observables berbentuk "
"(4, 1) dan array parameter sets berbentuk (1, 6) akan menghasilkan (4, 6) "
"expectation values. Lihat [aturan broadcasting "
"Numpy](https://numpy.org/doc/stable/user/basics.broadcasting.html) untuk "
"detailnya.\n"

#. type: Bullet: '  2. '
#, markdown-text, no-wrap
msgid ""
"You can optionally specify the precision you want for that specific PUB.\n"
msgstr ""
"Kamu bisa secara opsional menentukan presisi yang kamu inginkan untuk PUB "
"tertentu tersebut.\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"5. Update Estimator's `run()` method to pass in the list of PUBs. For example, `run([(circuit1, observable1, parameter_set1)])`.\n"
"  You can optionally specify a `precision` here, which would apply to all PUBs.\n"
"6. Estimator V2 job results are grouped by PUBs. You can see the expectation value and standard error for each PUB by indexing to it. For example:\n"
msgstr ""
"5. Perbarui metode `run()` estimator untuk mengoper daftar PUB. Misalnya, `run([(circuit1, observable1, parameter_set1)])`.\n"
"  Kamu bisa secara opsional menentukan `precision` di sini, yang akan berlaku untuk semua PUB.\n"
"6. Hasil job Estimator V2 dikelompokkan berdasarkan PUB. Kamu bisa melihat expectation value dan standard error untuk setiap PUB dengan mengindeksnya. Misalnya:\n"

#. type: Title ##
#, markdown-text, no-wrap
msgid "Estimator full examples {#estimator-full-examples}"
msgstr "Contoh lengkap Estimator {#estimator-full-examples}"

#. type: Title ###
#, markdown-text, no-wrap
msgid "Run a single experiment {#run-a-single-experiment}"
msgstr "Menjalankan satu eksperimen {#run-a-single-experiment}"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"Use Estimator to determine the expectation value of a single circuit-"
"observable pair.\n"
msgstr ""
"Gunakan Estimator untuk menentukan nilai ekspektasi dari satu pasangan "
"circuit-observable.\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"    ```python\n"
"import numpy as np\n"
"from qiskit.circuit.library import IQP\n"
"from qiskit.quantum_info import SparsePauliOp, random_hermitian\n"
"from qiskit_ibm_runtime import EstimatorV2 as Estimator, QiskitRuntimeService\n"
msgstr ""
"    ```python\n"
"import numpy as np\n"
"from qiskit.circuit.library import IQP\n"
"from qiskit.quantum_info import SparsePauliOp, random_hermitian\n"
"from qiskit_ibm_runtime import EstimatorV2 as Estimator, QiskitRuntimeService\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"service = QiskitRuntimeService()\n"
"backend = service.least_busy(operational=True, \n"
"  simulator=False, min_num_qubits=127)\n"
"estimator = Estimator(backend)\n"
msgstr ""
"service = QiskitRuntimeService()\n"
"backend = service.least_busy(operational=True, \n"
"  simulator=False, min_num_qubits=127)\n"
"estimator = Estimator(backend)\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "n_qubits = 127\n"
msgstr "n_qubits = 127\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"mat = np.real(random_hermitian(n_qubits, seed=1234))\n"
"circuit = IQP(mat)\n"
"observable = SparsePauliOp(\"Z\" * n_qubits)\n"
msgstr ""
"mat = np.real(random_hermitian(n_qubits, seed=1234))\n"
"circuit = IQP(mat)\n"
"observable = SparsePauliOp(\"Z\" * n_qubits)\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"pm = generate_preset_pass_manager(optimization_level=1, backend=backend)\n"
"isa_circuit = pm.run(circuit)\n"
"isa_observable = observable.apply_layout(isa_circuit.layout)\n"
msgstr ""
"pm = generate_preset_pass_manager(optimization_level=1, backend=backend)\n"
"isa_circuit = pm.run(circuit)\n"
"isa_observable = observable.apply_layout(isa_circuit.layout)\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"job = estimator.run([(isa_circuit, isa_observable)])\n"
"result = job.result()\n"
msgstr ""
"job = estimator.run([(isa_circuit, isa_observable)])\n"
"result = job.result()\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"print(f\" > Expectation value: {result[0].data.evs}\")\n"
"print(f\" > Metadata: {result[0].metadata}\")\n"
msgstr ""
"print(f\" > Expectation value: {result[0].data.evs}\")\n"
"print(f\" > Metadata: {result[0].metadata}\")\n"

#. type: Title ###
#, markdown-text, no-wrap
msgid ""
"Run multiple experiments in a single job {#run-multiple-experiments-in-a-"
"single-job}"
msgstr ""
"Menjalankan beberapa eksperimen dalam satu job {#run-multiple-experiments-"
"in-a-single-job}"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"Use Estimator to determine the expectation values of multiple circuit-"
"observable pairs.\n"
msgstr ""
"Gunakan Estimator untuk menentukan nilai ekspektasi dari beberapa pasangan "
"circuit-observable.\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "  <TabItem value=\"EstimatorV1\" label=\"Estimator (V1)\">\n"
msgstr "  <TabItem value=\"EstimatorV1\" label=\"Estimator (V1)\">\n"

#. type: Title ###
#, markdown-text, no-wrap
msgid "Run parameterized circuits {#run-parameterized-circuits}"
msgstr "Menjalankan circuit terparameterisasi {#run-parameterized-circuits}"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"Use Estimator to run multiple experiments in a single job, leveraging "
"parameter values to increase circuit reusability. In the following example, "
"notice that steps 1 and 2 are the same for V1 and V2.\n"
msgstr ""
"Gunakan Estimator untuk menjalankan beberapa eksperimen dalam satu job, "
"dengan memanfaatkan nilai parameter untuk meningkatkan kemampuan reuse "
"circuit. Pada contoh berikut, perhatikan bahwa langkah 1 dan 2 sama untuk V1"
" maupun V2.\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"    ```python\n"
"import numpy as np\n"
msgstr ""
"    ```python\n"
"import numpy as np\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"from qiskit.circuit import QuantumCircuit, Parameter\n"
"from qiskit.quantum_info import SparsePauliOp\n"
"from qiskit.transpiler.preset_passmanagers import generate_preset_pass_manager\n"
"from qiskit_ibm_runtime import QiskitRuntimeService\n"
msgstr ""
"from qiskit.circuit import QuantumCircuit, Parameter\n"
"from qiskit.quantum_info import SparsePauliOp\n"
"from qiskit.transpiler.preset_passmanagers import generate_preset_pass_manager\n"
"from qiskit_ibm_runtime import QiskitRuntimeService\n"

#. type: Title #
#, markdown-text, no-wrap
msgid "Step 1: Map classical inputs to a quantum problem"
msgstr "Step 1: Map classical inputs to a quantum problem"

#. type: Plain text
#, markdown-text, no-wrap
msgid "theta = Parameter(\"θ\")\n"
msgstr "theta = Parameter(\"θ\")\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"chsh_circuit = QuantumCircuit(2)\n"
"chsh_circuit.h(0)\n"
"chsh_circuit.cx(0, 1)\n"
"chsh_circuit.ry(theta, 0)\n"
msgstr ""
"chsh_circuit = QuantumCircuit(2)\n"
"chsh_circuit.h(0)\n"
"chsh_circuit.cx(0, 1)\n"
"chsh_circuit.ry(theta, 0)\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"number_of_phases = 21\n"
"phases = np.linspace(0, 2 * np.pi, number_of_phases)\n"
"individual_phases = [[ph] for ph in phases]\n"
msgstr ""
"number_of_phases = 21\n"
"phases = np.linspace(0, 2 * np.pi, number_of_phases)\n"
"individual_phases = [[ph] for ph in phases]\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"ZZ = SparsePauliOp.from_list([(\"ZZ\", 1)])\n"
"ZX = SparsePauliOp.from_list([(\"ZX\", 1)])\n"
"XZ = SparsePauliOp.from_list([(\"XZ\", 1)])\n"
"XX = SparsePauliOp.from_list([(\"XX\", 1)])\n"
"ops = [ZZ, ZX, XZ, XX]\n"
msgstr ""
"ZZ = SparsePauliOp.from_list([(\"ZZ\", 1)])\n"
"ZX = SparsePauliOp.from_list([(\"ZX\", 1)])\n"
"XZ = SparsePauliOp.from_list([(\"XZ\", 1)])\n"
"XX = SparsePauliOp.from_list([(\"XX\", 1)])\n"
"ops = [ZZ, ZX, XZ, XX]\n"

#. type: Title #
#, markdown-text, no-wrap
msgid "Step 2: Optimize problem for quantum execution."
msgstr "Step 2: Optimize problem for quantum execution."

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"pm = generate_preset_pass_manager(backend=backend, optimization_level=1)\n"
"chsh_isa_circuit = pm.run(chsh_circuit)\n"
"isa_observables = [operator.apply_layout(chsh_isa_circuit.layout) \n"
"  for operator in ops]\n"
msgstr ""
"pm = generate_preset_pass_manager(backend=backend, optimization_level=1)\n"
"chsh_isa_circuit = pm.run(chsh_circuit)\n"
"isa_observables = [operator.apply_layout(chsh_isa_circuit.layout) \n"
"  for operator in ops]\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid "from qiskit_ibm_runtime import EstimatorV2 as Estimator\n"
msgstr "from qiskit_ibm_runtime import EstimatorV2 as Estimator\n"

#. type: Title #
#, markdown-text, no-wrap
msgid "Step 3: Execute using Qiskit primitives."
msgstr "Step 3: Execute using Qiskit primitives."

#. type: Title #
#, markdown-text, no-wrap
msgid "Reshape observable array for broadcasting"
msgstr "Reshape observable array for broadcasting"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"reshaped_ops = np.fromiter(isa_observables, dtype=object)\n"
"reshaped_ops = reshaped_ops.reshape((4, 1))\n"
msgstr ""
"reshaped_ops = np.fromiter(isa_observables, dtype=object)\n"
"reshaped_ops = reshaped_ops.reshape((4, 1))\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"estimator = Estimator(backend, options={\"default_shots\": int(1e4)})\n"
"job = estimator.run([(chsh_isa_circuit, reshaped_ops, individual_phases)])\n"
msgstr ""
"estimator = Estimator(backend, options={\"default_shots\": int(1e4)})\n"
"job = estimator.run([(chsh_isa_circuit, reshaped_ops, individual_phases)])\n"

#. type: Title #
#, markdown-text, no-wrap
msgid "Get results for the first (and only) PUB"
msgstr "Get results for the first (and only) PUB"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"pub_result = job.result()[0]\n"
"print(f\">>> Expectation values: {pub_result.data.evs}\")\n"
"print(f\">>> Standard errors: {pub_result.data.stds}\")\n"
"print(f\">>> Metadata: {pub_result.metadata}\")\n"
msgstr ""
"pub_result = job.result()[0]\n"
"print(f\">>> Expectation values: {pub_result.data.evs}\")\n"
"print(f\">>> Standard errors: {pub_result.data.stds}\")\n"
"print(f\">>> Metadata: {pub_result.metadata}\")\n"

