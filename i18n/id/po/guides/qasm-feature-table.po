# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "Below is a list of the `OpenQASM 3` language features.\n"
msgstr "Berikut adalah daftar fitur bahasa `OpenQASM 3`.\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "For more details on these capabilities, see the [OpenQASM 3.X Live Specification](https://openqasm.com/).\n"
msgstr "Untuk detail lebih lanjut tentang kemampuan-kemampuan ini, lihat [Spesifikasi Langsung OpenQASM 3.X](https://openqasm.com/).\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "Key:\n"
msgstr "Keterangan:\n"

