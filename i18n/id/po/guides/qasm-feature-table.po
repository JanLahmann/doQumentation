#. type: Bullet: '*   '
#, no-wrap
msgid "❌ Not supported\n"
msgstr "❌ Tidak didukung\n"

# doq-bootstrap: positional
#. type: Bullet: '*   '
#, no-wrap
msgid "🟡 Partial support\n"
msgstr "🟡 Dukungan sebagian\n"

# doq-bootstrap: positional
