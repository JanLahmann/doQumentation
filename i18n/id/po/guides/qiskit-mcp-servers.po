msgid ""
"Use Qiskit MCP Servers to integrate quantum computing capabilities into AI "
"assistants and agents."
msgstr ""
"Gunakan Qiskit MCP Servers untuk mengintegrasikan kemampuan komputasi "
"kuantum ke dalam asisten AI dan agen."

