#, no-wrap
msgid "Step 2. Change the imports {#step-2-change-the-imports}"
msgstr "Langkah 2. Ubah import {#step-2-change-the-imports}"

# doq: copied, nothing translatable
#. type: Plain text
#, no-wrap
msgid "**Sampler:**\n"
msgstr "**Sampler:**\n"

