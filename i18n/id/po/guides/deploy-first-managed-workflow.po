# doq: translated after an English change 2026-11-12
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Deploy your first managed workflow"
msgstr "Deploy managed workflow pertamamu"

#. type: Plain text
#, no-wrap
