# doq: translated after an English change 2026-11-12
#. type: Title ###
#, no-wrap
msgid "1. Define the problem {#1-define-the-problem}"
msgstr "1. Definisikan masalahnya {#1-define-the-problem}"

# doq: translated after an English change 2026-11-12
#. type: Plain text
#, no-wrap
msgid "The observable list measures the spin-up occupation\n"
msgstr "List observable mengukur okupansi spin-up\n"

# doq: copied, nothing translatable
#. type: Plain text
#, no-wrap
msgid ""
"$$\n"
"\\langle n_{i\\uparrow} \\rangle\n"
"$$\n"
msgstr ""
"$$\n"
"\\langle n_{i\\uparrow} \\rangle\n"
"$$\n"

# doq: translated after an English change 2026-11-12
#. type: Plain text
