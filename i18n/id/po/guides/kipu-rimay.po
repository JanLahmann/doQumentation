# doq: translated after an English change 2026-11-12
#. type: Plain text
#, no-wrap
msgid "Rimay is a Quechua word that means \"to explain\".\n"
msgstr "Rimay adalah kata dalam bahasa Quechua yang artinya \"menjelaskan\".\n"
