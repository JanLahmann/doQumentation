# doq-bootstrap: positional
#. type: Title #####
#, markdown-text, no-wrap
msgid "Run the Qiskit Code Assistant model manually downloaded in Ollama"
msgstr ""
"Menjalankan model Qiskit Code Assistant yang diunduh secara manual di Ollama"
" {#run-the-qiskit-code-assistant-model-manually-downloaded-in-ollama}"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"After the `Qwen2.5-Coder-14B-Qiskit` model has been set up in Ollama, run "
"the following command to launch the model and interact with it in the "
"terminal (in chat mode).\n"
msgstr ""
"Setelah model `Qwen2.5-Coder-14B-Qiskit` sudah disiapkan di Ollama, jalankan"
" perintah berikut untuk meluncurkan model dan berinteraksi dengannya di "
"terminal (dalam mode chat).\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "from llama_cpp import Llama\n"
msgstr "from llama_cpp import Llama\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "model_path = <PATH-TO-GGUF-FILE>\n"
msgstr "model_path = <PATH-TO-GGUF-FILE>\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"model = Llama(\n"
"        model_path,\n"
"        seed=17,\n"
"        n_ctx=10000,\n"
"        n_gpu_layers=37, # to offload in gpu, but put 0 if all in cpu\n"
"    )\n"
msgstr ""
"model = Llama(\n"
"        model_path,\n"
"        seed=17,\n"
"        n_ctx=10000,\n"
"        n_gpu_layers=37, # to offload in gpu, but put 0 if all in cpu\n"
"    )\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"input = 'Generate a quantum circuit with 2 qubits'\n"
"raw_pred = model(input)[\"choices\"][0][\"text\"]\n"
msgstr ""
"input = 'Generate a quantum circuit with 2 qubits'\n"
"raw_pred = model(input)[“choices”][0][“text”]\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"generation_kwargs = {\n"
"        \"max_tokens\": 512,\n"
"        \"echo\": False, # Echo the prompt in the output\n"
"        \"top_k\": 1\n"
"    }\n"
msgstr ""
"generation_kwargs = {\n"
"        “max_tokens”: 512,\n"
"        “echo”: False, # Echo the prompt in the output\n"
"        “top_k”: 1\n"
"    }\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "raw_pred = model(input, **generation_kwargs)[\"choices\"][0][\"text\"]\n"
msgstr "raw_pred = model(input, **generation_kwargs)[“choices”][0][“text”]\n"

