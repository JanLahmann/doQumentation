msgid "Certain runtime features cannot be used together in a single job. Click the appropriate tab for a list of features that are incompatible with the selected feature:\n"
msgstr "Fitur-fitur Runtime tertentu tidak bisa digunakan bersama dalam satu job. Klik tab yang sesuai untuk daftar fitur yang tidak kompatibel dengan fitur yang dipilih:\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"<Accordion>\n"
"  <AccordionItem title=\"Fractional gates\">\n"
"    Incompatible with:\n"
"  - Gate twirling\n"
"  - PEA\n"
"  - PEC\n"
"  </AccordionItem>\n"
"  <AccordionItem title=\"Gate-folding ZNE\">\n"
"    Might not work when using custom gates. Incompatible with:\n"
"  - PEA\n"
"  - PEC\n"
"  </AccordionItem>\n"
"  <AccordionItem title=\"Gate twirling\">\n"
"    Incompatible with:\n"
"  - Fractional gates\n"
"  - Stretches\n"
msgstr ""
"<Accordion>\n"
"  <AccordionItem title=\"Gate fraksional\">\n"
"    Tidak kompatibel dengan:\n"
"  - Gate twirling\n"
"  - PEA\n"
"  - PEC\n"
"  </AccordionItem>\n"
"  <AccordionItem title=\"Gate-folding ZNE\">\n"
"    Mungkin tidak bekerja saat menggunakan gate kustom. Tidak kompatibel dengan:\n"
"  - PEA\n"
"  - PEC\n"
"  </AccordionItem>\n"
"  <AccordionItem title=\"Gate twirling\">\n"
"    Tidak kompatibel dengan:\n"
"  - Gate fraksional\n"
"  - Stretches\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"  Other notes:\n"
"  - Measurement twirling can only be applied to terminal measurements.\n"
"  - Does not work with non-Clifford entanglers.\n"
"  </AccordionItem>\n"
"  <AccordionItem title=\"PEA\">\n"
"    Incompatible with:\n"
"  - Fractional gates\n"
"  - Gate-folding ZNE\n"
"  - PEC\n"
"  </AccordionItem>\n"
"  <AccordionItem title=\"PEC\">\n"
"    Incompatible with:\n"
"  - Fractional gates\n"
"  - Gate-folding ZNE\n"
"  - PEA\n"
"  </AccordionItem>\n"
"</Accordion>\n"
msgstr ""
"  Catatan lain:\n"
"  - Measurement twirling hanya bisa diterapkan ke pengukuran terminal.\n"
"  - Tidak bekerja dengan entangler non-Clifford.\n"
"  </AccordionItem>\n"
"  <AccordionItem title=\"PEA\">\n"
"    Tidak kompatibel dengan:\n"
"  - Gate fraksional\n"
"  - Gate-folding ZNE\n"
"  - PEC\n"
"  </AccordionItem>\n"
"  <AccordionItem title=\"PEC\">\n"
"    Tidak kompatibel dengan:\n"
"  - Gate fraksional\n"
"  - Gate-folding ZNE\n"
"  - PEA\n"
"  </AccordionItem>\n"
"</Accordion>\n"

