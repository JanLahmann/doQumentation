"    <Tabs>\n"
"    <TabItem value=\"Invalid\" label=\"Invalid\">\n"
msgstr ""
"- Maksimal satu variabel stretch per _qubit set_ di antara barrier (implisit dan eksplisit). Qubit set adalah satu atau lebih Qubit; set-set ini harus saling eksklusif.\n"
"    <Tabs>\n"
"    <TabItem value=\"Invalid\" label=\"Tidak valid\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        b = circuit.add_stretch(\"b\")\n"
"        circuit.delay(a, (q0, q1))\n"
"        circuit.delay(b, q0)  # Invalid because 2 stretches are applied on q0\n"
"        ```\n"
"     </TabItem>\n"
"     <TabItem value=\"Valid\" label=\"Valid\">\n"
msgstr ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        b = circuit.add_stretch(\"b\")\n"
"        circuit.delay(a, (q0, q1))\n"
"        circuit.delay(b, q0)  # Invalid because 2 stretches are applied on q0\n"
"        ```\n"
"     </TabItem>\n"
"     <TabItem value=\"Valid\" label=\"Valid\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        b = circuit.add_stretch(\"b\")\n"
"        circuit.delay(a, (q0, q1))\n"
"        circuit.delay(b, q2)\n"
"        ```\n"
"     </TabItem>\n"
"    </Tabs>\n"
msgstr ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        b = circuit.add_stretch(\"b\")\n"
"        circuit.delay(a, (q0, q1))\n"
"        circuit.delay(b, q2)\n"
"        ```\n"
"     </TabItem>\n"
"    </Tabs>\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
