msgstr "![Output of the previous code cell](/docs/images/tutorials/simulate-kicked-ising-tem/extracted-outputs/24894c44-e399-4b9d-a3ff-38a28ff32ece-0.avif)\n"

#. type: Plain text
#, no-wrap
msgid "<TutorialFeedback />\n"
msgstr "<TutorialFeedback />\n"
