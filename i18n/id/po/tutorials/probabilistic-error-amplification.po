msgstr "Sumbu pertama adalah indeks virtual qubit untuk observabel $\\langle Z_i\\rangle$ ($124$ virtual qubit/observabel)\n"

# doq-bootstrap: positional
#. type: Bullet: '   * '
#, no-wrap
