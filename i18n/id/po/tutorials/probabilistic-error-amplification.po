msgstr "Sumbu kedua mengindeks nilai parameter untuk $\\theta$ ($12$ nilai parameter)\n"

# doq-bootstrap: positional
#. type: Bullet: '2. '
#, no-wrap
msgid "`pub_result.data.evs_extrapolated`: Expectation values for extrapolated noise factors for every extrapolator. This array has two additional axes.\n"
msgstr "`pub_result.data.evs_extrapolated`: Nilai ekspektasi untuk faktor noise yang diekstrapolasi untuk setiap ekstrapolator. Array ini memiliki dua sumbu tambahan.\n"

# doq-bootstrap: positional
#. type: Bullet: '   * '
#, no-wrap
msgid "The third axis indexes the extrapolation methods ($2$ extrapolators, `exponential` and `linear`)\n"
msgstr "Sumbu ketiga mengindeks metode ekstrapolasi ($2$ ekstrapolator, `exponential` dan `linear`)\n"

# doq-bootstrap: positional
#. type: Bullet: '   * '
#, no-wrap
msgid "The last axis indexes the `extrapolated_noise_factors` ($20$ extrapolation points specified in the option)\n"
msgstr "Sumbu terakhir mengindeks `extrapolated_noise_factors` ($20$ titik ekstrapolasi yang ditentukan dalam opsi)\n"

# doq-bootstrap: positional
#. type: Bullet: '3. '
#, no-wrap
msgid "`pub_result.data.evs_noise_factors`: Raw expectation values for each noise factor.\n"
msgstr "`pub_result.data.evs_noise_factors`: Nilai ekspektasi mentah untuk setiap faktor noise.\n"

# doq-bootstrap: positional
#. type: Bullet: '   * '
