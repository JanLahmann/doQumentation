msgstr "Muat Hamiltonian molekul {#load-the-molecular-hamiltonian}"

# doq: copied, nothing translatable
#. type: Plain text
#, no-wrap
msgid "**Output:**\n"
msgstr "**Output:**\n"

# doq: translated after an English change 2026-10-07
#. type: Plain text
#, no-wrap
msgid "Loads the $N_2$ molecule Hamiltonian from an FCIDump file. The number of qubits equals twice the number of orbitals (spin-up and spin-down).\n"
msgstr "Memuat Hamiltonian molekul $N_2$ dari file FCIDump. Jumlah qubit sama dengan dua kali jumlah orbital (spin-up dan spin-down).\n"

# doq: translated after an English change 2026-10-07
