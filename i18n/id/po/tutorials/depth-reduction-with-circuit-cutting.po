#. type: Title ##
#, no-wrap
msgid "Step 3: Execute using Qiskit primitives {#step-3-execute-using-qiskit-primitives}"
msgstr "Langkah 3: Jalankan menggunakan Qiskit primitives {#step-3-execute-using-qiskit-primitives}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "Execute the target circuits (\"subexperiments\") with the Sampler primitive.\n"
msgstr "Jalankan circuit target (\"subeksperimen\") dengan Sampler Primitive.\n"

