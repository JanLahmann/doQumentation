# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"**Format structure:**\n"
"- **First line:** `3 20`\n"
"  - `3` = number of products (constraints/rows in matrix $A$)\n"
"  - `20` = number of markets (variables/columns in matrix $A$)\n"
msgstr ""
"**Struktur format:**\n"
