msgstr "Tutorial ini merangkumi langkah-langkah berikut:\n"

# doq: translated after an English change 2026-11-20
#. type: Bullet: '- '
#, no-wrap
msgid "Describe the tilted-field Ising model and its Trotterized time evolution mathematically.\n"
msgstr "Terangkan model Ising medan condong dan evolusi masa Trotter-nya secara matematik.\n"

# doq: translated after an English change 2026-11-20
#. type: Bullet: '- '
#, no-wrap
msgid "Define the backend and the qubits on which to simulate the Hamiltonian, and visualize them.\n"
msgstr "Tentukan Backend dan qubit untuk mensimulasikan Hamiltonian, dan visualisasikannya.\n"

# doq: translated after an English change 2026-11-20
#. type: Bullet: '- '
#, no-wrap
msgid "Define the tilted-field Ising Hamiltonian with the Qiskit `SparsePauliOp` class.\n"
msgstr "Tentukan Hamiltonian Ising medan condong dengan kelas Qiskit `SparsePauliOp`.\n"

# doq: translated after an English change 2026-11-20
#. type: Bullet: '- '
#, no-wrap
msgid "Construct the quantum circuits for the evolution of the Hamiltonian with the Qiskit `evolved_operator_ansatz` function.\n"
msgstr "Bina litar kuantum untuk evolusi Hamiltonian dengan fungsi Qiskit `evolved_operator_ansatz`.\n"

# doq: translated after an English change 2026-11-20
#. type: Bullet: '- '
#, no-wrap
