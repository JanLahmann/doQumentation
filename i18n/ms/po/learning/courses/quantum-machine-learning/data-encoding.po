#. type: Plain text
#, no-wrap
msgid "Given the treatment above, how many qubits are needed to encode 6 features using dense encoding?\n"
msgstr "Berdasarkan perbincangan di atas, berapa banyak qubit yang diperlukan untuk mengekodkan 6 ciri menggunakan pengekodan padat?\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "3\n"
msgstr "__Jawapan:__ 3\n"

