msgid "Exercise 2 {#exercise-2}"
msgstr "Latihan 2 {#exercise-2}"

#. type: Plain text
#, no-wrap
msgid "The GHZ state of an 8-qubit system is\n"
msgstr "Keadaan GHZ bagi sistem 8 qubit ialah\n"

#. type: Plain text
#, no-wrap
msgid ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|00000000\\rangle + |11111111\\rangle)\n"
"$$\n"
msgstr ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|00000000\\rangle + |11111111\\rangle)\n"
"$$\n"

#. type: Plain text
#, no-wrap
msgid "Write code to prepare this state with the shallowest possible circuit. The depth of the shallowest quantum circuit is 5, including the measurement gates.\n"
msgstr "Tulis kod untuk menyediakan keadaan ini dengan litar yang sedangkal mungkin. Kedalaman litar kuantum yang paling cetek ialah 5, termasuk get pengukuran.\n"

