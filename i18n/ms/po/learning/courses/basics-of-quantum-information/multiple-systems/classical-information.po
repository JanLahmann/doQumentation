"  = \\begin{pmatrix}\n"
"    1 & 0 & 1 & 0 \\\\[1mm]\n"
"    0 & 1 & 0 & 1 \\\\[1mm]\n"
"    0 & 0 & 0 & 0 \\\\[1mm]\n"
"    0 & 0 & 0 & 0\n"
"  \\end{pmatrix}.\n"
"$$\n"
