#, markdown-text, no-wrap
msgid ""
"Some linear algebra background ( $2 \\times 2$ matrices should be "
"sufficient)\n"
msgstr ""
"Sedikit latar belakang aljabar linear (matriks $2 \\times 2$ seharusnya "
"mencukupi)\n"

#. type: Bullet: '- '
