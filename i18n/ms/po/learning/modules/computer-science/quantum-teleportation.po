"X|0\\rangle = |1\\rangle,\\\\X|1\\rangle=|0\\rangle\n"
"$$\n"
msgstr ""
"$$\n"
"X|0\\rangle = |1\\rangle,\\\\X|1\\rangle=|0\\rangle\n"
"$$\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"$$\n"
"X=\\begin{pmatrix} 0 & 1 \\\\ 1 & 0 \\end{pmatrix}\n"
"$$\n"
