# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "Same signs: $ab$, $ba$, $bc$, $cb$\n"
msgstr "Tanda sama: $ab$, $ba$, $bc$, $cb$\n"

# doq-bootstrap: positional
