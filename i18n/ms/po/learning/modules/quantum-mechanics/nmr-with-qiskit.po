# doq: translated after an English change 2026-11-12
#. type: Plain text
#, no-wrap
msgid "$T_1$ relaxation returns the excited state to equilibrium, so the Bloch vector slides from $|1\\rangle$ back up to $|0\\rangle$ along the $z$-axis.\n"
msgstr "Relaksasi $T_1$ mengembalikan keadaan teruja kepada keseimbangan, jadi vektor Bloch menyusur dari $|1\\rangle$ kembali ke $|0\\rangle$ sepanjang paksi $z$.\n"

# doq: translated after an English change 2026-11-12
