msgstr "![Output of the previous code cell](/learning/images/modules/quantum-mechanics/nmr-with-qiskit/extracted-outputs/3a278b57-1.avif)\n"

# doq: translated after an English change 2026-11-12
#. type: Title ###
#, no-wrap
msgid "Hahn echo ($T_2$): Add a refocusing $\\pi$ pulse in the middle {#hahn-echo-t-2-add-a-refocusing-pi-pulse-in-the-middle}"
msgstr "Gema Hahn ($T_2$): Tambah denyut $\\pi$ pemfokus semula di tengah {#hahn-echo-t-2-add-a-refocusing-pi-pulse-in-the-middle}"

# doq: translated after an English change 2026-11-12
#. type: Title ####
#, no-wrap
