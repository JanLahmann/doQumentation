msgid "Understand open-shell versus closed-shell options and the effect on subspace construction for the latest version of Sample-based quantum diagonalization (SQD)"
msgstr "Fahami pilihan lapisan terbuka berbanding lapisan tertutup dan kesannya terhadap pembinaan subruang untuk versi terkini Pepenyahpepenjuruan kuantum berasaskan sampel (SQD)"

# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Understand open-shell versus closed-shell options and the effect on subspace construction"
msgstr "Fahami pilihan lapisan terbuka berbanding lapisan tertutup dan kesannya terhadap pembinaan subruang"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"addons/qiskit-addon-sqd/guides/select-open-closed-shell.ipynb\" />\n"
