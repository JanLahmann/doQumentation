msgid "Classically simulating circuits with OBP for the latest version of Operator backpropagation (OBP)"
msgstr "Simulasi litar secara klasik dengan OBP untuk versi terkini Operator backpropagation (OBP)"

# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Classically simulating circuits with OBP"
msgstr "Simulasi litar secara klasik dengan OBP"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"addons/qiskit-addon-obp/guides/simulating-circuits-with-obp.ipynb\" />\n"
