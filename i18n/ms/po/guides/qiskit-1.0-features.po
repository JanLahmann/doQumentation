"    qc = QuantumCircuit(3)\n"
"    qc.h(0)\n"
"    qc.h(1)\n"
"    qc.cx(1, 2)\n"
"    qc.measure_all()\n"
msgstr ""
"    ```python\n"
"    from qiskit import QuantumCircuit\n"
"    qc = QuantumCircuit(3)\n"
"    qc.h(0)\n"
"    qc.h(1)\n"
