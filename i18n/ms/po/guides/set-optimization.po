#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "How to set the optimization level for transpiling quantum circuits in Qiskit."
msgstr "Cara menetapkan tahap pengoptimuman untuk mentranspil Circuit kuantum dalam Qiskit."

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Set transpiler optimization level"
msgstr "Tetapkan tahap pengoptimuman Transpiler"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"guides/set-optimization.ipynb\" />\n"
msgstr "<OpenInLabBanner notebookPath=\"guides/set-optimization.ipynb\" />\n"

