msgid ""
"Learn how to install the development version of the Qiskit Runtime client."
msgstr "Ketahui cara memasang versi pembangunan klien Qiskit Runtime."

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Install the Qiskit Runtime client from source"
msgstr "Pasang klien Qiskit Runtime dari sumber"

#. type: Plain text
#, markdown-text, no-wrap
msgid "{/* cspell:ignore rustup */}\n"
msgstr "{/* cspell:ignore rustup */}\n"

#. type: Title #
#, markdown-text, no-wrap
msgid ""
"Install the Qiskit Runtime client from source {#install-the-qiskit-runtime-"
"client-from-source}"
msgstr ""
"Pasang klien Qiskit Runtime dari sumber {#install-the-qiskit-runtime-client-"
"from-source}"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"When you install Qiskit Runtime from source, you can access the current "
"development version, instead of using the version in the Python Package "
"Index (PyPI) repository. You can therefore inspect and extend the latest "
"version of the code more efficiently.\n"
msgstr ""
"Apabila anda memasang Qiskit Runtime dari sumber, anda boleh mengakses versi"
" pembangunan semasa, bukan menggunakan versi dalam repositori Python Package"
" Index (PyPI). Oleh itu, anda boleh memeriksa dan melanjutkan versi terbaru "
"kod dengan lebih cekap.\n"

