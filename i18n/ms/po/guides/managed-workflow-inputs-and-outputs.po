# doq: translated after an English change 2026-11-12
#. type: Title #
#, no-wrap
msgid "Define inputs and outputs {#define-inputs-and-outputs}"
msgstr "Takrifkan input dan output {#define-inputs-and-outputs}"

#. type: Plain text
