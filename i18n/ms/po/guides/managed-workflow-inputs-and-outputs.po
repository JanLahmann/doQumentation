msgid "Pass arguments into a managed workflow and return results from it."
msgstr "Hantar argumen ke dalam aliran kerja terurus dan kembalikan hasil daripadanya."

# doq: translated after an English change 2026-11-12
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Define inputs and outputs"
msgstr "Takrifkan input dan output"

