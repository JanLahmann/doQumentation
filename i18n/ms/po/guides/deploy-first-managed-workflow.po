msgid "Write, upload, and run your first managed workflow, then get its results."
msgstr "Tulis, muat naik, dan jalankan managed workflow pertama anda, kemudian dapatkan keputusannya."

# doq: translated after an English change 2026-11-12
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Deploy your first managed workflow"
msgstr "Deploy managed workflow pertama anda"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"guides/deploy-first-managed-workflow.ipynb\" />\n"
msgstr ""

