#. type: Title ####
#, no-wrap
msgid "Runtime environment {#runtime-environment}"
msgstr "Persekitaran masa jalan {#runtime-environment}"

#. type: Bullet: '* '
#, no-wrap
msgid "gcc (libgcc RPM for RHEL-compatible OS)\n"
msgstr "gcc (libgcc RPM untuk OS serasi RHEL)\n"

#. type: Bullet: '* '
#, no-wrap
msgid "openssl (openssl-libs RPM for RHEL-compatible OS)\n"
msgstr "openssl (openssl-libs RPM untuk OS serasi RHEL)\n"

