msgid "`Estimator` returns one expectation value estimate for each element of the broadcasted shape.\n"
msgstr "`Estimator` mengembalikan satu anggaran nilai jangkaan bagi setiap elemen bentuk yang disiarkan.\n"

# doq-bootstrap: positional
