#. type: Plain text
#, no-wrap
msgid "Executor and the directed execution model require the `samplomatic` package:\n"
msgstr "O Executor e o modelo de execução dirigida exigem o pacote `samplomatic`:\n"

#. type: Plain text
#, no-wrap
