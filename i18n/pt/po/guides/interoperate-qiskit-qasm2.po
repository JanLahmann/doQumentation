#. type: Plain text
#, no-wrap
msgid "Use `qasm2.loads()` to import an OpenQASM 2 program as a string into a QuantumCircuit:\n"
msgstr "Use `qasm2.loads()` para importar um programa OpenQASM 2 como string em um QuantumCircuit:\n"

#. type: Title ####
#, no-wrap
msgid "Example: import an OpenQASM 2 program from a file {#example-import-an-openqasm-2-program-from-a-file}"
msgstr "Exemplo: importar um programa OpenQASM 2 a partir de um arquivo {#example-import-an-openqasm-2-program-from-a-file}"

