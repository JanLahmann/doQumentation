#. type: Plain text
#, no-wrap
msgid "These function fields are new. They have no old field in milliseconds:\n"
msgstr "Estes campos de função são novos. Eles não têm um campo antigo em milissegundos:\n"

# doq: copied, nothing translatable
#. type: Bullet: '- '
#, no-wrap
msgid "`functions_usage_ru`\n"
msgstr "`functions_usage_ru`\n"

# doq: copied, nothing translatable
#. type: Bullet: '- '
