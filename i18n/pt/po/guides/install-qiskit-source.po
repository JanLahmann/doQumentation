#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Learn how to install the development version of Qiskit."
msgstr "Aprenda como instalar a versão de desenvolvimento do Qiskit."

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Install the Qiskit SDK from source"
msgstr "Instalar o Qiskit SDK a partir do código-fonte"

#. type: Plain text
#, no-wrap
msgid "{/* cspell:ignore rustup */}\n"
msgstr "{/* cspell:ignore rustup */}\n"

#. type: Title #
#, no-wrap
msgid "Install the Qiskit SDK from source {#install-the-qiskit-sdk-from-source}"
msgstr "Instalar o Qiskit SDK a partir do código-fonte {#install-the-qiskit-sdk-from-source}"

#. type: Plain text
#, no-wrap
msgid "When you install the Qiskit SDK from source, you can access the current development version, instead of using the version in the Python Package Index (PyPI) repository. You can therefore inspect and extend the latest version of the Qiskit code more efficiently.\n"
msgstr "Ao instalar o Qiskit SDK a partir do código-fonte, você pode acessar a versão de desenvolvimento atual, em vez de usar a versão disponível no repositório Python Package Index (PyPI). Você pode, portanto, inspecionar e estender a versão mais recente do código do Qiskit com mais eficiência.\n"

#. type: Title ##
#, no-wrap
msgid "Create and activate a new virtual environment {#create-and-activate-a-new-virtual-environment}"
msgstr "Criar e ativar um novo ambiente virtual {#create-and-activate-a-new-virtual-environment}"

#. type: Bullet: '1. '
#, no-wrap
msgid "Navigate to your project directory and create a minimal environment with only Python installed in it.\n"
msgstr "Navegue até o diretório do seu projeto e crie um ambiente mínimo com apenas o Python instalado.\n"

#. type: Plain text
#, no-wrap
msgid ""
"        <OperatingSystemTabs>\n"
"          <TabItem value=\"mac\" label=\"macOS\">\n"
msgstr ""
"        <OperatingSystemTabs>\n"
"          <TabItem value=\"mac\" label=\"macOS\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"            ```shell\n"
"            python3 -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
msgstr ""
"            ```shell\n"
"            python3 -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"

#. type: Plain text
#, no-wrap
msgid "          <TabItem value=\"linux\" label=\"Linux\">\n"
msgstr "          <TabItem value=\"linux\" label=\"Linux\">\n"

#. type: Plain text
#, no-wrap
msgid "          <TabItem value=\"win\" label=\"Windows\">\n"
msgstr "          <TabItem value=\"win\" label=\"Windows\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"            ```text\n"
"            python -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
"         </OperatingSystemTabs>\n"
msgstr ""
"            ```text\n"
"            python -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
"         </OperatingSystemTabs>\n"

#. type: Bullet: '1. '
#, no-wrap
msgid "Activate your new environment.\n"
msgstr "Ative o novo ambiente.\n"

#. type: Plain text
#, no-wrap
msgid ""
"         <OperatingSystemTabs>\n"
"           <TabItem value=\"mac\" label=\"macOS\">\n"
msgstr ""
"         <OperatingSystemTabs>\n"
"           <TabItem value=\"mac\" label=\"macOS\">\n"

#. type: Plain text
#, no-wrap
msgid ""
"             ```shell\n"
"             source .venv/bin/activate\n"
"             ```\n"
"           </TabItem>\n"
msgstr ""
"             ```shell\n"
"             source .venv/bin/activate\n"
"             ```\n"
"           </TabItem>\n"

#. type: Plain text
#, no-wrap
msgid "           <TabItem value=\"linux\" label=\"Linux\">\n"
msgstr "           <TabItem value=\"linux\" label=\"Linux\">\n"

#. type: Plain text
#, no-wrap
msgid "           <TabItem value=\"win\" label=\"Windows\">\n"
msgstr "           <TabItem value=\"win\" label=\"Windows\">\n"

#. type: Plain text
#, no-wrap
msgid ""
