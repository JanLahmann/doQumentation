msgstr "1. Definir o problema {#1-define-the-problem}"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"You can run a max-cut problem by defining a graph problem and specifying "
"`problem_type='maxcut'`.\n"
msgstr ""
"Você pode executar um problema Max-Cut definindo um problema em grafo e "
"especificando `problem_type='maxcut'`.\n"

#. type: Plain text
#, markdown-text, no-wrap
