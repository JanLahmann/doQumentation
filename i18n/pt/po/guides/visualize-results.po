# doq-bootstrap: positional
#. type: Title ###
#, no-wrap
msgid "Options when plotting a histogram {#options-when-plotting-a-histogram}"
msgstr "Opções ao plotar um histograma {#options-when-plotting-a-histogram}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "Use the following options for `plot_histogram` to adjust the output graph.\n"
msgstr "Use as seguintes opções do `plot_histogram` para ajustar o gráfico de saída.\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "`legend`: Provides a label for the executions. It takes a list of strings used to label each execution's results. This is mostly useful when plotting multiple execution results in the same histogram\n"
msgstr "`legend`: Fornece um rótulo para as execuções. Recebe uma lista de strings usadas para rotular os resultados de cada execução. Isso é mais útil ao plotar múltiplos resultados de execução no mesmo histograma\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "`sort`: Adjusts the order of the bars in the histogram. It can be set to either ascending order with `asc` or descending order with `desc`\n"
msgstr "`sort`: Ajusta a ordem das barras no histograma. Pode ser definido como ordem crescente com `asc` ou ordem decrescente com `desc`\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "`number_to_keep`: Takes an integer for the number of terms to show. The rest are grouped together in a single bar called \"rest\"\n"
msgstr "`number_to_keep`: Recebe um inteiro com o número de termos a exibir. Os demais são agrupados em uma única barra chamada \"rest\"\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "`color`: Adjusts the color of the bars; takes a string or a list of strings for the colors to use for the bars for each execution\n"
msgstr "`color`: Ajusta a cor das barras; recebe uma string ou uma lista de strings com as cores a usar nas barras de cada execução\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "`bar_labels`: Adjusts whether labels are printed above the bars\n"
msgstr "`bar_labels`: Ajusta se os rótulos são impressos acima das barras\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "`figsize`: Takes a tuple of the size in inches to make the output figure\n"
msgstr "`figsize`: Recebe uma tupla com o tamanho em polegadas para a figura de saída\n"

