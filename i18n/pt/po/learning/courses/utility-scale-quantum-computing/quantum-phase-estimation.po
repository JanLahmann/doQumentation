#. type: Title ###
#, no-wrap
msgid "2.4 Example: Circuit construction of 3 qubits QFT {#24-example-circuit-construction-of-3-qubits-qft}"
msgstr "2.4 Exemplo: Construção de circuito QFT com 3 qubits {#24-example-circuit-construction-of-3-qubits-qft}"

# doq-bootstrap: positional
