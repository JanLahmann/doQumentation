msgstr "![Saída da célula de código anterior](/learning/images/courses/utility-scale-quantum-computing/teleportation/extracted-outputs/3286dbd8-c2f6-44d3-8ca2-8b852d9ec7cc-0.avif)\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "You can see that Bob received the message that Alice wanted to send to him.\n"
msgstr "Você pode ver que Bob recebeu a mensagem que Alice queria lhe enviar.\n"

