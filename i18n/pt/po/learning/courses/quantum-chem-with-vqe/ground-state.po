# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "We have all the necessary components for a VQE calculation:\n"
msgstr "Temos todos os componentes necessários para um cálculo VQE:\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "Hamiltonian\n"
