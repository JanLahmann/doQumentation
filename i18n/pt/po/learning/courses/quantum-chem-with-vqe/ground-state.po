# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "Ansatz\n"
msgstr "Ansatz\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "Classical optimizer\n"
msgstr "Otimizador clássico\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
