#. type: Title ###
#, no-wrap
msgid "Check your understanding {#check-your-understanding}"
msgstr "Verifique seu entendimento {#check-your-understanding}"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "Write code to encode the first vector in our example data set $\\text{X}_{\\text{ex}}$:\n"
