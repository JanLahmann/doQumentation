#, markdown-text, no-wrap
msgid "Creates a parameterized Ising model circuit\n"
msgstr "Cria um circuito de modelo de Ising parametrizado\n"

# doq-bootstrap: positional
#. type: Bullet: '* '
#, markdown-text, no-wrap
msgid "Creates entangling layers and removes bad qubits\n"
msgstr "Cria camadas de entrelaçamento e remove qubits ruins\n"

