#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Take a 20-question exam on the IBM Training site to test your skills in practical quantum computing, and receive a badge through Credly."
msgstr "Faça um exame de 20 perguntas no site do IBM Training para testar suas habilidades em computação quântica prática, e receba um selo pela Credly."

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Exam | Quantum computing in practice"
msgstr "Exame | Computação quântica na prática"

#. type: Title #
#, no-wrap
msgid "Exam and badge {#exam-and-badge}"
msgstr "Exame e selo {#exam-and-badge}"

# doq: copied, nothing translatable
