# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "(a) What states would you expect to have zero uncertainty in $X$?\n"
msgstr "(a) Quais estados você esperaria ter incerteza zero em $X$?\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "(b) What states would you expect to have zero uncertainty in $Z$?\n"
msgstr "(b) Quais estados você esperaria ter incerteza zero em $Z$?\n"

# doq-bootstrap: positional
#. type: Plain text
