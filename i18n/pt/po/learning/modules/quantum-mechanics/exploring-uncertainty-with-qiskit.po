msgid "(d) Are the answers to the above questions consistent with the case $\\Delta X \\Delta Z \\geq |\\langle Y \\rangle|$?\n"
msgstr "(d) As respostas às perguntas acima são consistentes com o caso $\\Delta X \\Delta Z \\geq |\\langle Y \\rangle|$?\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
