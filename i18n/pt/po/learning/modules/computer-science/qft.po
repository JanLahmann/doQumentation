# doq-bootstrap: positional
#. type: Bullet: '1. '
#, no-wrap
msgid "Use matrix multiplication to verify that the steps in the QFT algorithm indeed result in the $\\text{QFT}_4$ matrix:\n"
msgstr "Use multiplicação de matrizes para verificar que as etapas do algoritmo da TFQ resultam de fato na matriz $\\text{QFT}_4$:\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"$$\n"
"\\text{QFT}_4 = \\frac{1}{2}\n"
"\\begin{pmatrix}\n"
"    1 & 1 & 1 & 1 \\\\\n"
"    1 & i & -1 & -i \\\\\n"
"    1 & -1 & 1 & -1 \\\\\n"
"    1 & -i & -1 & i \\\\\n"
"\\end{pmatrix}\n"
"$$\n"
msgstr ""
"$$\n"
"\\text{QFT}_4 = \\frac{1}{2}\n"
"\\begin{pmatrix}\n"
"    1 & 1 & 1 & 1 \\\\\n"
"    1 & i & -1 & -i \\\\\n"
"    1 & -1 & 1 & -1 \\\\\n"
"    1 & -i & -1 & i \\\\\n"
"\\end{pmatrix}\n"
"$$\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "(You don't have to do this by hand!)\n"
msgstr "(Você não precisa fazer isso à mão!)\n"

