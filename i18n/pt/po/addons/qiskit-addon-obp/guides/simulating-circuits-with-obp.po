msgid "Classically simulating circuits with OBP for the latest version of Operator backpropagation (OBP)"
msgstr "Simulando circuitos classicamente com OBP para a versão mais recente de Operator backpropagation (OBP)"

# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Classically simulating circuits with OBP"
msgstr "Simulando circuitos classicamente com OBP"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"addons/qiskit-addon-obp/guides/simulating-circuits-with-obp.ipynb\" />\n"
