# doq-bootstrap: positional
#. type: Bullet: '    - '
#, no-wrap
msgid "Last number (1002): Target sales for Product 1 in one region\n"
msgstr "Último número (1002): Vendas-alvo para o Produto 1 em uma região\n"

# doq-bootstrap: positional
#. type: Bullet: '  - '
#, no-wrap
msgid "Line 3: `176 196 41 ... 46 | 879`\n"
msgstr "Linha 3: `176 196 41 ... 46 | 879`\n"

# doq-bootstrap: positional
#. type: Bullet: '    - '
#, no-wrap
msgid "Product 2 sales per market and target (879)\n"
msgstr "Vendas do Produto 2 por mercado e alvo (879)\n"

# doq-bootstrap: positional
#. type: Bullet: '  - '
#, no-wrap
msgid "Line 4: `68 68 179 ... 95 | 1040`\n"
msgstr "Linha 4: `68 68 179 ... 95 | 1040`\n"

# doq-bootstrap: positional
#. type: Bullet: '    - '
#, no-wrap
msgid "Product 3 sales per market and target (1040)\n"
msgstr "Vendas do Produto 3 por mercado e alvo (1040)\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"**Business interpretation:**\n"
