"|\\psi_b\\rangle = a|01\\rangle + b|00\\rangle + c|11\\rangle + d|10\\rangle\\\\\n"
"|\\psi_c\\rangle = a|11\\rangle + b|00\\rangle + c|01\\rangle + d|10\\rangle\\\\\n"
"|\\psi_d\\rangle = a|00\\rangle + b|11\\rangle + c|10\\rangle + d|01\\rangle\n"
