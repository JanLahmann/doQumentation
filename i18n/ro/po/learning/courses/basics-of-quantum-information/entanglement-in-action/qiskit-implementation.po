"$$\n"
msgstr ""
"$$\n"
"\\cos^2\\Bigl(\\frac{3\\pi}{8}\\Bigr) = \\frac{2 - \\sqrt{2}}{4}.\n"
"$$\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
