msgstr "Ne așteptăm să găsim:\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"$$\n"
"\\theta = \\frac{1}{8}\n"
"$$\n"
msgstr ""
"$$\n"
"\\theta = \\frac{1}{8}\n"
"$$\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "where\n"
msgstr ""
"unde\n"
"$$\n"
"T|1\\rangle = e^{2i\\pi\\theta}|1\\rangle\n"
"$$\n"
