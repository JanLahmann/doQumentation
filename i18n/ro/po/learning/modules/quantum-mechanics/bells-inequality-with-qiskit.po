# doq-bootstrap: positional
#. type: Bullet: '7. '
#, no-wrap
msgid "Suppose a qubit is in the $|0\\rangle$ state. What is the probability of measuring it to be in the $1\\rangle$ state?\n"
msgstr "Presupune că un qubit se află în starea $|0\\rangle$. Care este probabilitatea de a-l măsura în starea $1\\rangle$?\n"

# doq-bootstrap: positional
#. type: Bullet: '    - '
#, no-wrap
msgid "a. Exactly 100% on a noise-free simulator, near 100% on a real quantum computer\n"
msgstr "a. Exact 100% pe un simulator fără zgomot, aproape 100% pe un calculator cuantic real\n"

# doq-bootstrap: positional
#. type: Bullet: '    - '
#, no-wrap
msgid "b. Near 100% on a noise-free simulator, exactly 100% on a real quantum computer\n"
msgstr "b. Aproape 100% pe un simulator fără zgomot, exact 100% pe un calculator cuantic real\n"

# doq-bootstrap: positional
#. type: Bullet: '    - '
#, no-wrap
msgid "c. Exactly 0% on a noise-free simulator, near 0% on a real quantum computer\n"
msgstr "c. Exact 0% pe un simulator fără zgomot, aproape 0% pe un calculator cuantic real\n"

# doq-bootstrap: positional
#. type: Bullet: '    - '
