#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid "Step 1: Map classical inputs to a quantum problem\n"
msgstr "Pasul 1: Maparea intrărilor clasice la o problemă cuantică\n"

#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid "Step 2: Optimize problem for quantum execution\n"
msgstr "Pasul 2: Optimizarea problemei pentru execuție cuantică\n"

#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid "Step 3: Execute using Qiskit Runtime Primitives\n"
msgstr "Pasul 3: Execuție folosind Qiskit Runtime Primitives\n"

