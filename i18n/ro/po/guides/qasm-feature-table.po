#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "A table of the language features included in OpenQASM 3."
msgstr "Un tabel cu funcționalitățile limbajului OpenQASM 3."

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "OpenQASM 3 feature table"
msgstr "Tabel de funcționalități OpenQASM 3"

