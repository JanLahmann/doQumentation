msgid "Setup instructions for IBM Quantum on IBM Cloud to submit Qiskit SDK and IBM Quantum Compute Service workloads"
msgstr "Instrucțiuni de configurare pentru IBM Quantum pe IBM Cloud pentru a trimite sarcini de lucru Qiskit SDK și IBM Quantum Compute Service"

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Set up your IBM Cloud account"
msgstr "Configurează-ți contul IBM Cloud"

# doq-bootstrap: positional
