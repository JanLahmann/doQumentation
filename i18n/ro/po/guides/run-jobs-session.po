msgstr "**Manager de context**\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "The context manager automatically opens and closes the session.\n"
msgstr "Managerul de context deschide și închide sesiunea automat.\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "<span id=\"specify-length\"></span>\n"
