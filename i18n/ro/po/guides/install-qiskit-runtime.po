# doq: translated after an English change 2026-11-12
#. type: Title ##
#, no-wrap
msgid "Install `qiskit-ibm-runtime` {#install-qiskit-ibm-runtime}"
msgstr "Instalează `qiskit-ibm-runtime` {#install-qiskit-ibm-runtime}"

# doq: translated after an English change 2026-11-12
#. type: Plain text
#, no-wrap
msgid "Follow these steps to install `qiskit-ibm-runtime`:\n"
msgstr "Urmează acești pași pentru a instala `qiskit-ibm-runtime`:\n"

# doq: translated after an English change 2026-11-12
#. type: Bullet: '1. '
#, no-wrap
msgid "Clone the `qiskit-ibm-runtime` repository.\n"
msgstr "Clonează depozitul `qiskit-ibm-runtime`.\n"

# doq: translated after an English change 2026-11-12
#. type: Bullet: '2. '
#, no-wrap
msgid "Change to the `qiskit-ibm-runtime` directory.\n"
msgstr "Schimbă directorul în `qiskit-ibm-runtime`.\n"

# doq: translated after an English change 2026-11-12
#. type: Bullet: '3. '
#, no-wrap
msgid "Install `qiskit-runtime`. We recommend using a [virtual environment](https://docs.python.org/3/library/venv.html) to avoid polluting your global Python installation.\n"
msgstr "Instalează `qiskit-runtime`. Recomandăm să folosești un [mediu virtual](https://docs.python.org/3/library/venv.html) pentru a evita poluarea instalării globale de Python.\n"

# doq: translated after an English change 2026-11-12
#. type: Bullet: '  * '
#, no-wrap
msgid "**Standard install**:\n"
msgstr "**Instalare standard**:\n"

#. type: Plain text
#, no-wrap
msgid ""
"    ```bash\n"
"    pip install .\n"
"    ```\n"
msgstr ""

# doq: translated after an English change 2026-11-12
#. type: Bullet: '  * '
#, no-wrap
msgid "**Editable mode**: In this mode, you don't need to reinstall Qiskit when there are code changes to the project.\n"
msgstr "**Mod editabil**: în acest mod, nu trebuie să reinstalezi Qiskit atunci când apar modificări de cod în proiect.\n"

#. type: Plain text
#, no-wrap
msgid ""
"    ```bash\n"
"    pip install -e .\n"
"    ```\n"
msgstr ""

# doq: translated after an English change 2026-11-12
#. type: Plain text
#, no-wrap
msgid "    In editable mode, the compiled extensions are built in _debug mode_ without optimizations.\n"
msgstr "    În modul editabil, extensiile compilate sunt construite în _mod de depanare_, fără optimizări.\n"

# doq: translated after an English change 2026-11-12
#. type: Bullet: '4. '
#, no-wrap
msgid "(Optional) If you want to run tests or linting checks, install the developer requirements. We recommend using a [virtual environment](https://docs.python.org/3/library/venv.html) to avoid polluting your global Python installation.\n"
msgstr "(Opțional) Dacă vrei să rulezi teste sau verificări de linting, instalează cerințele pentru dezvoltatori. Recomandăm să folosești un [mediu virtual](https://docs.python.org/3/library/venv.html) pentru a evita poluarea instalării globale de Python.\n"

#. type: Title ##
#, no-wrap
msgid "Next steps {#next-steps}"
msgstr "Pașii următori {#next-steps}"

