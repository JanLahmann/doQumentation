"</Tabs>\n"
msgstr ""
"</TabItem>\n"
"</Tabs>\n"

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"$$\\frac{\\sqrt{2}}{2} |00\\rangle+\\frac{1}{2} |01\\rangle- \\frac{i}{2} "
"|11\\rangle$$\n"
msgstr ""
"$$\\frac{\\sqrt{2}}{2} |00\\rangle+\\frac{1}{2} |01\\rangle- \\frac{i}{2} "
"|11\\rangle$$\n"

#. type: Plain text
#, markdown-text, no-wrap
