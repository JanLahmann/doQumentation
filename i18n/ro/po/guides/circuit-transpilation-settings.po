#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Compare transpiler settings"
msgstr "Compară setările Transpiler-ului"

#. type: Plain text
#, no-wrap
msgid "<OpenInLabBanner notebookPath=\"guides/circuit-transpilation-settings.ipynb\" />\n"
msgstr "<OpenInLabBanner notebookPath=\"guides/circuit-transpilation-settings.ipynb\" />\n"

