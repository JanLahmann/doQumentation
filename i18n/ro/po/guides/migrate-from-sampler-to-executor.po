msgstr "Pasul 1. Instalează pachetele necesare {#step-1-install-the-required-packages}"

#. type: Plain text
#, no-wrap
msgid "Executor and the directed execution model require the `samplomatic` package:\n"
msgstr "Executor și modelul de execuție direcționată necesită pachetul `samplomatic`:\n"

#. type: Plain text
#, no-wrap
msgid ""
"<Admonition type=\"note\" title=\"Version notes\">\n"
"- `qiskit-ibm-runtime` v0.48.0 is recommended because it adds the `meas_level = \"both\"` option and the `local_c1` twirling group.\n"
"- `qiskit >= 2.3.0` is required.\n"
"- `samplomatic >= 0.18.0` is required.\n"
"</Admonition>\n"
msgstr ""
"<Admonition type=\"note\" title=\"Note despre versiuni\">\n"
"- `qiskit-ibm-runtime` v0.48.0 este recomandat deoarece adaugă opțiunea `meas_level = \"both\"` și grupul de răsucire `local_c1`.\n"
"- `qiskit >= 2.3.0` este necesar.\n"
"- `samplomatic >= 0.18.0` este necesar.\n"
"</Admonition>\n"

#. type: Plain text
#, no-wrap
msgid "<span id=\"imports\"></span>\n"
msgstr ""

