msgstr "Simularea clasică a circuitelor cu OBP pentru cea mai recentă versiune a Operator backpropagation (OBP)"

# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Classically simulating circuits with OBP"
msgstr "Simularea clasică a circuitelor cu OBP"

#. type: Plain text
