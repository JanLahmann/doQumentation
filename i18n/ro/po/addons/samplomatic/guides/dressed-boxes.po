msgstr "Circuit pentru twirling Pauli.\n"

# doq: translated after an English change 2026-11-13
#. type: Plain text
#, no-wrap
msgid "This is achieved by stratifying the circuit into boxes and adding twirl annotations.\n"
msgstr "Acest lucru se realizează prin stratificarea circuitului în casete și adăugarea adnotărilor de twirling.\n"

# doq: copied, nothing translatable
#. type: Plain text
