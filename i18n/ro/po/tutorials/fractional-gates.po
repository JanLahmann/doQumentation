# doq-bootstrap: positional
#. type: Title ###
#, markdown-text, no-wrap
msgid ""
"Step 1: Map classical inputs to quantum problem {#step-1-map-classical-"
"inputs-to-quantum-problem}"
msgstr ""
"Pasul 1: Mapează intrările clasice la problema cuantică {#step-1-map-"
