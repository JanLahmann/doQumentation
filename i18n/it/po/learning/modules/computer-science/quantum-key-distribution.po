# doq-bootstrap: positional
#. type: Title ###
#, markdown-text, no-wrap
msgid "Qiskit patterns step 3: Execute {#qiskit-patterns-step-3-execute}"
msgstr "Qiskit patterns passo 3: Esegui {#qiskit-patterns-step-3-execute}"

