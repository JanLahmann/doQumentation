# doq-bootstrap: positional
#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid "a. Only once for a single piece of information, like a single letter.\n"
msgstr ""
"a. Solo una volta per un singolo pezzo di informazione, come una singola "
