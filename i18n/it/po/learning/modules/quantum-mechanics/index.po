#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid ""
"This is a collection of stand-alone modules designed for an undergraduate "
"quantum mechanics course."
msgstr ""
"Una raccolta di moduli autonomi progettati per un corso universitario di "
"meccanica quantistica."

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Overview"
msgstr "Panoramica"

#. type: Title #
#, markdown-text, no-wrap
msgid "Overview {#overview}"
msgstr "Panoramica {#overview}"

#. type: Plain text
#, markdown-text, no-wrap
