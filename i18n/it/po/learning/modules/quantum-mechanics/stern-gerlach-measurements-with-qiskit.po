msgid "T/F questions: {#tf-questions}"
msgstr "Domande V/F: {#tf-questions}"

# doq-bootstrap: positional
#. type: Bullet: '1. '
#, markdown-text, no-wrap
msgid "T/F Starting from experimental observations, the only valid choice for a vector to represent $|\\uparrow\\rangle$ is $\\begin{pmatrix}1 \\\\ 0\\end{pmatrix}$\n"
msgstr "V/F Partendo dalle osservazioni sperimentali, l'unica scelta valida per un vettore che rappresenti $|\\uparrow\\rangle$ è $\\begin{pmatrix}1 \\\\ 0\\end{pmatrix}$\n"

# doq-bootstrap: positional
#. type: Bullet: '2. '
#, markdown-text, no-wrap
msgid "T/F If $|\\uparrow\\rangle = \\begin{pmatrix}1 \\\\ 0\\end{pmatrix}$, the only choice for $|\\downarrow\\rangle$ is $\\begin{pmatrix}0 \\\\ 1\\end{pmatrix}$ (up to a global phase).\n"
msgstr "V/F Se $|\\uparrow\\rangle = \\begin{pmatrix}1 \\\\ 0\\end{pmatrix}$, l'unica scelta per $|\\downarrow\\rangle$ è $\\begin{pmatrix}0 \\\\ 1\\end{pmatrix}$ (a meno di una fase globale).\n"

# doq-bootstrap: positional
#. type: Bullet: '3. '
#, markdown-text, no-wrap
msgid "T/F A particle measured to be in the state $|0\\rangle$ will continue to be found in the state $|0\\rangle$ upon subsequent measurements along $z$.\n"
msgstr "V/F Una particella misurata nello stato $|0\\rangle$ continuerà a essere trovata nello stato $|0\\rangle$ nelle misurazioni successive lungo $z$.\n"

# doq-bootstrap: positional
#. type: Bullet: '4. '
#, markdown-text, no-wrap
msgid "T/F A particle measured to be in the state $|0\\rangle$ will continue to be found in the state $|0\\rangle$ upon subsequent measurements along $x$.\n"
msgstr "V/F Una particella misurata nello stato $|0\\rangle$ continuerà a essere trovata nello stato $|0\\rangle$ nelle misurazioni successive lungo $x$.\n"

# doq-bootstrap: positional
#. type: Bullet: '5. '
#, markdown-text, no-wrap
msgid "T/F A particle measured to be in the state $|0\\rangle$ will always be found in the state $|+\\rangle_x$ upon subsequent measurements along $x$.\n"
msgstr "V/F Una particella misurata nello stato $|0\\rangle$ verrà sempre trovata nello stato $|+\\rangle_x$ nelle misurazioni successive lungo $x$.\n"

