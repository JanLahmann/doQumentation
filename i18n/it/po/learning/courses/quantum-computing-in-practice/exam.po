#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Take a 20-question exam on the IBM Training site to test your skills in practical quantum computing, and receive a badge through Credly."
msgstr "Sostieni un esame di 20 domande sul sito IBM Training per testare le tue competenze nel quantum computing pratico, e ricevi un badge tramite Credly."

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Exam | Quantum computing in practice"
msgstr "Esame | Quantum computing in pratica"

#. type: Title #
#, no-wrap
msgid "Exam and badge {#exam-and-badge}"
msgstr "Esame e badge {#exam-and-badge}"

# doq: copied, nothing translatable
