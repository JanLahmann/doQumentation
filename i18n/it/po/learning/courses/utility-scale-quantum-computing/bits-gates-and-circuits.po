msgstr "Scrivi il codice per preparare questo stato con il circuito più superficiale possibile. La profondità del circuito quantistico più superficiale è 5, inclusi i gate di misura.\n"

#. type: Plain text
#, no-wrap
msgid "__Solution__:\n"
msgstr "__Soluzione__:\n"

#. type: Plain text
