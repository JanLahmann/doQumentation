#, no-wrap
msgid "Take a 20-question exam on the IBM Training site to test your quantum information skills and receive a badge through Credly."
msgstr "Sostieni un esame di 20 domande sul sito IBM Training per mettere alla prova le tue competenze sull'informazione quantistica e ricevere un badge tramite Credly."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Exam | Basics of quantum information"
msgstr "Esame | Basi dell'informazione quantistica"

# doq-bootstrap: positional
#. type: Title #
#, no-wrap
msgid "Exam and badge {#exam-and-badge}"
msgstr "Esame e badge {#exam-and-badge}"

# doq-bootstrap: positional
