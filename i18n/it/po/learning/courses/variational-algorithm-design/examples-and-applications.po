#, no-wrap
msgid "Real hardware and a final cautionary message {#real-hardware-and-a-final-cautionary-message}"
msgstr "Hardware reale e un ultimo avvertimento {#real-hardware-and-a-final-cautionary-message}"

# doq-bootstrap: positional
#. type: Plain text
