# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "A guide to applying best grant-writing practices to the quantum ecosystem."
msgstr "Una guida all'applicazione delle migliori pratiche di scrittura di grant all'ecosistema quantistico."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Grant writing for quantum computing"
msgstr "Scrittura di grant per il quantum computing"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "{/* cspell:ignore DARPA reskilling QISE NQISRCs NQCC funders Qureca SBIR STTR Sandia NQISRC NOFO NQIAC RIKEN AbuGhanem */}\n"
