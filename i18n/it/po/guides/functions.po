msgstr ""
"Se hai già il job ID di un determinato job, puoi recuperarlo con "
"`catalog.get_job_by_id()`:\n"

# doq-bootstrap: positional
#. type: Title ###
#, markdown-text, no-wrap
msgid "Fetch error messages {#fetch-error-messages}"
msgstr "Recupera i messaggi di errore {#fetch-error-messages}"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
