"            python -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
"         </OperatingSystemTabs>\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "    Next, activate your new environment.\n"
msgstr "    Quindi, attiva il nuovo ambiente.\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
