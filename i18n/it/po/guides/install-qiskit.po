#. type: Plain text
#, no-wrap
msgid ""
"        <OperatingSystemTabs>\n"
"          <TabItem value=\"mac\" label=\"macOS\">\n"
msgstr ""
"        <OperatingSystemTabs>\n"
"          <TabItem value=\"mac\" label=\"macOS\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid ""
"            ```shell\n"
"            python3 -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"
msgstr ""
"            ```shell\n"
"            python3 -m venv .venv\n"
"            ```\n"
"          </TabItem>\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
msgid "          <TabItem value=\"linux\" label=\"Linux\">\n"
msgstr "          <TabItem value=\"linux\" label=\"Linux\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, no-wrap
