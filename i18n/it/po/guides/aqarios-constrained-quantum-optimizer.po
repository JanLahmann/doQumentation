msgstr "1. Formula il problema {#1-formulate-the-problem}"

# doq: translated after an English change 2026-09-26
#. type: Plain text
#, no-wrap
msgid "Directly state the mathematical expression as the following LP-string format:\n"
msgstr "Esprimi direttamente l'espressione matematica nel seguente formato di stringa LP:\n"

