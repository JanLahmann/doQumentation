#. type: Title ##
#, no-wrap
msgid "Update an instance {#update-an-instance}"
msgstr "Aggiornare un'istanza {#update-an-instance}"

#. type: Plain text
#, no-wrap
msgid "Use the [`PATCH /v2/resource_instances/{crn}`](https://cloud.ibm.com/apidocs/resource-controller/resource-controller#update-resource-instance) endpoint to update the limit, allocation, and permitted backends for an instance. The [CRN](/guides/instances) must be URL-encoded in the path.\n"
msgstr "Usa l'endpoint [`PATCH /v2/resource_instances/{crn}`](https://cloud.ibm.com/apidocs/resource-controller/resource-controller#update-resource-instance) per aggiornare il limite, l'allocazione e i backend consentiti per un'istanza. Il [CRN](/guides/instances) deve essere codificato per URL nel percorso.\n"

#. type: Plain text
#, no-wrap
msgid "Pass a `parameters` JSON object in the request body with the fields you want to change, along with the header `\"Content-Type: application/json\"`. Omitted fields are left unchanged.\n"
msgstr "Passa un oggetto JSON `parameters` nel corpo della richiesta con i campi che vuoi modificare, insieme all'intestazione `\"Content-Type: application/json\"`. I campi omessi rimangono invariati.\n"

#. type: Bullet: '- '
#, no-wrap
msgid "`usage_allocation_seconds` — Integer, or `null`. The time allocated to this instance, used by the [fair-share scheduler](/guides/fair-share-scheduler) to determine queue priority. See [Set instance allocation limits](/guides/allocation-limits). Not applicable to Pay-As-You-Go instances.\n"
msgstr "`usage_allocation_seconds` — Intero, o `null`. Il tempo allocato per questa istanza, utilizzato dallo [scheduler fair-share](/guides/fair-share-scheduler) per determinare la priorità nella coda. Vedi [Impostare i limiti di allocazione dell'istanza](/guides/allocation-limits). Non applicabile alle istanze Pay-As-You-Go.\n"

#. type: Bullet: '- '
#, no-wrap
msgid "`backends` — Array of strings. The allowlist of backend names available to this instance. `[\"ANY\"]` means all backends on the plan are available. `[]` means no backends are available.\n"
msgstr "`backends` — Array di stringhe. L'elenco consentito dei nomi di backend disponibili per questa istanza. `[\"ANY\"]` significa che tutti i backend del piano sono disponibili. `[]` significa che nessun backend è disponibile.\n"

#. type: Plain text
#, no-wrap
msgid ""
"<Admonition type=\"caution\" title=\"Always include a unique timestamp\">\n"
"  The API silently ignores the request if `parameters` is identical to the previous request. In the `parameters` object, always include a `timestamp` field set to the current time so each request is treated as unique.\n"
"</Admonition>\n"
msgstr ""
"<Admonition type=\"caution\" title=\"Includi sempre un timestamp univoco\">\n"
"  L'API ignora silenziosamente la richiesta se `parameters` è identico alla richiesta precedente. Nell'oggetto `parameters`, includi sempre un campo `timestamp` impostato sull'ora corrente in modo che ogni richiesta sia trattata come univoca.\n"
"</Admonition>\n"

#. type: Plain text
#, no-wrap
msgid "The endpoint's response is similar to [getting an instance](#get-an-instance), including how it handles the `extensions` object.\n"
msgstr "La risposta dell'endpoint è simile a [ottenere un'istanza](#get-an-instance), incluso il modo in cui gestisce l'oggetto `extensions`.\n"

#. type: Plain text
#, no-wrap
msgid ""
"    ```bash\n"
"    curl \\\n"
"    --request PATCH \\\n"
"    --url 'https://resource-controller.cloud.ibm.com/v2/resource_instances/<YOUR_INSTANCE_CRN_URL_ENCODED>' \\\n"
"    --header 'Authorization: Bearer <YOUR_BEARER_TOKEN>' \\\n"
"    --header 'Content-Type: application/json' \\\n"
"    --data \"{\n"
"        \\\"parameters\\\": {\n"
"            \\\"timestamp\\\": \\\"$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\\\",\n"
"            \\\"usage_allocation_seconds\\\": 220\n"
"        }\n"
"    }\"\n"
"    ```\n"
"  </TabItem>\n"
msgstr ""

#. type: Plain text
#, no-wrap
msgid ""
"    ```python\n"
"    import urllib.parse\n"
"    import datetime\n"
"    import requests\n"
msgstr ""

# doq: kept in English by the translator (name or code)
#. type: Plain text
#, no-wrap
msgid ""
"    timestamp = datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n"
"    body = {\n"
"        \"parameters\": {\n"
"            \"timestamp\": timestamp,\n"
"            \"usage_allocation_seconds\": 220,\n"
"        }\n"
"    }\n"
msgstr ""
"    timestamp = datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n"
"    body = {\n"
"        \"parameters\": {\n"
"            \"timestamp\": timestamp,\n"
"            \"usage_allocation_seconds\": 220,\n"
"        }\n"
"    }\n"

# doq: kept in English by the translator (name or code)
#. type: Plain text
#, no-wrap
msgid ""
"    resp = requests.patch(\n"
"        url,\n"
"        headers={\n"
"            \"Authorization\": f\"Bearer {token}\",\n"
"            \"Content-Type\": \"application/json\",\n"
"        },\n"
"        json=body,\n"
"        timeout=30,\n"
"    )\n"
"    resp.raise_for_status()\n"
"    print(resp.json())\n"
"    ```\n"
"  </TabItem>\n"
"</Tabs>\n"
msgstr ""
"    resp = requests.patch(\n"
"        url,\n"
"        headers={\n"
"            \"Authorization\": f\"Bearer {token}\",\n"
"            \"Content-Type\": \"application/json\",\n"
"        },\n"
"        json=body,\n"
"        timeout=30,\n"
"    )\n"
"    resp.raise_for_status()\n"
"    print(resp.json())\n"
"    ```\n"
"  </TabItem>\n"
"</Tabs>\n"

#. type: Title ##
#, no-wrap
msgid "Create a new instance {#create-a-new-instance}"
msgstr "Creare una nuova istanza {#create-a-new-instance}"

#. type: Plain text
#, no-wrap
msgid "Use the [`POST /v2/resource_instances`](https://cloud.ibm.com/apidocs/resource-controller/resource-controller#create-resource-instance) endpoint to create (provision) a new instance. Pass a JSON body with the header `\"Content-Type: application/json\"`.\n"
msgstr "Usa l'endpoint [`POST /v2/resource_instances`](https://cloud.ibm.com/apidocs/resource-controller/resource-controller#create-resource-instance) per creare (effettuare il provisioning di) una nuova istanza. Passa un corpo JSON con l'intestazione `\"Content-Type: application/json\"`.\n"

#. type: Plain text
#, no-wrap
msgid "Required fields:\n"
msgstr "Campi obbligatori:\n"

#. type: Bullet: '- '
#, no-wrap
msgid "`name` — A human-readable name for the instance.\n"
msgstr "`name` — Un nome leggibile dall'uomo per l'istanza.\n"

#. type: Bullet: '- '
#, no-wrap
msgid "`target` — The region, such as `us-east` or `eu-de`.\n"
msgstr "`target` — La regione, ad esempio `us-east` o `eu-de`.\n"

#. type: Bullet: '- '
#, no-wrap
msgid "`resource_plan_id` — The plan for this instance. See the [plan ID table](#get-a-list-of-all-instances).\n"
msgstr "`resource_plan_id` — Il piano per questa istanza. Vedi la [tabella degli ID piano](#get-a-list-of-all-instances).\n"

#. type: Bullet: '- '
#, no-wrap
msgid "`resource_group` — The [resource group](https://cloud.ibm.com/docs/account?topic=account-rgs) to use.\n"
msgstr "`resource_group` — Il [gruppo di risorse](https://cloud.ibm.com/docs/account?topic=account-rgs) da utilizzare.\n"

#. type: Plain text
#, no-wrap
msgid "You can also include a `parameters` object to set quantum-specific values:\n"
msgstr "Puoi anche includere un oggetto `parameters` per impostare valori specifici per il quantum:\n"

#. type: Plain text
#, no-wrap
msgid ""
"    ```bash\n"
"    curl \\\n"
"      --request POST \\\n"
"      --url 'https://resource-controller.cloud.ibm.com/v2/resource_instances' \\\n"
"      --header 'Authorization: Bearer <YOUR_BEARER_TOKEN>' \\\n"
"      --header 'Content-Type: application/json' \\\n"
"      --data '{\n"
"          \"name\": \"my-new-instance\",\n"
"          \"target\": \"us-east\",\n"
"          \"resource_plan_id\": \"7f666d17-7893-47d8-bf9d-2b2389fc4dfc\",\n"
"          \"resource_group\": \"<YOUR_RESOURCE_GROUP_ID>\",\n"
"          \"parameters\": {\n"
"              \"instance_limit_seconds\": 300,\n"
"              \"usage_allocation_seconds\": 220\n"
"          }\n"
"      }'\n"
"    ```\n"
"  </TabItem>\n"
msgstr ""

# doq: kept in English by the translator (name or code)
#. type: Plain text
#, no-wrap
msgid ""
"    body = {\n"
"        \"name\": \"my-new-instance\",\n"
"        \"target\": \"us-east\",\n"
"        \"resource_plan_id\": \"7f666d17-7893-47d8-bf9d-2b2389fc4dfc\",\n"
"        \"resource_group\": \"<YOUR_RESOURCE_GROUP_ID>\",\n"
"        \"parameters\": {\n"
"            \"instance_limit_seconds\": 300,\n"
"            \"usage_allocation_seconds\": 220,\n"
"        },\n"
"    }\n"
msgstr ""
"    body = {\n"
"        \"name\": \"my-new-instance\",\n"
"        \"target\": \"us-east\",\n"
"        \"resource_plan_id\": \"7f666d17-7893-47d8-bf9d-2b2389fc4dfc\",\n"
"        \"resource_group\": \"<YOUR_RESOURCE_GROUP_ID>\",\n"
"        \"parameters\": {\n"
"            \"instance_limit_seconds\": 300,\n"
"            \"usage_allocation_seconds\": 220,\n"
"        },\n"
"    }\n"

# doq: kept in English by the translator (name or code)
#. type: Plain text
#, no-wrap
msgid ""
"    resp = requests.post(\n"
"        \"https://resource-controller.cloud.ibm.com/v2/resource_instances\",\n"
"        headers={\n"
"            \"Authorization\": f\"Bearer {token}\",\n"
"            \"Content-Type\": \"application/json\",\n"
"        },\n"
"        json=body,\n"
"        timeout=30,\n"
"    )\n"
"    resp.raise_for_status()\n"
"    print(resp.json())\n"
