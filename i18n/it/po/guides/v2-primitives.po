#, markdown-text, no-wrap
msgid ""
"Use Estimator to determine the expectation values of multiple circuit-"
"observable pairs.\n"
msgstr ""
"Usa Estimator per determinare i valori attesi di più coppie circuito-"
"osservabile.\n"

