#, no-wrap
msgid ""
"Understand the Qiskit addon tools, which help you build utility-grade "
"quantum workflows."
msgstr ""
"Scopri gli strumenti addon di Qiskit, che ti aiutano a costruire workflow "
"quantistici di livello utility."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Advanced techniques - Qiskit addons"
msgstr "Tecniche avanzate - Addon di Qiskit"

