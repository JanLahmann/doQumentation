# doq-bootstrap: positional
#. type: Title ##
#, markdown-text, no-wrap
msgid "Qiskit Runtime limitations {#qiskit-runtime-limitations}"
msgstr "Limitazioni di Qiskit Runtime {#qiskit-runtime-limitations}"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"Support for `stretch` in Qiskit Runtime is currently experimental and has "
"the following constraints:\n"
msgstr ""
"Il supporto per `stretch` in Qiskit Runtime è attualmente sperimentale e "
"presenta i seguenti vincoli:\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"- At most one stretch variable per _qubit set_ between barriers (implicit and explicit). A qubit set is one or more qubits; these sets must be mutually exclusive.\n"
"    <Tabs>\n"
"    <TabItem value=\"Invalid\" label=\"Invalid\">\n"
msgstr ""
"- Al massimo una variabile stretch per _insieme di qubit_ tra barrier (implicite ed esplicite). Un insieme di qubit è composto da uno o più qubit; questi insiemi devono essere mutuamente esclusivi.\n"
"    <Tabs>\n"
"    <TabItem value=\"Invalid\" label=\"Non valido\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        b = circuit.add_stretch(\"b\")\n"
"        circuit.delay(a, (q0, q1))\n"
"        circuit.delay(b, q0)  # Invalid because 2 stretches are applied on q0\n"
"        ```\n"
"     </TabItem>\n"
"     <TabItem value=\"Valid\" label=\"Valid\">\n"
msgstr ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        b = circuit.add_stretch(\"b\")\n"
"        circuit.delay(a, (q0, q1))\n"
"        circuit.delay(b, q0)  # Invalid because 2 stretches are applied on q0\n"
"        ```\n"
"     </TabItem>\n"
"     <TabItem value=\"Valid\" label=\"Valido\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        b = circuit.add_stretch(\"b\")\n"
"        circuit.delay(a, (q0, q1))\n"
"        circuit.delay(b, q2)\n"
"        ```\n"
"     </TabItem>\n"
"    </Tabs>\n"
msgstr ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        b = circuit.add_stretch(\"b\")\n"
"        circuit.delay(a, (q0, q1))\n"
"        circuit.delay(b, q2)\n"
"        ```\n"
"     </TabItem>\n"
"    </Tabs>\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"- The area surrounded by a set of barriers is called a _barrier region_. A stretch variable cannot be used in multiple barrier regions.\n"
"    <Tabs>\n"
"         <TabItem value=\"Invalid\" label=\"Invalid\">\n"
msgstr ""
"- L'area delimitata da un insieme di barrier è chiamata _regione di barrier_. Una variabile stretch non può essere usata in più regioni di barrier.\n"
"    <Tabs>\n"
"         <TabItem value=\"Invalid\" label=\"Non valido\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"        ```python\n"
"        # Stretch a is used in two barrier regions\n"
"        a = circuit.add_stretch(\"a\")\n"
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(a, q0)\n"
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(a, q0)\n"
"        circuit.barrier((q0, q1))\n"
"         ```\n"
msgstr ""
"        ```python\n"
"        # Stretch a is used in two barrier regions\n"
"        a = circuit.add_stretch(\"a\")\n"
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(a, q0)\n"
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(a, q0)\n"
"        circuit.barrier((q0, q1))\n"
"         ```\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"        ![Illustration of the previous code "
"output](/docs/images/guides/stretch/bad-barrier-region.svg 'Invalid use of "
"stretch in barrier regions')\n"
msgstr ""
"        ![Illustrazione dell'output del codice "
"precedente](/docs/images/guides/stretch/bad-barrier-region.svg 'Uso non "
"valido di stretch nelle regioni di barrier')\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"     </TabItem>\n"
"     <TabItem value=\"Valid\" label=\"Valid\">\n"
msgstr ""
"     </TabItem>\n"
"     <TabItem value=\"Valid\" label=\"Valido\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"        ```python\n"
"        # Stretch a is used inside a barrier region that is on q0 and q1\n"
"        a = circuit.add_stretch(\"a\")\n"
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(a, q0)\n"
"        circuit.barrier(q2)\n"
"        circuit.delay(a, q0)\n"
"        circuit.barrier((q0, q1))\n"
"        ```\n"
msgstr ""
"        ```python\n"
"        # Stretch a is used inside a barrier region that is on q0 and q1\n"
"        a = circuit.add_stretch(\"a\")\n"
"        circuit.barrier((q0, q1))\n"
"        circuit.delay(a, q0)\n"
"        circuit.barrier(q2)\n"
"        circuit.delay(a, q0)\n"
"        circuit.barrier((q0, q1))\n"
"        ```\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"        ![Illustration of the previous code "
"output](/docs/images/guides/stretch/good-barrier-region.svg 'Valid use of "
"stretch in a barrier region')\n"
msgstr ""
"        ![Illustrazione dell'output del codice "
"precedente](/docs/images/guides/stretch/good-barrier-region.svg 'Uso valido "
"di stretch in una regione di barrier')\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"     </TabItem>\n"
"    </Tabs>\n"
msgstr ""
"     </TabItem>\n"
"    </Tabs>\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"- Stretch expressions are limited to those of the form `X*stretch + Y` where `X` and `Y` are floating point or integer constants.\n"
"    <Tabs>\n"
"         <TabItem value=\"Invalid\" label=\"Invalid\">\n"
msgstr ""
"- Le espressioni stretch sono limitate a quelle della forma `X*stretch + Y` dove `X` e `Y` sono costanti in virgola mobile o intere.\n"
"    <Tabs>\n"
"         <TabItem value=\"Invalid\" label=\"Non valido\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        b = circuit.add_stretch(\"b\")\n"
"        c = circuit.add_stretch(\"c\")\n"
msgstr ""
"        ```python\n"
"        a = circuit.add_stretch(\"a\")\n"
"        b = circuit.add_stretch(\"b\")\n"
"        c = circuit.add_stretch(\"c\")\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"        # (a /  b) * c is not supported\n"
"        circuit.delay(expr.mul(expr.div(a, b), c), q1)\n"
"         ```\n"
"     </TabItem>\n"
"     <TabItem value=\"Valid\" label=\"Valid\">\n"
msgstr ""
"        # (a /  b) * c is not supported\n"
"        circuit.delay(expr.mul(expr.div(a, b), c), q1)\n"
"         ```\n"
"     </TabItem>\n"
"     <TabItem value=\"Valid\" label=\"Valido\">\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"        ```python\n"
"        from qiskit.circuit import Duration\n"
msgstr ""
"        ```python\n"
"        from qiskit.circuit import Duration\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"        a = circuit.add_stretch(\"a\")\n"
"        circuit.delay(expr.add(expr.mul(a, 2), Duration.dt(3)), 0)\n"
"        ```\n"
"     </TabItem>\n"
"    </Tabs>\n"
msgstr ""
"        a = circuit.add_stretch(\"a\")\n"
"        circuit.delay(expr.add(expr.mul(a, 2), Duration.dt(3)), 0)\n"
"        ```\n"
"     </TabItem>\n"
"    </Tabs>\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"- Stretch expressions can only include a single stretch variable.\n"
