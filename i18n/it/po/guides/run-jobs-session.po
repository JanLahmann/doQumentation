msgstr "**Context manager**\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid "The context manager automatically opens and closes the session.\n"
msgstr "Il context manager apre e chiude la sessione automaticamente.\n"

