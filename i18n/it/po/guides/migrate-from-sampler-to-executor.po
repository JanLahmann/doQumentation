msgstr "Passaggio 1. Installa i pacchetti richiesti {#step-1-install-the-required-packages}"

#. type: Plain text
#, no-wrap
msgid "Executor and the directed execution model require the `samplomatic` package:\n"
msgstr "Executor e il modello di esecuzione diretta richiedono il pacchetto `samplomatic`:\n"

#. type: Plain text
#, no-wrap
msgid ""
"<Admonition type=\"note\" title=\"Version notes\">\n"
"- `qiskit-ibm-runtime` v0.48.0 is recommended because it adds the `meas_level = \"both\"` option and the `local_c1` twirling group.\n"
"- `qiskit >= 2.3.0` is required.\n"
"- `samplomatic >= 0.18.0` is required.\n"
"</Admonition>\n"
msgstr ""
"<Admonition type=\"note\" title=\"Note sulla versione\">\n"
"- `qiskit-ibm-runtime` v0.48.0 è consigliato perché aggiunge l'opzione `meas_level = \"both\"` e il gruppo di twirling `local_c1`.\n"
"- È richiesto `qiskit >= 2.3.0`.\n"
"- È richiesto `samplomatic >= 0.18.0`.\n"
"</Admonition>\n"

#. type: Plain text
#, no-wrap
msgid "<span id=\"imports\"></span>\n"
msgstr ""

