#, no-wrap
msgid "Step 2. Change the imports {#step-2-change-the-imports}"
msgstr "Passaggio 2. Modifica gli import {#step-2-change-the-imports}"

# doq: copied, nothing translatable
#. type: Plain text
#, no-wrap
msgid "**Sampler:**\n"
msgstr "**Sampler:**\n"

# doq: copied, nothing translatable
