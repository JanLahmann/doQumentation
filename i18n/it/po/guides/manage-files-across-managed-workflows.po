#, no-wrap
msgid "A managed workflow checks the contents of each uploaded file, not its extension, and rejects files of other types:\n"
msgstr "Un workflow gestito controlla il contenuto di ogni file caricato, non la sua estensione, e rifiuta i file di altri tipi:\n"

