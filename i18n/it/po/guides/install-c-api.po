msgid "If activation shows a red error about \"scripts disabled\", the `Set-ExecutionPolicy` line was not run.  Run it manually, then retry.\n"
msgstr "Se l'attivazione mostra un errore rosso su \"scripts disabled\", la riga `Set-ExecutionPolicy` non è stata eseguita. Eseguila manualmente, poi riprova.\n"

#. type: Plain text
#, no-wrap
msgid "Your prompt should now show `(workspace)`. \n"
msgstr "Il tuo prompt ora dovrebbe mostrare `(workspace)`. \n"

# doq: copied, nothing translatable
#. type: Plain text
#, no-wrap
msgid "Verify:\n"
msgstr "Verify:\n"

#. type: Plain text
