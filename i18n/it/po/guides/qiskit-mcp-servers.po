#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid "Use Qiskit MCP Servers to integrate quantum computing capabilities into AI assistants and agents."
msgstr "Usa i server MCP di Qiskit per integrare le capacità di calcolo quantistico negli assistenti AI e negli agenti."

# doq-bootstrap: positional
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Qiskit MCP Servers"
msgstr "Server MCP di Qiskit"

# doq-bootstrap: positional
#. type: Plain text
