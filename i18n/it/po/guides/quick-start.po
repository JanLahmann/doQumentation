# doq-bootstrap: positional
#. type: Bullet: '* '
#, no-wrap
msgid "Download Python and use a virtual environment with Qiskit (recommended).\n"
msgstr "Scarica Python e usa un ambiente virtuale con Qiskit (consigliato).\n"

# doq-bootstrap: positional
