#, no-wrap
msgid "Example: {#example}"
msgstr "Esempio: {#example}"

#. type: Plain text
#, no-wrap
msgid "<span id=\"sampler\"></span>\n"
msgstr "<span id=\"sampler\"></span>\n"

#. type: Title ##
#, no-wrap
msgid "Get started with the Sampler backend primitive {#get-started-with-the-sampler-backend-primitive}"
msgstr "Inizia con la primitiva backend Sampler {#get-started-with-the-sampler-backend-primitive}"

#. type: Plain text
#, no-wrap
msgid "The Sampler primitive can be run with any provider by using [`qiskit.primitives.BackendSamplerV2`](https://docs.quantum.ibm.com/api/qiskit/qiskit.primitives.BackendSamplerV2). However, it requires a backend that supports the `memory` option.\n"
msgstr "La primitiva Sampler può essere eseguita con qualsiasi provider utilizzando [`qiskit.primitives.BackendSamplerV2`](https://docs.quantum.ibm.com/api/qiskit/qiskit.primitives.BackendSamplerV2). Tuttavia, richiede un backend che supporti l'opzione `memory`.\n"

