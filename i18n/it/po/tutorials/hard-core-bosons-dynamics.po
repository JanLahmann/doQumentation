msgid "Correlation functions as observables, such as $\\langle X_iX_j + Y_iY_j\\rangle$ and density-density correlators\n"
msgstr "Funzioni di correlazione come osservabili, come $\\langle X_iX_j + Y_iY_j\\rangle$ e correlatori densità-densità\n"

