msgstr "Qiskit SDK v2.0 o successivo (`pip install qiskit`)\n"

#. type: Bullet: '* '
#, no-wrap
msgid "Qiskit Functions Catalog (`pip install qiskit-ibm-catalog`)\n"
msgstr "Qiskit Functions Catalog (`pip install qiskit-ibm-catalog`)\n"

#. type: Bullet: '* '
#, no-wrap
msgid "Matplotlib (`pip install matplotlib`)\n"
msgstr "Matplotlib (`pip install matplotlib`)\n"

