msgid "Leverage trim SQD for improved configuration selection for the latest version of Sample-based quantum diagonalization (SQD)"
msgstr "Sfrutta trim SQD per una migliore selezione delle configurazioni per l'ultima versione della diagonalizzazione quantistica basata su campioni (SQD)"

# doq: translated after an English change 2026-11-13
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Leverage trim SQD for improved configuration selection"
msgstr "Sfrutta trim SQD per una migliore selezione delle configurazioni"

#. type: Plain text
