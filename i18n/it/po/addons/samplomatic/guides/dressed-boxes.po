#. type: Plain text
#, no-wrap
msgid "Circuit to Pauli twirl.\n"
msgstr "Circuito su cui applicare il Pauli twirling.\n"

# doq: translated after an English change 2026-11-13
#. type: Plain text
#, no-wrap
msgid "This is achieved by stratifying the circuit into boxes and adding twirl annotations.\n"
msgstr "Ciò si ottiene stratificando il circuito in box e aggiungendo annotazioni di twirl.\n"

# doq: copied, nothing translatable
#. type: Plain text
#, no-wrap
