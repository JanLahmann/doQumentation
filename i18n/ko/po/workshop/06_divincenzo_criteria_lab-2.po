#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"![Quantum circuit diagram](/img/workshop/06-divincenzo-criteria-"
"lab-2/output_1.png)\n"
msgstr ""
"![Quantum circuit diagram](/img/workshop/06-divincenzo-criteria-"
"lab-2/output_1.png)\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
