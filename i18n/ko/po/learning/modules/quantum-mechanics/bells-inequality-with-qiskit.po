#, markdown-text, no-wrap
msgid ""
"Which of the following is/are true of the X gate? Select all that apply.\n"
msgstr "X Gate에 대해 옳은 것은 무엇입니까? 해당하는 것을 모두 고르세요.\n"

# doq-bootstrap: positional
#. type: Bullet: '    - '
#, markdown-text, no-wrap
msgid "a. $X|0\\rangle = |1\\rangle$\n"
msgstr "a. $X|0\\rangle = |1\\rangle$\n"

# doq-bootstrap: positional
#. type: Bullet: '    - '
#, markdown-text, no-wrap
msgid "b. $X|0\\rangle = \\frac{1}{\\sqrt{2}}(|0\\rangle-|1\\rangle)$\n"
msgstr "b. $X|0\\rangle = \\frac{1}{\\sqrt{2}}(|0\\rangle-|1\\rangle)$\n"

# doq-bootstrap: positional
#. type: Bullet: '    - '
#, markdown-text, no-wrap
msgid "c. $X|0\\rangle = -|0\\rangle$\n"
msgstr "c. $X|0\\rangle = -|0\\rangle$\n"

# doq-bootstrap: positional
#. type: Bullet: '    - '
#, markdown-text, no-wrap
msgid "d. $X|1\\rangle = |0\\rangle$\n"
msgstr "d. $X|1\\rangle = |0\\rangle$\n"

# doq-bootstrap: positional
#. type: Bullet: '    - '
#, markdown-text, no-wrap
msgid ""
"e. "
"$X\\frac{1}{\\sqrt{2}}(|0\\rangle-|1\\rangle)=X\\frac{1}{\\sqrt{2}}(|1\\rangle-|0\\rangle)$\n"
msgstr ""
"e. "
"$X\\frac{1}{\\sqrt{2}}(|0\\rangle-|1\\rangle)=X\\frac{1}{\\sqrt{2}}(|1\\rangle-|0\\rangle)$\n"

