# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"The GHZ state (Greenberger-Horne-Zeilinger state) for $n$ qubits is defined "
"as\n"
msgstr "$n$개의 Qubit에 대한 GHZ 상태(Greenberger-Horne-Zeilinger 상태)는 다음과 같이 정의됩니다.\n"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|0\\rangle ^ {\\otimes n}+ |1\\rangle^ {\\otimes n})\n"
"$$\n"
msgstr ""
"$$\n"
"\\frac{1}{\\sqrt 2}(|0\\rangle ^ {\\otimes n}+ |1\\rangle^ {\\otimes n})\n"
"$$\n"

