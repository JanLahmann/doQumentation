msgstr "레슨 1: Variational quantum eigensolver\n"

#. type: Bullet: '- '
#, no-wrap
msgid "Lesson 2: Krylov quantum diagonalization\n"
msgstr "레슨 2: Krylov 양자 대각화\n"

