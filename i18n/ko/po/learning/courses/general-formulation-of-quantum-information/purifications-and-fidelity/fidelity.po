msgid "Fidelity"
msgstr "충실도"

# doq-bootstrap: positional
#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"{/* cspell:ignore operatorname */}\n"
"{/* cspell:ignore biggr */}\n"
