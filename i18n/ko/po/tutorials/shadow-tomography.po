"\\end{equation}\n"
"\\tag{1}\n"

# doq: translated after an English change 2026-10-13
#. type: Plain text
#, no-wrap
msgid "For this ensemble, the measurement channel's inverse is:\n"
msgstr "이 앙상블에서 측정 채널의 역은 다음과 같습니다.\n"

# doq: kept in English by the translator (name or code)
#. type: Plain text
#, no-wrap
