#. type: Bullet: '2. '
#, no-wrap
msgid "Define the initial state and observables.\n"
msgstr "초기 상태와 관측값을 정의합니다.\n"

# doq: translated after an English change 2026-11-12
#. type: Bullet: '3. '
#, no-wrap
msgid "Submit the Qiskit Function job.\n"
msgstr "Qiskit Function 작업을 제출합니다.\n"

# doq: translated after an English change 2026-11-12
#. type: Bullet: '4. '
#, no-wrap
msgid "Retrieve the expectation values.\n"
msgstr "기댓값을 가져옵니다.\n"

# doq: translated after an English change 2026-11-12
