#, no-wrap
msgid "Next steps {#next-steps}"
msgstr "다음 단계 {#next-steps}"

#. type: Plain text
#, no-wrap
msgid ""
"<Admonition type=\"tip\" title=\"Recommendations\"> \n"
"    -  Review the [`qiskit.primitives.BackendSamplerV2`](https://docs.quantum.ibm.com/api/qiskit/qiskit.primitives.BackendSamplerV2) API documentation.\n"
"    - Review the [`qiskit.primitives.BackendEstimatorV2`](https://docs.quantum.ibm.com/api/qiskit/qiskit.primitives.BackendEstimatorV2) API documentation.\n"
"</Admonition>\n"
msgstr ""
"<Admonition type=\"tip\" title=\"권장 사항\"> \n"
"    -  [`qiskit.primitives.BackendSamplerV2`](https://docs.quantum.ibm.com/api/qiskit/qiskit.primitives.BackendSamplerV2) API 문서를 검토하세요.\n"
"    - [`qiskit.primitives.BackendEstimatorV2`](https://docs.quantum.ibm.com/api/qiskit/qiskit.primitives.BackendEstimatorV2) API 문서를 검토하세요.\n"
"</Admonition>\n"
