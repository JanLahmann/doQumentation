#, no-wrap
msgid "Write logs from a managed workflow, report errors that your local notebook can read, and save partial work when a job is canceled."
msgstr "관리형 워크플로에서 로그를 기록하고, 로컬 노트북에서 읽을 수 있는 오류를 보고하고, 작업이 취소될 때 부분 작업을 저장합니다."

# doq: translated after an English change 2026-11-12
#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Write logs and handle errors"
msgstr "로그 기록과 오류 처리"

#. type: Plain text
#, no-wrap
msgid "{/* cspell:ignore levelname */}\n"
msgstr ""

# doq: translated after an English change 2026-11-12
#. type: Title #
#, no-wrap
msgid "Write logs and handle errors {#write-logs-and-handle-errors}"
msgstr "로그 기록과 오류 처리 {#write-logs-and-handle-errors}"

#. type: Plain text
#, no-wrap
msgid ""
