"deeper into transpilation in the next subsection.\n"
msgstr ""

#. type: Title ###
#, markdown-text, no-wrap
msgid "Step 3 revisited {#step-3-revisited}"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid "We now apply the updated model to our training data.\n"
msgstr ""

#. type: Title ###
#, markdown-text, no-wrap
msgid "Step 4 revisited {#step-4-revisited}"
msgstr ""

