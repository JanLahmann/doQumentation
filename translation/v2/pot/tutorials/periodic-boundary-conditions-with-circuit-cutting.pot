#. type: Title ##
#, markdown-text, no-wrap
msgid "Learning outcomes {#learning-outcomes}"
msgstr ""

#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid ""
"Use a virtual connection to transpile a periodic chain without routing its "
"boundary gates.\n"
msgstr ""

#. type: Bullet: '- '
#, markdown-text, no-wrap
msgid ""
"Replace those gates with circuit-cutting experiments and reconstruct "
"expectation values from Sampler results.\n"
msgstr ""

#. type: Bullet: '- '
