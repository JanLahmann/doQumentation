#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid ""
"Use TEM, a quantum function by Algorithmiq, to recover the dynamics of a "
"31-qubit kicked Ising chain from noisy hardware data, and compare it with "
"PEC and ZNE."
msgstr ""

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Simulate a kicked Ising model with the TEM function"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"<OpenInLabBanner notebookPath=\"tutorials/simulate-kicked-ising-tem.ipynb\" "
"/>\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
