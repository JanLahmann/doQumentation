#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid ""
"Combine mediator-qubit error detection with PEC on a 49-qubit hexagonal "
"Ising circuit to mitigate noise at a fraction of the sampling cost of PEC "
"alone."
msgstr ""

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Probabilistic error cancellation with logical noise models"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"<OpenInLabBanner notebookPath=\"tutorials/probabilistic-error-cancellation-"
"with-logical-noise-models.ipynb\" />\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
