msgstr ""

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Classically simulating circuits with OBP"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"<OpenInLabBanner notebookPath=\"addons/qiskit-addon-obp/guides/simulating-"
