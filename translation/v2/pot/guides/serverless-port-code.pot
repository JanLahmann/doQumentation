#, markdown-text, no-wrap
msgid ""
"<Tabs>\n"
"  <TabItem value=\"LocalExperiment\" label=\"Local Experiment\">\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid "  </TabItem>\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
