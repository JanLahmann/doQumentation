msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"Check the connection. The output shows `PREFECT_API_URL` and your "
"workspace:\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid "<DoqAdmonition type=\"note\" title=\"Optional: use your own Prefect server\">\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"Skip this note if you use Prefect Cloud. To use your own Prefect server instead of Prefect\n"
"Cloud, follow\n"
