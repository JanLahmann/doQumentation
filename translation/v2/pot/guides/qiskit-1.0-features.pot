#. type: Title ##
#, markdown-text, no-wrap
msgid "qiskit.visualization {#qiskitvisualization}"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"The `qiskit.visualization.qcstyle` module has been removed. Use\n"
"`qiskit.visualization.circuit.qcstyle` as direct replacement.\n"
msgstr ""
