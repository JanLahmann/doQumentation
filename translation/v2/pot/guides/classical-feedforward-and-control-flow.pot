#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid ""
"Use Qiskit for classical feedforward and control flow, otherwise referred to"
" as dynamic circuits"
msgstr ""

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Classical feedforward and control flow (dynamic circuits)"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"<OpenInLabBanner notebookPath=\"guides/classical-feedforward-and-control-"
"flow.ipynb\" />\n"
msgstr ""

