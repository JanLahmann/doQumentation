msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid "The transpiled circuit has six of the two-qubit ECR gates.\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid "Repeat for optimization level 1:\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
