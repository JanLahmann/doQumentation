#. type: Yaml Front Matter Hash Value: description
#, no-wrap
msgid ""
"How to create a Qiskit transpiler plugin to share your transpilation code "
"with the Qiskit community."
msgstr ""

#. type: Yaml Front Matter Hash Value: title
#, no-wrap
msgid "Create a transpiler plugin"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid "<OpenInLabBanner notebookPath=\"guides/create-transpiler-plugin.ipynb\" />\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
