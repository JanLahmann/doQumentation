#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"    ```python\n"
"    # Estimator V1: Execute 1 circuit with 4 observables\n"
"    job = estimator_v1.run([circuit] * 4, [obs1, obs2, obs3, obs4])\n"
"    evs = job.result().values\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"    # Estimator V2: Execute 1 circuit with 4 observables\n"
"    job = estimator_v2.run([(circuit, [obs1, obs2, obs3, obs4])])\n"
"    evs = job.result()[0].data.evs\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid "  </TabItem>\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid "  <TabItem value=\"Estimator22\" label=\"2 circuits, 2 observables\">\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"    ```python\n"
"    # Estimator V1: Cannot execute 2 circuits with different observables\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"    # Estimator V2: Execute 2 circuits with 2 different observables.  There are\n"
"    # two PUBs because each PUB can have only one circuit.\n"
"    job = estimator_v2.run([(circuit1, obs1), (circuit2, obs2)])\n"
"    evs1 = job.result()[0].data.evs  # result for pub 1 (circuit 1)\n"
"    evs2 = job.result()[1].data.evs  # result for pub 2 (circuit 2)\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid "  <TabItem value=\"Sampler21\" label=\"2 circuits, 1 parameter set\">\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"    ```python\n"
"    # Sampler V1: Execute 2 circuits with 1 parameter set\n"
"      job = sampler_v1.run([circuit1, circuit2], [vals1] * 2)\n"
"      dists = job.result().quasi_dists\n"
msgstr ""

#. type: Plain text
#, markdown-text, no-wrap
msgid ""
"      # Sampler V2: Execute 2 circuits with 1 parameter set\n"
"      job = sampler_v2.run([(circuit1, vals1), (circuit2, vals1)])\n"
"      counts1 = job.result()[0].data.meas.get_counts()  # result for pub 1 (circuit 1)\n"
"      counts2 = job.result()[1].data.meas.get_counts()  # result for pub 2 (circuit 2)\n"
msgstr ""

